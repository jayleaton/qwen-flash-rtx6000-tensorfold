# Opt-in: tp2-fast with the --tp 2 prompt overlap and early n-gram rows, at 14 streams (the overlap holds about
# 2.15 GiB more a rank). Not the default.
# RC-tp2: owner-slot prompt exchange and the split DeltaNet prompt chain.
TF_FLASHNEXT_OWNER_SLOTS=1
TF_FLASHNEXT_GDN_SPLIT=1
# A rollback's DeltaNet replay in three launches, and rank waits that spin instead of sleeping 50 us.
TF_FLASHNEXT_ROLL_BATCH=1
TF_FLASHNEXT_SPIN_WAIT=1
# Each rank projects half the vocab; a greedy verify exchanges each half's best rows, not the scores.
TF_FLASHNEXT_SHARD_HEAD=1
# Each rank also runs the peer's half of the shared expert, so the shared gather goes.
TF_FLASHNEXT_SHARED_REPLICATE=1
# The router in two launches instead of four.
TF_FLASHNEXT_ROUTE_FUSED=1
# A decode pass's hyper-connection read-out in two launches instead of five.
TF_FLASHNEXT_READOUT_DECODE=1
# The out projection's gathers through the peer's mapped buffer (needs TF_FLASHNEXT_PEER_SLOTS=1, in serve.env).
TF_FLASHNEXT_GATHER_SLOTS=1
# A prompt chunk of 2,048 rows or more runs as two halves whose expert exchanges, and out-projection gathers, run on a
# side stream under the other half's layer; the owner-slot pass skips the zero fill of its expert rows (0077-0080).
TF_FLASHNEXT_PROMPT_OVERLAP=1
TF_FLASHNEXT_OWNER_NOCLEAR=1
TF_FLASHNEXT_OVERLAP_OUTPROJ=1
# A drafted round's n-gram rows read during its draft chain, on both ranks (0084, with rank 1's fix in 0091).
TF_FLASHNEXT_PLE_EARLY=1
