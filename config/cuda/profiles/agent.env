# pp2-prefill at a 139,264-token window and 4 streams: coding agents (OpenCode) never compact their history.
# RC-pp2: the two cards as pipeline stages (--pp 2) with the split DeltaNet prompt chain.
TF_FLASHNEXT_GDN_SPLIT=1
# The decode fixes that act under --pp 2: batched rollback replay, spinning rank waits, fused router and read-out.
TF_FLASHNEXT_ROLL_BATCH=1
TF_FLASHNEXT_SPIN_WAIT=1
TF_FLASHNEXT_ROUTE_FUSED=1
TF_FLASHNEXT_READOUT_DECODE=1
# A drafted round's n-gram rows read during its draft chain, the greedy verify's head split between the two stages,
# and the round's host turnaround off the GPU's path (0084). The prompt cache is on at the default budget (0085-0086).
TF_FLASHNEXT_PLE_EARLY=1
TF_FLASHNEXT_PP_HEAD_SPLIT=1
TF_FLASHNEXT_ROUND_TURN=1
