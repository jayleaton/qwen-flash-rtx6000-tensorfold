# Stack E (2x RTX PRO 6000, --tp 2, FP8), the env of the measured soak, one lever a line; serve.sh exports each unless set.
# NCCL over PCIe peer-to-peer instead of shared host memory.
NCCL_P2P_LEVEL=SYS
# A prompt pass with no stream decoding takes up to 8,192 rows.
TF_FLASHNEXT_CHUNK_SOLO=8192
# 12 draft tokens a round for greedy requests.
TF_FLASHNEXT_DRAFTS_GREEDY=12
# The proposal head's projection as affine 4-bit.
TF_FLASHNEXT_DRAFT_HEAD=affine4
# The shared expert on a side stream on both ranks, split across them, with its gather there.
TF_FLASHNEXT_SHARED_SIDE=1
TF_FLASHNEXT_SHARED_SIDE_SPLIT=1
# Rows per pass above which the MoE exchange reduce-scatters by row halves instead of all-reducing.
TF_FLASHNEXT_SPLIT_ROWS=16
# Every pass launches eagerly instead of from a captured window graph (same kernels).
TF_FLASHNEXT_WINDOW_GRAPH=0
# MXFP8/BF16 decode projections take half tiles below 400 64-column blocks (same sums; default 96).
TF_QMMF_HALF_BELOW=400
# The MoE exchange as owner-slot writes into the peer GPU's mapped buffer (one host with P2P only).
TF_FLASHNEXT_PEER_SLOTS=1
# A shared round's attention in one launch a kernel for every lane, not a lane at a time.
TF_FLASHNEXT_ATTN_LANES=1
