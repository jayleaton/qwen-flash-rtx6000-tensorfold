From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Scott Biggart <swbiggart@users.noreply.github.com>
Date: Tue, 10 Nov 2026 18:56:38 -0800
Subject: [PATCH 14/46] flashnext cuda: the opt-in --tp 2 decode graph takes
 the dense split

Every op the split adds to a round (the head and column gathers, copyCols and the FP32 matmul, the split shared expert) is ordered on the compute stream and reads scratch the round graph's key already names, so the graph captures it like the sum. Drop the load refusal and the round's dense_cut gate.
---
 zig/src/families/flashnext/cuda_lanes_explain.zig | 1 -
 zig/src/families/flashnext/cuda_lanes_load.zig    | 2 --
 zig/src/families/flashnext/cuda_prompt.zig        | 2 +-
 zig/tests/fixtures/gradient-serving.tsv           | 2 +-
 4 files changed, 2 insertions(+), 5 deletions(-)

diff --git a/zig/src/families/flashnext/cuda_lanes_explain.zig b/zig/src/families/flashnext/cuda_lanes_explain.zig
index 51035bc98..a71969e72 100644
--- a/zig/src/families/flashnext/cuda_lanes_explain.zig
+++ b/zig/src/families/flashnext/cuda_lanes_explain.zig
@@ -21,7 +21,6 @@ pub fn explain(err: anyerror) ?[]const u8 {
         error.FlashNextPagesUnsupported => "TF_FLASHNEXT_KV_PAGES needs one rank, our own glue and no --slide: unset it",
         error.UnsupportedCheckpoint => "the checkpoint differs from the supported Flash Next CUDA layout; the log names its config field",
         error.BadDenseSplit => "TF_FLASHNEXT_SPLIT_DENSE takes 1 (split the BF16 dense projections at --tp 2, the default) or 0",
-        error.DecodeGraphWithDenseSplit => "TF_FLASHNEXT_DECODE_GRAPH is not qualified with the dense split: unset it or set TF_FLASHNEXT_SPLIT_DENSE=0",
         error.RankDisconnected, error.RankTimeout, error.RemoteRank, error.BadRankFrame => "a tensor-parallel rank failed; restart both ranks from the same checkpoint before retrying",
         else => @import("cuda_images.zig").Vision.explain(err),
         error.PocketOfAnotherSize => "a lesson's pocket is wider than the layer's loaded one: restart the server on the folder",
diff --git a/zig/src/families/flashnext/cuda_lanes_load.zig b/zig/src/families/flashnext/cuda_lanes_load.zig
index 9bc26ca99..6c4ef4a81 100644
--- a/zig/src/families/flashnext/cuda_lanes_load.zig
+++ b/zig/src/families/flashnext/cuda_lanes_load.zig
@@ -25,8 +25,6 @@ pub fn open(comptime F: type, gpa: std.mem.Allocator, io: std.Io, ctx: *const cu
     const mode = try config.mode(gpa, io, dir);
     if (o.tp != 1 and mode != .modelopt) return error.FlashNextRanksNeedModelopt;
     if (o.tp != 1 and captured != null) return error.FlashNextRanksOnCapturedGlue;
-    // the decode graph captures each layer's collectives; the dense split adds its own until a later stage qualifies it
-    if (@import("cuda_round_graph.zig").enabled() and try @import("cuda_dense_split.zig").appliesDir(gpa, io, dir, o.tp)) return error.DecodeGraphWithDenseSplit;
     if (o.slide and (mode != .affine or o.tp != 1)) return error.UnsupportedLearningFormat;
     if (o.slide and captured != null) return error.TrainingOnCapturedGlue;
     const page_tokens = try @import("cuda_kv_lanes.zig").paging();
diff --git a/zig/src/families/flashnext/cuda_prompt.zig b/zig/src/families/flashnext/cuda_prompt.zig
index 97abb35e8..0d10bbcda 100644
--- a/zig/src/families/flashnext/cuda_prompt.zig
+++ b/zig/src/families/flashnext/cuda_prompt.zig
@@ -455,7 +455,7 @@ pub const Engine = struct {
         const has_media = for (seqs) |q| {
             if (q.media != null) break true;
         } else false;
-        if (e.collective != null and round_graph.enabled() and !has_media and e.layers[0].dense_cut == null and e.pockets.mask() == 0) {
+        if (e.collective != null and round_graph.enabled() and !has_media and e.pockets.mask() == 0) {
             const key = try round_graph.Key.init(seqs, s.ids, scores, out);
             try e.round_graph.run(key, &p, ids);
         } else try p.chunk(ids, 0, null);
