-        try s.ack(h);
+        try s.later(h);
     }
 
     fn window(s: *Session, q: *prompt.Seq) !*mtp.Draft {
diff --git a/zig/src/families/flashnext/cuda_rank_verify.zig b/zig/src/families/flashnext/cuda_rank_verify.zig
index a9621e1f6..362239dbe 100644
--- a/zig/src/families/flashnext/cuda_rank_verify.zig
