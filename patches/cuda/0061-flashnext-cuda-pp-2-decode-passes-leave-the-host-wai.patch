-    /// A late prompt chunk's ack, read once the next chunk is issued (rank 0 at --pp 2).
+    /// The last command's ack, read once the next is posted (rank 0 at --pp 2: a prompt chunk's or a decode pass's).
     late: ?wire.Header = null,
 
     /// `wait_ms` bounds the link and the hello: the peer may still be reading every byte for its digest (`linkWait`).
@@ -173,20 +173,26 @@ pub const Session = struct {
         s.benchmark_group = try @import("core").benchmark_group.cuda(s.gpa, io, ctx, &s.collective, stream);
     }
 
+    /// The late chunk's rows settle before any other command (rank 0 at --pp 2); the last command's ack after it.
     pub fn command(s: *Session, input: wire.Header, payload: []const u8) !wire.Header {
+        if (s.rows) |*r| if (s.rank == 0) @import("cuda_batch_hop.zig").settle(r.hop()) catch |err| {
+            s.poison();
+            return err;
+        };
+        const h = try s.post(input, payload);
         try s.drain();
-        return s.post(input, payload);
+        return h;
     }
 
-    /// The late chunk's rows and ack before any other command (rank 0 at --pp 2).
+    /// The last command's ack, once the next is posted: rank 1 starts it without waiting for rank 0 to read.
     fn drain(s: *Session) !void {
-        if (s.rank != 0) return;
-        errdefer s.poison();
-        if (s.rows) |*r| try @import("cuda_batch_hop.zig").settle(r.hop());
-        if (s.late) |h| {
-            s.late = null;
-            try s.ack(h);
-        }
+        if (s.late) |h| try s.ack(h);
+        s.late = null;
+    }
+
+    /// A pipeline's ack waits for the next command (its errors end the session either way); one rank reads it now.
+    pub fn later(s: *Session, h: wire.Header) !void {
+        if (s.rows != null) s.late = h else try s.ack(h);
     }
 
     fn post(s: *Session, input: wire.Header, payload: []const u8) !wire.Header {
@@ -239,17 +245,13 @@ pub const Session = struct {
     pub fn forward(s: *Session, comptime Tri: type, tri: Tri, q: *prompt.Seq, ids: []const u32, hooks: prompt.batch.Hooks) !void {
         if (ids.len == 0 or ids.len > wire.max_payload / 4 or q.fed + ids.len > q.cap or hooks.keep != null or hooks.logits == .all) return error.UnsupportedRankOperation;
         try tokenIds(ids);
-        // a pipeline's rows return on every chunk when rank 0 reads them; a late chunk's ack waits
         const always = s.rows != null and @import("cuda_batch_hop.zig").always(hooks);
         const flags = @backingInt(hooks.logits) | @as(u32, @intFromBool(always)) << 8;
         const h = try s.post(.{ .kind = .forward, .object = q.rank_id, .bytes = @intCast(ids.len * 4), .flags = flags }, std.mem.sliceAsBytes(ids));
         errdefer s.poison();
         try s.engine.forward(Tri, tri, q, ids, hooks);
-        if (s.late) |prior| {
-            s.late = null;
-            try s.ack(prior);
-        }
-        if (hooks.stage.late != null) s.late = h else try s.ack(h);
+        try s.drain();
+        try s.later(h);
     }
 
     pub fn round(s: *Session, comptime Tri: type, tri: Tri, seqs: []const *prompt.Seq, ids: []const u32, out: u64) !void {
@@ -266,7 +268,7 @@ pub const Session = struct {
         const h = try s.command(.{ .kind = .round, .bytes = @intCast(bytes.len) }, bytes);
         errdefer s.poison();
         try s.engine.round(Tri, tri, seqs, ids, out);
-        try s.ack(h);
+        try s.later(h);
     }
 
     /// Both ranks keep their own recurrent window; only the leader consumes draft scores and hidden rows.
@@ -277,7 +279,7 @@ pub const Session = struct {
