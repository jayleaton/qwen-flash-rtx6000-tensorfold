From: Jay Leaton <58495321+jayleaton@users.noreply.github.com>
Date: Mon, 23 Nov 2026 10:18:23 +0700
Subject: [PATCH 61/76] flashnext cuda: --pp 2 decode passes leave the host
 waits to the head's stage

Rank 0 read rank 1's ack after every decode pass, and rank 1 waited on
the host for each pass before acking and reading the next frame. Rank
0 now reads a pass's ack once it has posted the next command, as a late
prompt chunk's already was (any error on rank 1 ends the session either
way), and the stage without the head no longer waits for its verify
windows or decode rounds: nothing on its host reads them, and the next
frame can only come once rank 0 has the rows back. Only the head's
stage waits, for the scores it samples from.
---
 zig/src/families/flashnext/cuda_batch_hop.zig |  5 +++
 zig/src/families/flashnext/cuda_prompt.zig    |  5 ++-
 .../flashnext/cuda_prompt_windows.zig         |  4 ++
 .../families/flashnext/cuda_rank_engine.zig   | 40 ++++++++++---------
 .../families/flashnext/cuda_rank_verify.zig   |  4 +-
 5 files changed, 35 insertions(+), 23 deletions(-)

diff --git a/zig/src/families/flashnext/cuda_batch_hop.zig b/zig/src/families/flashnext/cuda_batch_hop.zig
index f0ede71d2..a6d76f958 100644
--- a/zig/src/families/flashnext/cuda_batch_hop.zig
+++ b/zig/src/families/flashnext/cuda_batch_hop.zig
@@ -46,6 +46,11 @@ pub fn graphs(hop: ?Hop) bool {
     return h.late.rows == 0;
 }
 
+/// A stage without the head: the host reads none of its passes, so it leaves the wait to the stage that does.
+pub fn headless(e: anytype) bool {
+    return e.hop != null and !e.span.ends();
+}
+
 /// The late rows' receive and their absorb (rank 0), before anything else crosses the hop.
 pub fn settle(hop: Hop) !void {
     const l = hop.late.*;
diff --git a/zig/src/families/flashnext/cuda_prompt.zig b/zig/src/families/flashnext/cuda_prompt.zig
index 157d67339..2ddcb0149 100644
--- a/zig/src/families/flashnext/cuda_prompt.zig
+++ b/zig/src/families/flashnext/cuda_prompt.zig
@@ -490,10 +490,11 @@ pub const Engine = struct {
             const key = try round_graph.Key.init(seqs, s.ids, scores, out);
             try e.round_graph.run(key, &p, ids);
         } else try p.chunk(ids, 0, null);
-        try e.complete();
+        const host = !@import("cuda_batch_hop.zig").headless(e);
+        if (host) try e.complete();
         const d = e.stream.d;
         for (seqs, 0..) |q, r| {
-            try cuda.memory.download(d, out + r * vocab * 2, std.mem.sliceAsBytes(q.logits)[0 .. vocab * 2]);
+            if (host) try cuda.memory.download(d, out + r * vocab * 2, std.mem.sliceAsBytes(q.logits)[0 .. vocab * 2]);
             q.fed += 1;
         }
     }
diff --git a/zig/src/families/flashnext/cuda_prompt_windows.zig b/zig/src/families/flashnext/cuda_prompt_windows.zig
index 692a3194b..b25482224 100644
--- a/zig/src/families/flashnext/cuda_prompt_windows.zig
+++ b/zig/src/families/flashnext/cuda_prompt_windows.zig
@@ -78,6 +78,10 @@ pub fn windows(e: *Engine, comptime Tri: type, tri: Tri, wins: []const Window, o
         try window_graph.stageWindow(&p, ids, 0);
         try e.graphs.shared.run(e.gpa, e.stream.*, key, window_graph.Chunk(batch.Pass(Tri)){ .p = &p, .ids = ids, .pos0 = 0 });
     } else try p.chunk(ids, 0, null);
+    if (hops.headless(e)) {
+        for (wins) |w| w.seq.fed += w.ids.len;
+        return;
+    }
     try e.complete();
     // each stream's last row in its host scores only when asked: the drafted windows' draws read `out`
     const d = e.stream.d;
