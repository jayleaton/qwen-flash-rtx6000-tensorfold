From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Scott Biggart <swbiggart@users.noreply.github.com>
Date: Wed, 11 Nov 2026 05:17:56 -0800
Subject: [PATCH 18/46] flashnext cuda: the decode round graph logs its counts
 every 1024th replay as well

---
 zig/src/families/flashnext/cuda_round_graph.zig | 7 +++++--
 zig/tests/fixtures/gradient-serving.tsv         | 2 +-
 2 files changed, 6 insertions(+), 3 deletions(-)

diff --git a/zig/src/families/flashnext/cuda_round_graph.zig b/zig/src/families/flashnext/cuda_round_graph.zig
index 2ce547282..17d6c916a 100644
--- a/zig/src/families/flashnext/cuda_round_graph.zig
+++ b/zig/src/families/flashnext/cuda_round_graph.zig
@@ -42,7 +42,7 @@ pub const Cache = struct {
     /// The stream the graph captures on and the communicator whose collectives it holds (released before its abort).
     stream: ?cuda.Stream = null,
     collective: ?*Collective = null,
-    /// Rounds captured and replayed since the engine started; a clear keeps them.
+    /// Rounds captured and replayed since start (logged each 64th capture and 1024th replay); a clear keeps them.
     captures: u64 = 0,
     replays: u64 = 0,
 
@@ -97,7 +97,10 @@ pub const Cache = struct {
             c.key = key;
             c.captures += 1;
             if (c.captures % 64 == 1) std.log.info("flashnext: decode round graphs: {d} captured, {d} replayed", .{ c.captures, c.replays });
-        } else c.replays += 1;
+        } else {
+            c.replays += 1;
+            if (c.replays % 1024 == 0) std.log.info("flashnext: decode round graphs: {d} captured, {d} replayed", .{ c.captures, c.replays });
+        }
         try c.exec.?.launchOn(pass.stream);
     }
 };
diff --git a/zig/tests/fixtures/gradient-serving.tsv b/zig/tests/fixtures/gradient-serving.tsv
