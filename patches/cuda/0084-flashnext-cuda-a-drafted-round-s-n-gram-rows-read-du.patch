diff --git a/zig/src/families/flashnext/cuda_rank_early.zig b/zig/src/families/flashnext/cuda_rank_early.zig
new file mode 100644
index 000000000..b4186afc7
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_rank_early.zig
@@ -0,0 +1,59 @@
+//! TF_FLASHNEXT_PLE_EARLY at --tp 2: a window's tokens so far go to rank 1 as its chain picks them, unacknowledged.
+const std = @import("std");
+const wire = @import("cuda_rank_wire.zig");
+const mtp = @import("cuda_mtp.zig");
+const ple = @import("cuda_ple.zig");
+const Early = @import("cuda_ple_early.zig").Early;
+
+/// Payload bytes at most: the history, then every token of a window.
+pub const max_bytes = 8 * (ple.max_n - 1) + 4 * mtp.max_rows;
+
+/// Rank 0: the history and tokens `d` holds, for rank 1's copy of the window (none at --pp 2: rank 1 reads no rows).
+pub fn send(s: anytype, d: *const mtp.Draft) !void {
+    const e = d.early orelse return;
+    if (s.rows != null or e.peer == 0 or e.n == 0) return;
+    var raw: [max_bytes]u8 = undefined;
+    for (e.history[0..e.hist_n], 0..) |v, i| std.mem.writeInt(i64, raw[8 * i ..][0..8], v, .little);
+    const at = 8 * e.hist_n;
+    for (e.tokens[0..e.n], 0..) |t, i| std.mem.writeInt(u32, raw[at + 4 * i ..][0..4], t, .little);
+    const bytes = raw[0 .. at + 4 * e.n];
+    _ = try s.post(.{ .kind = .early, .object = e.peer, .arg = e.hist_n, .bytes = @intCast(bytes.len) }, bytes);
+}
+
+pub fn shape(h: wire.Header) !void {
+    const hist = 8 * h.arg;
+    if (h.object == 0 or h.arg == 0 or h.arg >= ple.max_n or h.flags != 0 or h.bytes < hist + 4 or (h.bytes - hist) % 4 != 0 or h.bytes > max_bytes)
+        return error.BadRankFrame;
+}
+
+/// Rank 1: the rows read into its window of the sequence; a frame it cannot use leaves them to the pass.
+pub fn receive(s: anytype, h: wire.Header, payload: []const u8) void {
+    const q = s.seqs.get(h.object) orelse return;
+    const w = s.window(q) catch return;
+    const g = &s.engine.ngram;
+    const e = w.early orelse made: {
+        w.early = Early.create(w.gpa, g) catch return;
+        break :made w.early.?;
+    };
+    var hist: [ple.max_n]i64 = undefined;
+    var tokens: [mtp.max_rows]u32 = undefined;
+    const n: usize = @intCast(h.arg);
+    for (hist[0..n], 0..) |*v, i| v.* = std.mem.readInt(i64, payload[8 * i ..][0..8], .little);
+    const count = (payload.len - 8 * n) / 4;
+    for (tokens[0..count], 0..) |*t, i| t.* = std.mem.readInt(u32, payload[8 * n + 4 * i ..][0..4], .little);
+    e.extend(g, hist[0..n], tokens[0..count]);
+}
+
+test "early frames: a window's history and tokens fit one frame and malformed geometry is refused" {
+    try shape(.{ .kind = .early, .object = 1, .arg = 2, .bytes = 16 + 4 });
+    try shape(.{ .kind = .early, .object = 1, .arg = 2, .bytes = max_bytes - 8 * (ple.max_n - 3) });
+    for ([_]wire.Header{
+        .{ .kind = .early, .arg = 2, .bytes = 20 },
+        .{ .kind = .early, .object = 1, .bytes = 4 },
+        .{ .kind = .early, .object = 1, .arg = ple.max_n, .bytes = 8 * ple.max_n + 4 },
+        .{ .kind = .early, .object = 1, .arg = 2, .bytes = 16 },
+        .{ .kind = .early, .object = 1, .arg = 2, .bytes = 22 },
+        .{ .kind = .early, .object = 1, .arg = 2, .bytes = 20, .flags = 1 },
+        .{ .kind = .early, .object = 1, .arg = 2, .bytes = 16 + 4 * (mtp.max_rows + 1) + 8 * (ple.max_n - 3) },
+    }) |h| try std.testing.expectError(error.BadRankFrame, shape(h));
+}
