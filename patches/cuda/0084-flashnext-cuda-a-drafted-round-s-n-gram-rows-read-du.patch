+/// TF_FLASHNEXT_ROUND_TURN: a pick's bytes copied to pinned memory behind its kernels and polled, with no stream sync.
+pub const Bounce = struct {
+    host: cuda.HostBuffer,
+    event: cuda.Event,
+
+    pub fn init(d: *const cuda.Driver) !Bounce {
+        var host = try cuda.HostBuffer.alloc(d, bytes);
+        errdefer host.free();
+        return .{ .host = host, .event = try cuda.Event.init(d, false) };
+    }
+
+    pub fn deinit(b: *Bounce) void {
+        b.event.deinit();
+        b.host.free();
+    }
+};
+
+/// `out.len` bytes at `src` once the stream reaches them.
+fn read(h: *const mtp.Head, st: cuda.Stream, src: u64, out: []u8) !void {
+    const b = h.pick orelse {
+        try st.synchronize();
+        return cuda.memory.download(st.d, src, out);
+    };
+    if (out.len > b.host.bytes.len) return error.ProposalScoreShape;
+    try st.d.check(st.d.api.cuMemcpyDtoHAsync_v2(b.host.bytes.ptr, src, out.len, st.handle), "cuMemcpyDtoHAsync");
+    try b.event.record(st);
+    while (!try b.event.done()) std.atomic.spinLoopHint();
+    @memcpy(out, b.host.bytes[0..out.len]);
+}
