+//! A ranked engine's main-model calls from the head's ops (mtp_ops.Main): each one through its rank session.
+const prompt = @import("cuda_prompt.zig");
+const mtp = @import("cuda_mtp.zig");
+const Main = @import("cuda_mtp_ops.zig").Main;
+
+pub fn main(comptime Cuda: type, self: *Cuda) Main {
+    const F = struct {
+        fn of(ptr: *anyopaque) *Cuda {
+            return @ptrCast(@alignCast(ptr));
+        }
+
+        fn forward(ptr: *anyopaque, q: *prompt.Seq, ids: []const u32, hooks: prompt.batch.Hooks) anyerror!void {
+            const c = of(ptr);
+            return c.ranks.?.forward(@TypeOf(c.tri()), c.tri(), q, ids, hooks);
+        }
+
+        fn verify(ptr: *anyopaque, q: *prompt.Seq, d: *mtp.Draft, ids: []const u32) anyerror!void {
+            const c = of(ptr);
+            var wide: [mtp.max_rows]u32 = undefined;
+            return @import("cuda_pp_spec.zig").verify(@TypeOf(c.tri()), c, q, d, if (c.spec == null) mtp.padded(&wide, ids, q.fed, q.cap) else ids);
+        }
+
+        fn rollback(ptr: *anyopaque, q: *prompt.Seq, d: *mtp.Draft, keep: usize) anyerror!void {
+            const c = of(ptr);
+            return @import("cuda_pp_spec.zig").rollback(@TypeOf(c.tri()), c, q, d, keep);
+        }
+
+        fn early(ptr: *anyopaque, d: *mtp.Draft) anyerror!void {
+            return of(ptr).ranks.?.early(d);
+        }
+    };
+    return .{ .ptr = self, .forward = F.forward, .verify = F.verify, .rollback = F.rollback, .early = F.early };
+}
