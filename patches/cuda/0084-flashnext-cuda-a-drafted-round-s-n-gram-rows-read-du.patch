diff --git a/zig/src/families/flashnext/cuda_gather.zig b/zig/src/families/flashnext/cuda_gather.zig
new file mode 100644
index 000000000..28ee381ba
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_gather.zig
@@ -0,0 +1,79 @@
+//! A pass's n-gram rows: read on a host thread while the GPU embeds and runs layer 0, or copied from the draft chain's.
+const std = @import("std");
+const ple = @import("cuda_ple.zig");
+const Early = @import("cuda_ple_early.zig").Early;
+const Lane = @import("cuda_batch_state.zig").Lane;
+const dims = @import("cuda_prompt_wt.zig").dims;
+
+/// TF_FLASHNEXT_ROUND_TURN=1: a pass's gather thread starts once its embedding is queued, not before its uploads.
+pub fn late() bool {
+    return @import("sys").environment.read(bool, "TF_FLASHNEXT_ROUND_TURN", false) catch false;
+}
+
+/// The rows' n-gram embeddings, gathered on a host thread while the GPU embeds and runs layer 0.
+pub const Gather = struct {
+    ngram: *const ple.Ngram,
+    history: []i64,
+    ids: []const u32,
+    emb: []u16,
+    xs: []f32,
+    failed: ?anyerror = null,
+    ns: i96 = 0,
+    io: std.Io,
+    /// A round's rows, each gathered after its own stream's history (empty: every row after `history`).
+    lanes: []const Lane = &.{},
+    early: ?*Early = null,
+
+    pub fn main(g: *Gather) void {
+        const t0 = std.Io.Clock.awake.now(g.io).toNanoseconds();
+        defer g.ns = std.Io.Clock.awake.now(g.io).toNanoseconds() - t0;
+        if (g.lanes.len == 0) {
+            (if (g.early) |e| e.serve(g.ngram, g.history, g.ids, g.emb, g.xs) else g.ngram.rows(g.history, g.ids, g.emb, g.xs)) catch |err| {
+                g.failed = err;
+            };
+            return;
+        }
+        var row0: usize = 0;
+        for (g.lanes) |l| {
+            g.ngram.rows(l.seq.history[0..], g.ids[row0..][0..l.rows], g.emb[row0 * dims ..][0 .. l.rows * dims], g.xs[row0 * (dims / 32) ..][0 .. l.rows * (dims / 32)]) catch |err| {
+                g.failed = err;
+                return;
+            };
+            row0 += l.rows;
+        }
+    }
+
+    /// Where the gather runs: a thread now, a thread once the embedding is queued, or inline at layer 1's join.
+    pub const Run = struct {
+        g: *Gather,
+        thread: ?std.Thread = null,
+        due: enum { none, spawn, inline_ } = .none,
+
+        /// `wanted`: the pass reads its own rows. Rows the chain held for all but one token are copied at the join.
+        pub fn begin(g: *Gather, wanted: bool) !Run {
+            if (!wanted) return .{ .g = g };
+            if (g.lanes.len == 0) if (g.early) |e| if (e.covered(g.history, g.ids) + 1 >= g.ids.len) return .{ .g = g, .due = .inline_ };
+            if (late()) return .{ .g = g, .due = .spawn };
+            return .{ .g = g, .thread = try std.Thread.spawn(.{}, main, .{g}) };
+        }
+
+        pub fn embedded(r: *Run) !void {
+            if (r.due != .spawn) return;
+            r.thread = try std.Thread.spawn(.{}, main, .{r.g});
+            r.due = .none;
+        }
+
+        /// The rows ready for their upload (the gather's error, if it failed).
+        pub fn join(r: *Run) !void {
+            if (r.due == .inline_) main(r.g);
+            if (r.thread) |th| th.join();
+            r.* = .{ .g = r.g };
+            if (r.g.failed) |err| return err;
+        }
+
+        pub fn end(r: *Run) void {
+            if (r.thread) |th| th.join();
+            r.thread = null;
+        }
+    };
+};
diff --git a/zig/src/families/flashnext/cuda_head.zig b/zig/src/families/flashnext/cuda_head.zig
index e057564e0..253e8d370 100644
--- a/zig/src/families/flashnext/cuda_head.zig
