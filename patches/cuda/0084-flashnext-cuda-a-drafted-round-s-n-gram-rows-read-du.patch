+/// TF_FLASHNEXT_PP_HEAD_SPLIT=1: at --pp 2 each stage scores half the vocabulary; greedy verifies merge best rows.
+pub fn stages() bool {
+    return @import("sys").environment.read(bool, "TF_FLASHNEXT_PP_HEAD_SPLIT", false) catch false;
+}
+
+/// A one-GPU or --pp 2 stage pass's head rows: a split verify's up to a round's rows (mtp.round_rows), else 32.
+pub fn stageRows(staged: bool) usize {
+    const one = @import("cuda_scratch_sizes.zig").head_rows_one;
+    return if (staged and stages()) @max(one, @import("cuda_mtp.zig").round_rows) else one;
+}
+
+/// Rank `rank`'s half of a whole packed BF16 head: 64-row tiles in row order, so a half is its own packing.
+pub fn half(w: @import("cuda_projection.zig").Projection, rank: usize) !@import("cuda_projection.zig").Projection {
+    const native = w.native orelse return error.BadHeadSharding;
