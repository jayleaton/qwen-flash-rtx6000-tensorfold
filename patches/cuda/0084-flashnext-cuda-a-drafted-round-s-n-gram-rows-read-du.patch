@@ -0,0 +1,158 @@
+//! TF_FLASHNEXT_PLE_EARLY=1: a window's n-gram rows read during its draft chain; the pass copies the ones that match.
+const std = @import("std");
+const ple = @import("cuda_ple.zig");
+const max_rows = @import("cuda_mtp.zig").max_rows;
+
+pub fn on() bool {
+    return @import("sys").environment.read(bool, "TF_FLASHNEXT_PLE_EARLY", false) catch false;
+}
+
+/// A drafting lane's next window, after its sequence's history (switch off: nothing held).
+pub fn begin(d: anytype, g: anytype, seq: anytype) void {
+    if (!on()) return;
+    const e = d.early orelse made: {
+        d.early = Early.create(d.gpa, g) catch return;
+        break :made d.early.?;
+    };
+    e.begin(&seq.history);
+    e.peer = seq.rank_id;
+}
+
+/// One stream's next window: the history before it, its tokens so far and their rows.
+pub const Early = struct {
+    width: usize,
+    hist_n: usize,
+    history: [ple.max_n]i64 = undefined,
+    after: [ple.max_n]i64 = undefined,
+    tokens: [max_rows]u32 = undefined,
+    n: usize = 0,
+    /// Its sequence's id on the other rank (Seq.rank_id), whose copy reads the same rows at --tp 2.
+    peer: u64 = 0,
+    emb: []u16,
+    xs: []f32,
+
+    pub fn create(gpa: std.mem.Allocator, g: anytype) !*Early {
+        const w = g.width();
+        const e = try gpa.create(Early);
+        errdefer gpa.destroy(e);
+        const emb = try gpa.alloc(u16, max_rows * w);
+        errdefer gpa.free(emb);
+        e.* = .{ .width = w, .hist_n = g.hash.n - 1, .emb = emb, .xs = try gpa.alloc(f32, max_rows * (w / 32)) };
+        return e;
+    }
+
+    pub fn destroy(e: *Early, gpa: std.mem.Allocator) void {
+        gpa.free(e.emb);
+        gpa.free(e.xs);
+        gpa.destroy(e);
+    }
+
+    /// A new window after `history`: rows held for an earlier one are dropped.
+    pub fn begin(e: *Early, history: []const i64) void {
+        e.n = 0;
+        if (history.len != e.hist_n) return;
+        @memcpy(e.history[0..e.hist_n], history);
+        @memcpy(e.after[0..e.hist_n], history);
+    }
+
+    /// The window's next token's rows, read as the pass would read them; a failed read keeps the rows before it.
+    pub fn add(e: *Early, g: anytype, token: u32) void {
+        if (e.n == max_rows) return;
+        const w = e.width;
+        var after = e.after;
+        g.rows(after[0..e.hist_n], &.{token}, e.emb[e.n * w ..][0..w], e.xs[e.n * (w / 32) ..][0 .. w / 32]) catch return;
+        e.after = after;
+        e.tokens[e.n] = token;
+        e.n += 1;
+    }
+
+    /// The window `tokens` after `history`: the rows already held are kept when they match, the rest read.
+    pub fn extend(e: *Early, g: anytype, history: []const i64, tokens: []const u32) void {
+        const same = history.len == e.hist_n and std.mem.eql(i64, history, e.history[0..e.hist_n]);
+        if (!same or e.covered(history, tokens) != e.n) e.begin(history);
+        for (tokens[e.n..]) |t| e.add(g, t);
+    }
+
+    /// Leading rows of `ids` after `history` already held.
+    pub fn covered(e: *const Early, history: []const i64, ids: []const u32) usize {
+        if (history.len != e.hist_n or !std.mem.eql(i64, history, e.history[0..e.hist_n])) return 0;
+        var m: usize = 0;
+        while (m < @min(e.n, ids.len) and e.tokens[m] == ids[m]) m += 1;
+        return m;
+    }
+
+    /// Ngram.rows for the pass: the held rows copied, the rest read after them, `history` moved past `ids`.
+    pub fn serve(e: *Early, g: anytype, history: []i64, ids: []const u32, emb: []u16, xs: []f32) !void {
+        const m = e.covered(history, ids);
+        e.n = 0;
+        if (m == 0) return g.rows(history, ids, emb, xs);
+        const w = e.width;
+        if (emb.len != ids.len * w or xs.len != ids.len * (w / 32)) return error.UnexpectedTensor;
+        @memcpy(emb[0 .. m * w], e.emb[0 .. m * w]);
+        @memcpy(xs[0 .. m * (w / 32)], e.xs[0 .. m * (w / 32)]);
+        for (ids[0..m]) |t| {
+            std.mem.copyForwards(i64, history[0 .. history.len - 1], history[1..]);
+            history[history.len - 1] = t;
+        }
+        if (m < ids.len) try g.rows(history, ids[m..], emb[m * w ..], xs[m * (w / 32) ..]);
+    }
+};
+
+test "early n-gram rows: every held prefix, a moved history and a changed token give Ngram.rows' bytes and history" {
+    const a = std.testing.allocator;
+    const io = std.testing.io;
+    var tmp = std.testing.tmpDir(.{});
+    defer tmp.cleanup();
+    try @import("cuda_ple_fp8_test.zig").fixture(tmp.dir, true);
+    const path = try std.fmt.allocPrint(a, ".zig-cache/tmp/{s}", .{tmp.sub_path});
+    defer a.free(path);
+    var g = try ple.Ngram.init(a, io, path);
+    defer g.deinit();
+    const e = try Early.create(a, &g);
+    defer e.destroy(a);
+    const w = g.width();
+    const ids = [_]u32{ 7, 12, 7, 3, 9, 12, 44, 98 };
+    var want: [ids.len * 32]u16 = undefined;
+    var want_xs: [ids.len]f32 = undefined;
+    var want_hist = [_]i64{5};
+    try g.rows(&want_hist, &ids, &want, &want_xs);
+    for ([_]@import("cuda_ple_reader.zig").Mode{ .mmap, .pread }) |mode| {
+        g.read_mode = mode;
+        for (0..ids.len + 1) |held| {
+            e.begin(&.{5});
+            for (ids[0..held]) |t| e.add(&g, t);
+            try std.testing.expectEqual(held, e.covered(&.{5}, &ids));
+            var got: [ids.len * 32]u16 = @splat(0xbeef);
+            var got_xs: [ids.len]f32 = @splat(std.math.nan(f32));
+            var hist = [_]i64{5};
+            try e.serve(&g, &hist, &ids, &got, &got_xs);
+            try std.testing.expectEqualSlices(u16, &want, &got);
+            try std.testing.expectEqualSlices(u8, std.mem.sliceAsBytes(&want_xs), std.mem.sliceAsBytes(&got_xs));
+            try std.testing.expectEqualSlices(i64, &want_hist, &hist);
+            try std.testing.expectEqual(@as(usize, 0), e.n);
+        }
+    }
+    // rows held after another history, or for a token the window does not have, are not used
+    e.begin(&.{6});
+    for (ids[0..4]) |t| e.add(&g, t);
+    try std.testing.expectEqual(@as(usize, 0), e.covered(&.{5}, &ids));
+    e.extend(&g, &.{5}, ids[0..3]);
+    try std.testing.expectEqual(@as(usize, 3), e.covered(&.{5}, &ids));
+    var other = ids;
+    other[1] = 13;
+    try std.testing.expectEqual(@as(usize, 1), e.covered(&.{5}, &other));
+    e.extend(&g, &.{5}, other[0..5]);
+    try std.testing.expectEqual(@as(usize, 5), e.covered(&.{5}, &other));
+    var got: [ids.len * 32]u16 = undefined;
+    var got_xs: [ids.len]f32 = undefined;
+    var hist = [_]i64{5};
+    try e.serve(&g, &hist, &other, &got, &got_xs);
+    var ref: [ids.len * 32]u16 = undefined;
+    var ref_xs: [ids.len]f32 = undefined;
+    var ref_hist = [_]i64{5};
+    try g.rows(&ref_hist, &other, &ref, &ref_xs);
+    try std.testing.expectEqualSlices(u16, &ref, &got);
+    try std.testing.expectEqualSlices(u8, std.mem.sliceAsBytes(&ref_xs), std.mem.sliceAsBytes(&got_xs));
+    try std.testing.expectEqualSlices(i64, &ref_hist, &hist);
+    try std.testing.expectEqual(@as(usize, 32), w);
+}
