index f04af20c9..97bccdbe6 100644
--- a/zig/src/platform/environment.zig
+++ b/zig/src/platform/environment.zig
@@ -211,6 +211,7 @@ pub const rules = [_]Rule{
     .{ .name = "TF_FLASHNEXT_GDN_FUSED", .scope = .flashnext, .kind = .flag, .forms = "0 or 1 (default 1)" },
     .{ .name = "TF_FLASHNEXT_GDN_SPLIT", .scope = .flashnext, .kind = .flag, .forms = "0 or 1 (default 0)" },
     .{ .name = "TF_FLASHNEXT_OWNER_SLOTS", .scope = .flashnext, .kind = .flag, .forms = "0 or 1 (default 0)" },
+    .{ .name = "TF_FLASHNEXT_OWNER_NOCLEAR", .scope = .flashnext, .kind = .flag, .forms = "0 or 1 (default 0; 1: an owner-slot prompt pass skips the zero fill of its expert rows)" },
     .{ .name = "TF_FLASHNEXT_HIDDEN_SUM", .scope = .flashnext, .kind = .flag, .forms = "0 or 1 (default 0)" },
     .{ .name = "TF_FLASHNEXT_ROUTE_FUSED", .scope = .flashnext, .kind = .flag, .forms = "0 or 1 (default 0)" },
     .{ .name = "TF_FLASHNEXT_GDN_LANES", .scope = .flashnext, .kind = .flag, .forms = "0 or 1 (default 1)" },
diff --git a/zig/src/platform/environment_flashnext_test.zig b/zig/src/platform/environment_flashnext_test.zig
index 2a4492ab3..01b5f4f49 100644
--- a/zig/src/platform/environment_flashnext_test.zig
+++ b/zig/src/platform/environment_flashnext_test.zig
@@ -33,13 +33,13 @@ fn check(name: []const u8, raw: []const u8, valid: bool) !void {
     try t.expect(std.mem.endsWith(u8, why.?, e.rule(name).forms));
 }
 
-test "Flash Next strict env: the table holds all 59 settings: 42 switches, 12 integers, 2 reals, 3 structured" {
+test "Flash Next strict env: the table holds all 60 settings: 43 switches, 12 integers, 2 reals, 3 structured" {
     var counts: [4]usize = @splat(0);
     for (e.rules) |r| if (r.scope == .flashnext) {
         try t.expect(std.mem.startsWith(u8, r.name, "TF_FLASHNEXT_"));
         counts[@backingInt(group(r))] += 1;
     };
-    try t.expectEqual([4]usize{ 42, 12, 2, 3 }, counts);
+    try t.expectEqual([4]usize{ 43, 12, 2, 3 }, counts);
 }
 
 test "Flash Next strict env: unset and blank settings both read as the caller's default" {
