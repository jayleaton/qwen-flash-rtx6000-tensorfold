+/// Qwen's block-FP8 release: routed experts E4M3 in 128x128 scale blocks, every projection the loaders read left BF16.
+fn fp8Mismatch(text: std.json.ObjectMap, quant: std.json.ObjectMap) ?[]const u8 {
+    const block = given(quant, "weight_block_size") orelse return "quantization_config.weight_block_size";
+    if (block != .array or block.array.items.len != 2) return "quantization_config.weight_block_size";
+    for (block.array.items) |side| if (!holds(side, .{ .int = 128 })) return "quantization_config.weight_block_size";
+    if (given(quant, "weight_per_tensor")) |v| if (!holds(v, .{ .flag = false })) return "quantization_config.weight_per_tensor";
+    if (given(quant, "kv_cache_scheme") != null) return "quantization_config.kv_cache_scheme";
+    if (geometry(text)) |field| return field;
+    const kept = given(quant, "modules_to_not_convert") orelse return "quantization_config.modules_to_not_convert";
+    if (kept != .array) return "quantization_config.modules_to_not_convert";
+    var buf: [256]u8 = undefined;
+    for (0..wt.layers_n) |layer| {
+        const routed = std.fmt.bufPrint(&buf, "model.language_model.layers.{d}.mlp.experts", .{layer}) catch unreachable;
+        for (kept.array.items) |v| if (v == .string and std.mem.startsWith(u8, v.string, routed)) return "quantization_config.routed_experts";
+        for (fp8_shared) |part| if (!unconverted(kept.array, layer, part)) return "quantization_config.shared_expert";
+        for (if (wt.linearLayer(layer)) fp8_linear else fp8_attention) |part| {
+            if (!unconverted(kept.array, layer, part)) return "quantization_config.attention_projection";
+        }
+    }
+    return null;
+}
+
+const fp8_shared: []const []const u8 = &.{ "mlp.shared_expert.gate_proj", "mlp.shared_expert.up_proj", "mlp.shared_expert.down_proj" };
+const fp8_linear: []const []const u8 = &.{ "linear_attn.in_proj_qkv", "linear_attn.in_proj_z", "linear_attn.in_proj_b", "linear_attn.in_proj_a", "linear_attn.out_proj" };
+const fp8_attention: []const []const u8 = &.{ "self_attn.q_proj", "self_attn.k_proj", "self_attn.v_proj", "self_attn.indexer.index_qk_proj", "self_attn.o_proj" };
+
+fn unconverted(kept: std.json.Array, layer: usize, part: []const u8) bool {
+    var buf: [256]u8 = undefined;
+    const name = std.fmt.bufPrint(&buf, "model.language_model.layers.{d}.{s}", .{ layer, part }) catch unreachable;
+    for (kept.items) |v| if (v == .string and std.mem.eql(u8, v.string, name)) return true;
+    return false;
+}
+
 /// One loaded projection's parts: all MXFP8/32, or none listed (BF16); null when mixed or another format.
 fn declared(entries: std.json.ObjectMap, layer: usize, prefix: []const u8, parts: []const []const u8) ?enum { mxfp8, bf16 } {
     var listed: usize = 0;
@@ -214,8 +256,14 @@ pub fn mode(gpa: std.mem.Allocator, io: std.Io, dir: []const u8) !Mode {
     const root = parsed.value.object;
     const text = if (root.get("text_config")) |v| (if (v == .object) v.object else root) else root;
     const quant = if (root.get("quantization")) |v| (if (v == .object) v.object else null) else null;
-    const selected: Mode = if (quant != null) .affine else .modelopt;
-    var field = if (selected == .affine) mismatch(text, quant) else if (object(root, "quantization_config")) |q| modeloptMismatch(text, q) else "quantization";
+    const stored = object(root, "quantization_config");
+    const fp8 = if (stored) |q| if (q.get("quant_method")) |m| holds(m, .{ .word = "fp8" }) else false else false;
+    const selected: Mode = if (quant != null) .affine else if (fp8) .fp8 else .modelopt;
+    var field = switch (selected) {
+        .affine => mismatch(text, quant),
+        .modelopt => if (stored) |q| modeloptMismatch(text, q) else "quantization",
+        .fp8 => fp8Mismatch(text, stored.?),
+    };
     if (field == null) if (given(root, "tie_word_embeddings")) |v| if (!holds(v, .{ .flag = false })) {
         field = "tie_word_embeddings";
     };
@@ -478,3 +526,63 @@ fn addMxfp8(a: std.mem.Allocator, entries: *std.json.ObjectMap, layer: usize, pr
     const name = try std.fmt.allocPrint(a, "model.language_model.layers.{d}.{s}.{s}", .{ layer, prefix, part });
     try entries.put(a, name, .{ .object = p });
 }
