+test "Qwen's block-FP8 layout passes: 128x128 blocks, routed experts converted, shared and attention projections kept BF16" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var text: std.json.ObjectMap = .empty;
+    var rope_params: std.json.ObjectMap = .empty;
+    var mtp: std.json.ObjectMap = .empty;
+    var kinds: std.json.Array = .init(a);
+    var ple: std.json.Array = .init(a);
+    try served(a, &text, &rope_params, &mtp, &kinds, &ple);
+    var kept: std.json.Array = .init(a);
+    try kept.append(.{ .string = "lm_head" });
+    for (0..wt.layers_n) |layer| {
+        for (fp8_shared) |part| try kept.append(.{ .string = try std.fmt.allocPrint(a, "model.language_model.layers.{d}.{s}", .{ layer, part }) });
+        for (if (wt.linearLayer(layer)) fp8_linear else fp8_attention) |part| {
+            try kept.append(.{ .string = try std.fmt.allocPrint(a, "model.language_model.layers.{d}.{s}", .{ layer, part }) });
+        }
+    }
+    var block: std.json.Array = .init(a);
+    for (0..2) |_| try block.append(.{ .integer = 128 });
+    var quant: std.json.ObjectMap = .empty;
+    try quant.put(a, "quant_method", .{ .string = "fp8" });
+    try quant.put(a, "activation_scheme", .{ .string = "dynamic" });
+    try quant.put(a, "weight_per_tensor", .{ .bool = false });
+    try quant.put(a, "weight_block_size", .{ .array = block });
+    try quant.put(a, "modules_to_not_convert", .{ .array = kept });
+    try std.testing.expect(fp8Mismatch(text, quant) == null);
+    try std.testing.expect(Mode.fp8.stored() and Mode.modelopt.stored() and !Mode.affine.stored());
+    try quant.put(a, "weight_per_tensor", .{ .bool = true });
+    try std.testing.expectEqualStrings("quantization_config.weight_per_tensor", fp8Mismatch(text, quant).?);
+    try quant.put(a, "weight_per_tensor", .{ .bool = false });
+    block.items[1] = .{ .integer = 64 };
+    try quant.put(a, "weight_block_size", .{ .array = block });
+    try std.testing.expectEqualStrings("quantization_config.weight_block_size", fp8Mismatch(text, quant).?);
+    block.items[1] = .{ .integer = 128 };
+    try quant.put(a, "weight_block_size", .{ .array = block });
+    // a routed expert left BF16, or a projection the loaders read as BF16 converted, is named
+    try kept.append(.{ .string = "model.language_model.layers.9.mlp.experts.3.down_proj" });
+    try quant.put(a, "modules_to_not_convert", .{ .array = kept });
+    try std.testing.expectEqualStrings("quantization_config.routed_experts", fp8Mismatch(text, quant).?);
+    _ = kept.pop();
+    const cases = [_]struct { name: []const u8, refused: []const u8 }{
+        .{ .name = "model.language_model.layers.17.mlp.shared_expert.down_proj", .refused = "quantization_config.shared_expert" },
+        .{ .name = "model.language_model.layers.0.linear_attn.in_proj_b", .refused = "quantization_config.attention_projection" },
+        .{ .name = "model.language_model.layers.47.self_attn.indexer.index_qk_proj", .refused = "quantization_config.attention_projection" },
+    };
+    for (cases) |c| {
+        const at = for (kept.items, 0..) |v, i| {
+            if (std.mem.eql(u8, v.string, c.name)) break i;
+        } else unreachable;
+        kept.items[at] = .{ .string = "lm_head" };
+        try quant.put(a, "modules_to_not_convert", .{ .array = kept });
+        try std.testing.expectEqualStrings(c.refused, fp8Mismatch(text, quant) orelse "accepted");
+        kept.items[at] = .{ .string = c.name };
+    }
+    try quant.put(a, "modules_to_not_convert", .{ .array = kept });
+    try text.put(a, "moe_intermediate_size", .{ .integer = 1280 });
+    try std.testing.expectEqualStrings("moe_intermediate_size", fp8Mismatch(text, quant).?);
+}
