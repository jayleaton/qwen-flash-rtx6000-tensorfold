--- /dev/null
+++ b/zig/src/families/flashnext/cuda_moe_hidden_sum_test.zig
@@ -0,0 +1,90 @@
+//! The hidden-size exchange's reach and its calls over a faked NCCL and driver.
+const std = @import("std");
+const cuda = @import("cuda");
+const wt = @import("cuda_prompt_wt.zig");
+const batch = @import("cuda_batch.zig");
+const mtp = @import("cuda_mtp.zig");
+const hidden_sum = @import("cuda_moe_hidden_sum.zig");
+const Collective = @import("cuda_collective.zig").Collective;
+const nccl = cuda.nccl;
+const abi = cuda.abi;
+const expect = std.testing.expect;
+const expectEqual = std.testing.expectEqual;
+
+const dims = wt.dims;
+const slots = wt.slots;
+
+const Fake = struct {
+    const Call = struct { reduce: bool, send: u64 = 0, recv: u64 = 0, count: usize = 0, f32_sum: bool = false, grid: [6]u32 = @splat(0), args: [8]u64 = @splat(0) };
+    var calls: [3]Call = undefined;
+    var len: usize = 0;
+
+    fn reduce(send: abi.DevicePtr, recv: abi.DevicePtr, count: usize, t: nccl.DataType, op: nccl.RedOp, _: nccl.Comm, _: abi.Stream) callconv(.c) nccl.Result {
+        calls[len] = .{ .reduce = true, .send = send, .recv = recv, .count = count, .f32_sum = t == .f32 and op == .sum };
+        len += 1;
+        return 0;
+    }
+    fn read(comptime T: type, args: ?[*]?*anyopaque, i: usize) T {
+        return @as(*const T, @ptrCast(@alignCast(args.?[i].?))).*;
+    }
+    fn launch(_: abi.Function, gx: c_uint, gy: c_uint, gz: c_uint, bx: c_uint, by: c_uint, bz: c_uint, _: c_uint, _: abi.Stream, args: ?[*]?*anyopaque, _: ?[*]?*anyopaque) callconv(.c) abi.Result {
+        var c: Call = .{ .reduce = false, .grid = .{ gx, gy, gz, bx, by, bz } };
+        for (0..4) |i| c.args[i] = read(u64, args, i);
+        for (4..8) |i| c.args[i] = @bitCast(@as(i64, read(c_int, args, i)));
+        calls[len] = c;
+        len += 1;
+        return 0;
+    }
+    fn asyncError(_: nccl.Comm, out: *nccl.Result) callconv(.c) nccl.Result {
+        out.* = 0;
+        return 0;
+    }
+};
+
+const Bufs = struct { y: u64 = 0x1000_0000, wts: u64 = 0x2000_0000, picks: u64 = 0x4000_0000, moe_f32: u64 = 0x3000_0000 };
+
+const Pass = struct {
+    s: *const Bufs,
+    k: struct { moe_sum: cuda.Function },
+    stream: cuda.Stream,
+    pending_f32: bool = false,
+};
+
+test "the hidden-size exchange takes two ranks whose shared expert is split by columns, and the owner cut is rank 1's" {
+    try expect(hidden_sum.applies(2, true));
+    try expect(!hidden_sum.applies(2, false));
+    try expect(!hidden_sum.applies(1, true) and !hidden_sum.applies(1, false));
+    try expectEqual(@as(usize, 256), hidden_sum.split);
+}
+
+test "every pass width sums the rank's owner chain over all its rows, then all-reduces the FP32 hidden rows in place" {
+    var d: cuda.Driver = undefined;
+    d.api.cuLaunchKernel = Fake.launch;
+    const bufs: Bufs = .{};
+    for ([_]usize{ 0, 1 }) |rank| for ([_]usize{ 1, mtp.round_rows, mtp.round_rows + 1, 1537, batch.max_chunk }) |n| {
+        var pair: [2]c_int = .{ -1, -1 };
+        if (std.c.socketpair(std.posix.AF.UNIX, std.posix.SOCK.STREAM, 0, &pair) != 0) return error.SocketPair;
+        defer for (pair) |fd| {
+            _ = std.c.close(fd);
+        };
+        var c: Collective = undefined;
+        c.failed = false;
+        c.comm = @ptrFromInt(0x1000);
+        c.link = .{ .fd = pair[0] };
+        c.timeout_ms = 1000;
+        c.rank = rank;
+        c.lib.api.ncclAllReduce = Fake.reduce;
+        c.api.ncclCommGetAsyncError = Fake.asyncError;
+        var pass: Pass = .{ .s = &bufs, .k = .{ .moe_sum = .{ .d = &d, .handle = @ptrFromInt(1) } }, .stream = .{ .d = &d, .handle = null } };
+        Fake.len = 0;
+        try hidden_sum.run(&pass, &c, n, rank);
+        try expectEqual(@as(usize, 2), Fake.len);
+        const k = Fake.calls[0];
+        try expect(!k.reduce);
+        try expectEqual([6]u32{ @intCast(n), dims / 256, 1, 256, 1, 1 }, k.grid);
+        try expectEqual([8]u64{ bufs.y, bufs.wts, bufs.picks, bufs.moe_f32, dims, slots, hidden_sum.split, rank }, k.args);
+        const ar = Fake.calls[1];
+        try expect(ar.reduce and ar.f32_sum and ar.send == bufs.moe_f32 and ar.recv == bufs.moe_f32 and ar.count == n * dims);
+        try expect(pass.pending_f32 and !c.failed);
+    };
+}
