new file mode 100644
index 000000000..12a71e7a7
--- /dev/null
+++ b/zig/kernels/cuda/flashnext_owner_sum.cuh
@@ -0,0 +1,17 @@
+// Flash Next's MoE slot sum in owner order, the same bits at --tp 1 and --tp 2 under any exchange.
+#pragma once
+
+// Slots first..first+n-1 of y times wts, owner 1 from expert `split` or shared column d / 2; part 0/1: one chain.
+__device__ __forceinline__ float fn_owner_sum(const float* __restrict__ y, const float* __restrict__ wts,
+                                              const int* __restrict__ picks, long long first, int n, int d, int col,
+                                              int split, int part) {
+    float a0 = 0.0f, a1 = 0.0f;
+    for (int k = 0; k < n; ++k) {
+        const long long at = first + k;
+        const bool one = k == n - 1 ? col >= d / 2 : picks[at] >= split;
+        const float v = y[at * d + col], w = wts[at];
+        if (one) a1 = __fmaf_rn(v, w, a1);
+        else a0 = __fmaf_rn(v, w, a0);
+    }
+    return part == 0 ? a0 : part == 1 ? a1 : __fadd_rn(a0, a1);
+}
