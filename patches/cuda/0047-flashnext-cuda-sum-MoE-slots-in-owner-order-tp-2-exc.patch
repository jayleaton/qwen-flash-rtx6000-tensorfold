diff --git a/zig/tests/cuda/flashnext_hidden_sum_tests.zig b/zig/tests/cuda/flashnext_hidden_sum_tests.zig
new file mode 100644
index 000000000..0d07460ca
--- /dev/null
+++ b/zig/tests/cuda/flashnext_hidden_sum_tests.zig
@@ -0,0 +1,162 @@
+//! Two ranks' hidden-size exchange against the one-rank owner-order sum's bytes, and both orders against FP64.
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+
+const Collective = flash.collective.Collective;
+const dims = 2560;
+const slots = 11;
+const split = 256;
+const u: f64 = std.math.ldexp(@as(f64, 1), -24);
+const steps = slots + 1;
+const gamma: f64 = steps * u / (1 - steps * u);
+
+const Kernels = struct { moe_sum: cuda.Function };
+const Bufs = struct { y: u64, wts: u64, picks: u64, moe_f32: u64 };
+const Pass = struct { s: *const Bufs, k: Kernels, stream: cuda.Stream, pending_f32: bool = false };
+
+pub fn run(gpu: check.Gpu, c: *Collective, stream: cuda.Stream, rank: usize) !void {
+    var mod = try cuda.Module.load(gpu.d, cuda.kernels.flashnext_batch);
+    defer mod.unload();
+    const k: Kernels = .{ .moe_sum = try mod.function("fn_moe_sum") };
+    for ([_]usize{ 1, 4, 16, 64, 65, 3072, 8192 }) |n| try pass(gpu, c, stream, k, rank, n);
+    check.pass("rank {d}: --tp 2's hidden-size exchange equals --tp 1's owner-order bytes, within gamma_{d} of FP64; planted controls fail", .{ rank, steps });
+}
+
+fn mix(x: u64) u64 {
+    var z = x +% 0x9e37_79b9_7f4a_7c15;
+    z = (z ^ (z >> 30)) *% 0xbf58_476d_1ce4_e5b9;
+    z = (z ^ (z >> 27)) *% 0x94d0_49bb_1331_11eb;
+    return z ^ (z >> 31);
+}
+
+/// A value in [-1, 1) times 2^-12 to 2^3: expert rows' range, with the cancellation a real sum meets.
+fn value(h: u64) f32 {
+    const unit = @as(f32, @floatFromInt(h >> 40)) / (1 << 24);
+    return (unit * 2 - 1) * std.math.ldexp(@as(f32, 1), @as(i32, @intCast((h >> 8) % 16)) - 12);
+}
+
+/// Rank `rank`'s y (rank 2: both ranks'), the weights and expert ids: owner 1 from expert 256 or column dims / 2.
+fn fill(y: []f32, wts: []f32, picks: []i32, n: usize, rank: usize) void {
+    @memset(y, 0);
+    for (0..n) |r| for (0..slots) |s| {
+        const pair = r * slots + s;
+        wts[pair] = @as(f32, @floatFromInt((mix(pair ^ 0x77) >> 40) + 1)) / (1 << 24);
+        const owner = mix(pair ^ 0x3a) & 1;
+        picks[pair] = if (s == slots - 1) 512 else @intCast(owner * split + mix(pair ^ 0x5c) % split);
+        for (0..dims) |d| {
+            const of = if (s == slots - 1) @intFromBool(d >= dims / 2) else owner;
+            if (rank == 2 or of == rank) y[pair * dims + d] = value(mix(pair * dims + d));
+        }
+    };
+}
+
+const Stats = struct { worst: f64 = 0, worst_col: usize = 0, max_abs: f64 = 0, sum_abs: f64 = 0, over: usize = 0 };
+
+fn note(st: *Stats, got: f32, ref: f64, scale: f64, col: usize) void {
+    const err = @abs(@as(f64, got) - ref);
+    st.max_abs = @max(st.max_abs, err);
+    st.sum_abs += err;
+    if (err > gamma * scale) st.over += 1;
+    const rel = if (scale == 0) (if (err == 0) 0 else std.math.inf(f64)) else err / (gamma * scale);
+    if (rel > st.worst) {
+        st.worst = rel;
+        st.worst_col = col;
+    }
+}
+
+fn bf16(v: f32) u16 {
+    const bits: u32 = @bitCast(v);
+    return @truncate((bits + 0x7fff + ((bits >> 16) & 1)) >> 16);
+}
+
+fn pass(gpu: check.Gpu, c: *Collective, stream: cuda.Stream, k: Kernels, rank: usize, n: usize) !void {
+    const a = gpu.gpa;
+    const mine = try a.alloc(f32, n * slots * dims);
+    defer a.free(mine);
+    const whole = try a.alloc(f32, n * slots * dims);
+    defer a.free(whole);
+    const wts = try a.alloc(f32, n * slots);
+    defer a.free(wts);
+    const picks = try a.alloc(i32, n * slots);
+    defer a.free(picks);
+    fill(mine, wts, picks, n, rank);
+    fill(whole, wts, picks, n, 2);
+    var wd = try cuda.DeviceBuffer.fromHost(gpu.d, std.mem.sliceAsBytes(wts));
+    defer wd.free();
+    var pd = try cuda.DeviceBuffer.fromHost(gpu.d, std.mem.sliceAsBytes(picks));
+    defer pd.free();
+    var yd = try cuda.DeviceBuffer.fromHost(gpu.d, std.mem.sliceAsBytes(mine));
+    defer yd.free();
+    var yw = try cuda.DeviceBuffer.fromHost(gpu.d, std.mem.sliceAsBytes(whole));
+    defer yw.free();
+    var moe = try cuda.DeviceBuffer.alloc(gpu.d, (n + 1) * dims * 4);
+    defer moe.free();
+    var one = try cuda.DeviceBuffer.alloc(gpu.d, n * dims * 4);
+    defer one.free();
+    try moe.fill8(0x5a, stream.handle);
+    const two_bufs: Bufs = .{ .y = yd.ptr, .wts = wd.ptr, .picks = pd.ptr, .moe_f32 = moe.ptr };
+    var p: Pass = .{ .s = &two_bufs, .k = k, .stream = stream };
+    try flash.moe_hidden_sum.run(&p, c, n, rank);
+    const one_bufs: Bufs = .{ .y = yw.ptr, .wts = wd.ptr, .picks = pd.ptr, .moe_f32 = one.ptr };
+    var q: Pass = .{ .s = &one_bufs, .k = k, .stream = stream };
+    try flash.moe_batch.sumSlots(&q, 0, n);
+    try c.finish(stream);
+    try check.expect(p.pending_f32, "rank {d}: the sum is left pending in fp32", .{rank});
+    const raw = try check.download(gpu, moe);
+    defer a.free(raw);
+    for (raw[n * dims * 4 ..]) |b| try check.expect(b == 0x5a, "rank {d}: {d} rows: nothing written past the pass", .{ rank, n });
+    const solo = try check.download(gpu, one);
+    defer a.free(solo);
+    try check.sameBytes("--tp 2 hidden-size exchange against the --tp 1 owner-order sum", raw[0 .. n * dims * 4], solo);
+    const got: []const f32 = @alignCast(std.mem.bytesAsSlice(f32, raw[0 .. n * dims * 4]));
+
+    var os: Stats = .{};
+    var ms: Stats = .{};
+    var bf_diff: usize = 0;
+    var host_diff: usize = 0;
+    for (0..n) |r| for (0..dims) |d| {
+        var a0: f32 = 0;
+        var a1: f32 = 0;
+        var old: f32 = 0;
+        var x: f64 = 0;
+        var m: f64 = 0;
+        for (0..slots) |s| {
+            const at = r * slots + s;
+            const v = whole[at * dims + d];
+            const of = if (s == slots - 1) d >= dims / 2 else picks[at] >= split;
+            if (of) a1 = @mulAdd(f32, v, wts[at], a1) else a0 = @mulAdd(f32, v, wts[at], a0);
+            old = @mulAdd(f32, v, wts[at], old);
+            const t = @as(f64, v) * wts[at];
+            x += t;
+            m += @abs(t);
+        }
+        const g = got[r * dims + d];
+        if (@as(u32, @bitCast(g)) != @as(u32, @bitCast(a0 + a1))) host_diff += 1;
+        note(&os, g, x, m, d);
+        note(&ms, old, x, m, d);
+        if (bf16(g) != bf16(old)) bf_diff += 1;
+    };
+    const count: f64 = @floatFromInt(n * dims);
+    try check.expect(host_diff == 0, "rank {d}: {d} rows: {d} sums differ from the host owner order", .{ rank, n, host_diff });
+    try check.expect(os.over == 0, "rank {d}: {d} rows: {d} elements past gamma_{d} of FP64", .{ rank, n, os.over, steps });
+    std.debug.print("owner-sum rank={d} rows={d} owner max_abs={e:.3} mean_abs={e:.3} worst_of_bound={d:.4} col={d} | main max_abs={e:.3} mean_abs={e:.3} worst_of_bound={d:.4} col={d} | bf16_differ={d:.5}%\n", .{ rank, n, os.max_abs, os.sum_abs / count, os.worst, os.worst_col, ms.max_abs, ms.sum_abs / count, ms.worst, ms.worst_col, 100 * @as(f64, @floatFromInt(bf_diff)) / count });
+
+    // planted: a flipped high mantissa bit in the largest sum breaks the bytes and the FP64 bound
+    var at: usize = 0;
+    for (got, 0..) |v, i| {
+        if (@abs(v) > @abs(got[at])) at = i;
+    }
+    const planted: f32 = @bitCast(@as(u32, @bitCast(got[at])) ^ (1 << 22));
+    var x: f64 = 0;
+    var m: f64 = 0;
+    for (0..slots) |s| {
+        const i = (at / dims) * slots + s;
+        const t = @as(f64, whole[i * dims + at % dims]) * wts[i];
+        x += t;
+        m += @abs(t);
+    }
+    try check.expect(@abs(@as(f64, planted) - x) > gamma * m, "rank {d}: {d} rows: planted sum at {d} breaks the FP64 bound", .{ rank, n, at });
+    check.pass("rank {d}: {d} rows: --tp 1 bytes, host owner order, gamma_{d} bound, nothing past the pass; planted control fails", .{ rank, n, steps });
+}
