+
+/// sumSlots with `part` 0 or 1: that owner's chain alone, which --tp 2's all-reduce adds to the other's.
+pub fn sumPart(self: anytype, r0: usize, rows: usize, part: i32) !void {
     const s = self.s;
     var a: cuda.Args = .{};
     a.add(s.y + r0 * slots * dims * 4);
     a.add(s.wts + r0 * slots * 4);
+    a.add(s.picks + r0 * slots * 4);
     a.add(s.moe_f32 + r0 * dims * 4);
     a.add(batch.cint(dims));
     a.add(batch.cint(slots));
+    a.add(batch.cint(@import("cuda_moe_hidden_sum.zig").split));
+    a.add(part);
     try cuda.launch.launch(self.k.moe_sum, .{ .grid = .{ .x = @intCast(rows), .y = dims / 256 }, .block = .{ .x = 256 } }, self.stream, &a);
 }
+
+/// The scratch's MoE slots from row r0, as the owner-order writeback reads them.
+pub fn slotsAt(s: anytype, r0: usize) @import("cuda_glue.zig").Slots {
+    return .{ .y = s.y + r0 * slots * dims * 4, .wts = s.wts + r0 * slots * 4, .picks = s.picks + r0 * slots * 4, .count = slots, .split = @import("cuda_moe_hidden_sum.zig").split };
