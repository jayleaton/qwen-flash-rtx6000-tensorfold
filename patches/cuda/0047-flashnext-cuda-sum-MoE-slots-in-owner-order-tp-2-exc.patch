new file mode 100644
index 000000000..6a0641c89
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_moe_hidden_sum.zig
@@ -0,0 +1,24 @@
+//! --tp 2's MoE exchange: each rank sums its own slots in owner order, then one FP32 all-reduce of the hidden rows.
+const wt = @import("cuda_prompt_wt.zig");
+const moe = @import("cuda_batch_moe.zig");
+
+const dims = wt.dims;
+
+/// Owner 1's first routed expert: rank 1's first at --tp 2, and the owner order's cut at every world.
+pub const split = wt.experts_n / 2;
+
+/// Each rank must hold exactly one owner's slots: its experts, and its half of the shared expert's columns.
+pub fn applies(world: usize, split_shared: bool) bool {
+    return world == 2 and split_shared;
+}
+
+/// moe_f32: this rank's owner chain, then the all-reduce adds the peer's: owner 0's plus owner 1's, as at --tp 1.
+pub fn run(pass: anytype, c: anytype, n: usize, rank: usize) !void {
+    try moe.sumPart(pass, 0, n, @intCast(rank));
+    try c.sum(pass.stream, pass.s.moe_f32, n * dims);
+    pass.pending_f32 = true;
+}
+
+test {
+    if (@import("builtin").os.tag != .windows) _ = @import("cuda_moe_hidden_sum_test.zig"); // over a Unix socket pair
+}
