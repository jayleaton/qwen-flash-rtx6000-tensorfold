diff --git a/zig/src/families/flashnext/cuda_prompt_overlap.zig b/zig/src/families/flashnext/cuda_prompt_overlap.zig
new file mode 100644
index 000000000..66b4789c6
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_prompt_overlap.zig
@@ -0,0 +1,145 @@
+//! A --tp 2 prompt chunk as two halves a layer apart: each half's expert exchange runs on a side stream and
+//! communicator while the pass's stream computes the other half (TF_FLASHNEXT_PROMPT_OVERLAP).
+//!
+//! Half A (the chunk's first rows) runs each layer before half B, on the same stream, so B reads A's keys, values,
+//! DeltaNet state and n-gram tail as the next chunk would. Every kernel and exchange is the one a chunk of that
+//! half's rows launches, so each row's bits are its own; only when the exchange runs moves.
+const std = @import("std");
+const cuda = @import("cuda");
+const batch = @import("cuda_batch.zig");
+const parts = @import("cuda_batch_state.zig");
+const owner = @import("cuda_owner_slots.zig");
+const hidden_sum = @import("cuda_moe_hidden_sum.zig");
+const wt = @import("cuda_prompt_wt.zig");
+
+/// TF_FLASHNEXT_PROMPT_OVERLAP as read at load; both ranks must agree (the rank identity carries it).
+pub var on = false;
+
+pub fn enabled() !bool {
+    return @import("sys").environment.read(bool, "TF_FLASHNEXT_PROMPT_OVERLAP", false);
+}
+
+/// Rows a chunk needs before it runs as two halves.
+pub const min_rows: usize = 2048;
+
+/// A half's exchange: the side stream it runs on, the point after its experts, and the point after its sums gather.
+pub const Side = struct {
+    stream: cuda.Stream,
+    fed: cuda.Event,
+    done: cuda.Event,
+};
+
+/// The engine's side stream, each half's events and half B's scratch.
+pub const Pair = struct {
+    stream: cuda.Stream,
+    a: Side,
+    b: Side,
+    scratch: parts.Scratch,
+
+    pub fn free(p: *Pair, gpa: std.mem.Allocator) void {
+        p.stream.deinit();
+        inline for (.{ &p.a, &p.b }) |x| {
+            x.fed.deinit();
+            x.done.deinit();
+        }
+        p.scratch.free(gpa);
+    }
+};
+
+/// Half B's rows of an `n`-row chunk (half A takes the rest): half the rows, whole attention blocks.
+pub fn rowsB(n: usize) usize {
+    return n / 2 / parts.att_rows * parts.att_rows;
+}
+
+/// At load, after the engine's scratch: the pair's stream, events and half B's scratch, where the switch applies.
+pub fn reserve(e: anytype) !void {
+    on = try enabled();
+    if (!on or e.pair != null) return;
+    const c = e.collective orelse return;
+    if (c.side == null or !owner.on or hidden_sum.on or !e.span.isWhole()) return;
+    const gpa = e.gpa;
+    const pair = try gpa.create(Pair);
+    errdefer gpa.destroy(pair);
+    var stream = try cuda.Stream.initPriority(e.driver, .highest);
+    errdefer stream.deinit();
+    var events: [4]cuda.Event = undefined;
+    var made: usize = 0;
+    errdefer for (events[0..made]) |*x| x.deinit();
+    while (made < events.len) : (made += 1) events[made] = try cuda.Event.init(e.driver, false);
+    const z: parts.Sizes = .{ .head_rows = parts.head_rows_one, .lane_reduce = !e.batch_k.native_lane.clusters, .owner = true };
+    const scratch = try parts.Scratch.alloc(gpa, e.driver, e.stream.*, @max(rowsB(e.chunk), 1), z);
+    pair.* = .{ .stream = stream, .a = .{ .stream = stream, .fed = events[0], .done = events[1] }, .b = .{ .stream = stream, .fed = events[2], .done = events[3] }, .scratch = scratch };
+    e.pair = pair;
+}
+
+/// Whether `forward`'s chunks run as halves: a plain prompt at --tp 2 on the owner-slot exchange.
+fn applies(e: anytype, p: anytype, seq: anytype, hooks: parts.Hooks) bool {
+    if (e.pair == null) return false;
+    if (hooks.keep != null or hooks.logits == .all or hooks.moe_add != null or p.m.pocket != null) return false;
+    if (seq.media != null or p.lanes.len > 0 or p.m.stage != null) return false;
+    return true;
+}
+
+/// Engine.forward's chunks, each of at least `min_rows` as two halves; false when the switch does not apply.
+pub fn forward(e: anytype, p: anytype, seq: anytype, ids: []const u32, hooks: parts.Hooks) !bool {
+    if (!applies(e, p, seq, hooks)) return false;
+    const pair = e.pair.?;
+    var at: usize = 0;
+    while (at < ids.len) {
+        const n = @min(p.s.cap, ids.len - at);
+        const last = at + n == ids.len;
+        e.ngram.warmAhead(ids, at + n, @min(ids.len, at + n + p.s.cap));
+        p.hooks.logits = if (last) hooks.logits else .none;
+        p.hooks.streams = if (hooks.streams != 0) hooks.streams + at * wt.wide * 2 else 0;
+        const logits_host = if (last and hooks.logits != .none and hooks.host_logits) seq.logits else null;
+        const nb = @min(rowsB(n), pair.scratch.cap);
+        if (n < min_rows or nb == 0) {
+            try p.chunk(ids[at..][0..n], seq.fed + at, logits_host);
+        } else try halves(p, pair, ids[at..][0..n], seq.fed + at, n - nb, logits_host);
+        at += n;
+    }
+    if (hooks.logits == .none) try e.complete();
+    seq.fed += ids.len;
+    return true;
+}
+
+/// One chunk as half A (`na` rows) then half B, layer by layer.
+fn halves(p: anytype, pair: *Pair, ids: []const u32, pos0: usize, na: usize, logits_host: ?[]u8) !void {
+    const t0 = std.Io.Clock.awake.now(p.io).toNanoseconds();
+    var a = p.*;
+    a.side = &pair.a;
+    a.hooks.logits = .none;
+    var b = p.*;
+    b.s = &pair.scratch;
+    b.side = &pair.b;
+    if (p.hooks.streams != 0) b.hooks.streams = p.hooks.streams + na * wt.wide * 2;
+    // half B's n-gram rows follow half A's last tokens; the sequence keeps B's window after both
+    var history: [2]i64 = undefined;
+    for (&history, ids[na - history.len .. na]) |*h, v| h.* = v;
+    var ga: parts.Gather = undefined;
+    var gb: parts.Gather = undefined;
+    defer a.joinGather();
+    defer b.joinGather();
+    try a.begin(ids[0..na], pos0, &ga, p.seq.history[0..]);
+    try b.begin(ids[na..], pos0 + na, &gb, history[0..]);
+    for (p.m.layers, 0..) |*lw, layer| {
+        try a.layerStep(lw, layer, ids[0..na], &ga);
+        try b.layerStep(lw, layer, ids[na..], &gb);
+    }
+    try a.end(null);
+    try b.end(logits_host);
+    a.joinGather();
+    b.joinGather();
+    @memcpy(p.seq.history[0..], history[0..]);
+    if (batch.Kernels.profile()) {
+        try p.complete();
+        std.debug.print("batch: {d} + {d} rows at {d} in {d:.1} ms (two halves)\n", .{ na, ids.len - na, pos0, @as(f64, @floatFromInt(std.Io.Clock.awake.now(p.io).toNanoseconds() - t0)) / 1e6 });
+    }
+}
+
+test "half B takes whole attention blocks of half the rows, half A the rest" {
+    try std.testing.expectEqual(@as(usize, 4096), rowsB(8192));
+    try std.testing.expectEqual(@as(usize, 1024), rowsB(2048));
+    try std.testing.expectEqual(@as(usize, 1280), rowsB(3000));
+    try std.testing.expectEqual(@as(usize, 0), rowsB(511));
+}
