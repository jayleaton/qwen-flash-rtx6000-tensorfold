diff --git a/zig/src/families/flashnext/cuda_seq_bytes.zig b/zig/src/families/flashnext/cuda_seq_bytes.zig
index 323cb3bed..c086a0ad2 100644
--- a/zig/src/families/flashnext/cuda_seq_bytes.zig
+++ b/zig/src/families/flashnext/cuda_seq_bytes.zig
@@ -4,6 +4,7 @@ const wt = @import("cuda_prompt_wt.zig");
 const gdn = @import("cuda_gdn.zig");
 const pages = @import("cuda_pages.zig");
 const Heads = @import("cuda_heads.zig").Heads;
+const Span = @import("cuda_span.zig").Span;
 
 const linear_n = wt.linear_n;
 const attn_n = wt.attn_n;
@@ -46,6 +47,13 @@ pub fn seqBytes(cap: usize, h: Heads) usize {
     return linear + attnBytes(cap, h) + wt.ple_tail_n * wt.wide * 2;
 }
 
+/// Device bytes a pipeline stage's `newSeq(cap)` allocates: its own layers' states and caches, the n-gram tail.
+pub fn stageBytes(cap: usize, h: Heads, span: Span) usize {
+    const linear = span.held(.linear) * (convBytes(h) + stateBytes(h));
+    const attn = span.held(.attn) * (2 * kvBytes(cap, h) + indexBytes(cap) + pooledBytes(cap));
+    return linear + attn + wt.ple_tail_n * wt.wide * 2;
+}
