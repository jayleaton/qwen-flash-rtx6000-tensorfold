diff --git a/zig/src/families/flashnext/cuda_span.zig b/zig/src/families/flashnext/cuda_span.zig
index 45ffafba2..40e02aac2 100644
--- a/zig/src/families/flashnext/cuda_span.zig
+++ b/zig/src/families/flashnext/cuda_span.zig
@@ -1,7 +1,23 @@
 //! A pipeline stage's layers [first, end) of the model; the stage holding layer 0 also embeds and runs the head.
 const std = @import("std");
+const cuda = @import("cuda");
 const wt = @import("cuda_prompt_wt.zig");
 
+/// A sequence's per-layer state arrays, each indexed by its own layer count (wt.linearIndex, wt.attnIndex).
+pub const Kind = enum {
+    linear,
+    attn,
+
+    pub fn count(k: Kind) usize {
+        return if (k == .linear) wt.linear_n else wt.attn_n;
+    }
+
+    /// The decoder layer of entry `i`: linear layers fill three of every four, attention the fourth.
+    pub fn layer(k: Kind, i: usize) usize {
+        return if (k == .linear) i + i / 3 else 4 * i + 3;
+    }
+};
+
 pub const Span = struct {
     first: usize = 0,
     end: usize = wt.layers_n,
@@ -40,6 +56,30 @@ pub const Span = struct {
         return s.owns(layerOf(name) orelse return true);
     }
 
+    /// Entries of a kind this stage holds.
+    pub fn held(s: Span, k: Kind) usize {
+        var n: usize = 0;
+        for (0..k.count()) |i| n += @intFromBool(s.owns(k.layer(i)));
+        return n;
+    }
+
+    /// One zeroed device buffer per entry of `k`: `len` bytes for this stage's own layers, none for the others'.
+    pub fn zeros(s: Span, gpa: std.mem.Allocator, driver: *cuda.Driver, stream: cuda.Stream, k: Kind, len: usize) ![]cuda.DeviceBuffer {
+        const out = try gpa.alloc(cuda.DeviceBuffer, k.count());
+        var made: usize = 0;
+        errdefer {
+            cuda.completion.drain(driver, stream, "Flash Next stage sequence fills did not drain before rollback");
+            for (out[0..made]) |*b| b.free();
+            gpa.free(out);
+        }
+        for (out, 0..) |*b, i| {
+            b.* = try cuda.DeviceBuffer.alloc(driver, if (s.owns(k.layer(i))) len else 0);
+            made += 1;
+            try b.fill8(0, stream.handle);
+        }
+        return out;
+    }
+
     /// Rank `rank`'s layers at `stages` pipeline stages (1: the whole model), split at TF_FLASHNEXT_PP_SPLIT.
     pub fn ofPlacement(stages: usize, rank: usize) !Span {
         if (stages == 1) return .whole;
@@ -91,6 +131,17 @@ test "a stage keeps its own layers' tensors and every tensor outside the decoder
     try std.testing.expectError(error.FlashNextStagesOverTwo, Span.ofPlacement(3, 0));
 }
 
+test "a stage holds its own layers' state entries, every entry once across the two" {
+    for (0..wt.linear_n) |i| try std.testing.expectEqual(i, wt.linearIndex(Kind.linear.layer(i)));
+    for (0..wt.attn_n) |i| try std.testing.expectEqual(i, wt.attnIndex(Kind.attn.layer(i)));
+    const a = try Span.ofRank(24, 0);
+    const b = try Span.ofRank(24, 1);
+    try std.testing.expectEqual(@as(usize, 18), a.held(.linear));
+    try std.testing.expectEqual(@as(usize, 6), b.held(.attn));
+    try std.testing.expectEqual(wt.linear_n, (try Span.ofRank(7, 0)).held(.linear) + (try Span.ofRank(7, 1)).held(.linear));
+    try std.testing.expectEqual(wt.attn_n, Span.whole.held(.attn));
+}
+
