From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jay Leaton <58495321+jayleaton@users.noreply.github.com>
Date: Fri, 20 Nov 2026 17:22:04 +0700
Subject: [PATCH 41/46] flashnext cuda: TF_FLASHNEXT_SPLIT_ROWS sets the rows
 past which --tp 2 splits the expert exchange by rows; one host picks its own
 default

---
 docs/environment.md                           |  1 +
 .../families/flashnext/cuda_moe_exchange.zig  | 21 +++++++++++++++++--
 .../flashnext/cuda_moe_exchange_test.zig      | 13 ++++++++++++
 .../families/flashnext/cuda_rank_engine.zig   |  5 ++++-
 zig/src/platform/environment.zig              |  1 +
 .../platform/environment_flashnext_test.zig   |  4 ++--
 6 files changed, 40 insertions(+), 5 deletions(-)

diff --git a/docs/environment.md b/docs/environment.md
index c84b4e7cb..91006c8f2 100644
--- a/docs/environment.md
+++ b/docs/environment.md
@@ -161,6 +161,7 @@ stops the start with the variable, the supplied text and the accepted forms.
 | `TF_FLASHNEXT_DRAFTS_GREEDY` | Whole draft count; default 8, then clamped to 1 through 15 |
 | `TF_FLASHNEXT_GREEDY_WIDE` | Whole round width; default 4 |
 | `TF_FLASHNEXT_WINDOW_ROWS` | Whole row count; default the shared round's rows, capped by them |
+| `TF_FLASHNEXT_SPLIT_ROWS` | Whole row count; `0` or unset takes the link's default (64, the shared round's rows). At `--tp 2`, a pass of more rows than this reduce-scatters its experts' rows and gathers the sums instead of one all-reduce. Give every rank the same value. |
 | `TF_FLASHNEXT_READOUT_ROWS` | Whole row count; default 64; `0` never takes the tiles |
 | `TF_FLASHNEXT_CHUNK` | Whole prompt rows a pass, 1 through 16384; default 3072 |
 | `TF_FLASHNEXT_CHUNK_SOLO` | Whole prompt rows a pass with no stream decoding, from the chunk `TF_FLASHNEXT_CHUNK` resolves to through 16384; unset or blank is the larger of that chunk and 8192 on a server of one stream, and that chunk elsewhere |
diff --git a/zig/src/families/flashnext/cuda_moe_exchange.zig b/zig/src/families/flashnext/cuda_moe_exchange.zig
index f1ca6c5e7..141e29eac 100644
--- a/zig/src/families/flashnext/cuda_moe_exchange.zig
+++ b/zig/src/families/flashnext/cuda_moe_exchange.zig
@@ -8,9 +8,26 @@ const dims = wt.dims;
 const slots = wt.slots;
 const share = cuda.rank_scatter.share;
 
-/// Rows past any decode round or verify window: `world` and `n` are what both ranks' passes agree on.
+/// Rows a pass takes before it splits its exchange: past any decode round or verify window until both ranks meet.
+pub var split_rows: usize = mtp.round_rows;
+
+/// One host's threshold, where a reduce-scatter and gather of a row's halves beats its whole all-reduce.
+const one_host_rows: usize = mtp.round_rows;
+
+/// TF_FLASHNEXT_SPLIT_ROWS, 0 when unset: the ranks' identity carries it, so both pick the same threshold.
+pub fn asked() !usize {
+    return @import("sys").environment.read(usize, "TF_FLASHNEXT_SPLIT_ROWS", 0);
+}
+
+/// The threshold both ranks run: the operator's, else one host's, else the decode round's rows.
+pub fn pick(given: usize, one_host: bool) usize {
+    if (given != 0) return given;
+    return if (one_host) one_host_rows else mtp.round_rows;
+}
+
+/// Rows past the threshold: `world` and `n` are what both ranks' passes agree on.
 pub fn rowSplit(world: usize, n: usize) bool {
-    return world == 2 and n > mtp.round_rows;
+    return world == 2 and n > split_rows;
 }
 
 /// Rows of each rank's reduce-scatter block: rank 0's share, which rank 1's pads to (row n when n is odd).
diff --git a/zig/src/families/flashnext/cuda_moe_exchange_test.zig b/zig/src/families/flashnext/cuda_moe_exchange_test.zig
index 529fe90db..674455836 100644
