@@ -111,6 +111,19 @@ test "rounds and windows keep the all-reduce; a wider prompt pass splits, at --t
     }
 }
 
+test "the operator's threshold wins on any link, and a lowered one splits a verify window's rows" {
+    try expectEqual(@as(usize, 12), exchange.pick(12, false));
+    try expectEqual(@as(usize, 12), exchange.pick(12, true));
+    try expectEqual(@as(usize, mtp.round_rows), exchange.pick(0, false));
+    const save = exchange.split_rows;
+    defer exchange.split_rows = save;
+    exchange.split_rows = 12;
+    try expect(!exchange.rowSplit(2, 12));
+    try expect(exchange.rowSplit(2, 13));
+    try expect(!exchange.rowSplit(1, 13));
+    try expectEqual(2 * exchange.block(13), exchange.clearedRows(2, 13));
+}
+
 test "the ranks' rows cover a split pass once, in blocks that pad at most the scratch's one spare row" {
