diff --git a/zig/kernels/cuda/flashnext_peer.cuh b/zig/kernels/cuda/flashnext_peer.cuh
new file mode 100644
index 000000000..bd6472198
--- /dev/null
+++ b/zig/kernels/cuda/flashnext_peer.cuh
@@ -0,0 +1,68 @@
+// Owner-slot exchange at --tp 2 on one host: each rank writes the y columns it owns into the peer's mapped buffer.
+
+// A pair's columns this rank owns, in float4 units of `q` (dims / 4): a routed expert's whole row, half the shared row.
+__device__ __forceinline__ void fn_peer_cols(int pick, int first, int count, int shared_id, int split_shared, int rank,
+                                             int q, int& c0, int& c1) {
+    c0 = 0;
+    c1 = 0;
+    if (pick >= first && pick < first + count) {
+        c1 = q;
+    } else if (pick == shared_id) {
+        if (split_shared) {
+            c0 = rank * (q / 2);
+            c1 = c0 + q / 2;
+        } else if (rank == 0) {
+            c1 = q;
+        }
+    }
+}
+
+// An all-reduce's x + 0 for each lane: -0 becomes +0, every other value keeps its bits.
+__device__ __forceinline__ float4 fn_peer_plus0(float4 v) {
+    return make_float4(v.x + 0.0f, v.y + 0.0f, v.z + 0.0f, v.w + 0.0f);
+}
+
+// Pairs p0.. (one block each): this rank's columns of y into the peer's rx; the last block raises the peer's flag.
+extern "C" __global__ void __launch_bounds__(128) fn_peer_send(const float4* __restrict__ y, float4* __restrict__ rx,
+                                                               const int* __restrict__ picks, int p0, int first,
+                                                               int count, int shared_id, int split_shared, int rank,
+                                                               int q, unsigned* __restrict__ counter,
+                                                               volatile unsigned* __restrict__ flag, unsigned epoch) {
+    const int p = p0 + blockIdx.x;
+    int c0, c1;
+    fn_peer_cols(picks[p], first, count, shared_id, split_shared, rank, q, c0, c1);
+    const long long base = static_cast<long long>(p) * q;
+    for (int c = c0 + threadIdx.x; c < c1; c += blockDim.x) rx[base + c] = fn_peer_plus0(y[base + c]);
+    __syncthreads();
+    if (threadIdx.x == 0) {
+        __threadfence_system();
+        if (atomicAdd(counter, 1u) + 1u == gridDim.x) {
+            *counter = 0u;
+            __threadfence_system();
+            *flag = epoch;
+        }
+    }
+}
+
+// Pairs p0.. (one block each), once the peer's flag reaches `epoch`: the peer's columns from rx, every value plus 0.
+extern "C" __global__ void __launch_bounds__(128) fn_peer_merge(float4* __restrict__ y, const float4* rx,
+                                                                const int* __restrict__ picks, int p0, int first,
+                                                                int count, int shared_id, int split_shared, int rank,
+                                                                int q, volatile unsigned* __restrict__ flag,
+                                                                unsigned epoch) {
+    if (threadIdx.x == 0) {
+        const long long start = clock64();
+        while (static_cast<int>(*flag - epoch) < 0)
+            if (clock64() - start > (1ll << 35)) __trap();  // about 15 s: the peer is gone, fail rather than hang
+        __threadfence();
+    }
+    __syncthreads();
+    const int p = p0 + blockIdx.x;
+    int c0, c1;
+    fn_peer_cols(picks[p], first, count, shared_id, split_shared, rank, q, c0, c1);
+    const long long base = static_cast<long long>(p) * q;
+    for (int c = threadIdx.x; c < q; c += blockDim.x) {
+        const bool mine = c >= c0 && c < c1;
+        y[base + c] = fn_peer_plus0(mine ? y[base + c] : rx[base + c]);
+    }
+}
