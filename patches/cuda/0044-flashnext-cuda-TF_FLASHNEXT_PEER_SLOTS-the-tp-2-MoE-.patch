diff --git a/zig/src/families/flashnext/cuda_peer_slots.zig b/zig/src/families/flashnext/cuda_peer_slots.zig
new file mode 100644
index 000000000..ef6b6be00
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_peer_slots.zig
@@ -0,0 +1,131 @@
+//! TF_FLASHNEXT_PEER_SLOTS: the MoE exchange at --tp 2 on one host as owner-slot writes into the peer's mapped buffer.
+const std = @import("std");
+const cuda = @import("cuda");
+const platform = @import("sys");
+const wt = @import("cuda_prompt_wt.zig");
+const wire = @import("cuda_rank_wire.zig");
+
+/// CUipcMemHandle and the three driver calls, looked up apart from `abi.Api` like the P2P report's.
+pub const Handle = extern struct { reserved: [64]u8 };
+const Ipc = struct {
+    cuIpcGetMemHandle: *const fn (*Handle, u64) callconv(.c) c_int,
+    cuIpcOpenMemHandle_v2: *const fn (*u64, Handle, c_uint) callconv(.c) c_int,
+    cuIpcCloseMemHandle: *const fn (u64) callconv(.c) c_int,
+};
+const lazy_peer_access: c_uint = 1; // CU_IPC_MEM_LAZY_ENABLE_PEER_ACCESS
+
+/// TF_FLASHNEXT_PEER_SLOTS: unset, blank or 0 keeps the collective; 1 writes owned slots into the peer's buffer.
+pub fn enabled() !bool {
+    return platform.environment.read(bool, "TF_FLASHNEXT_PEER_SLOTS", false) catch return error.BadPeerSlots;
+}
+
+/// Rows a pass exchanges this way (a decode round's or verify window's); longer passes keep the collective.
+pub const rows: usize = 128;
+const quads = wt.dims / 4;
+const half = rows * wt.slots * wt.dims * 4; // one parity's receive rows
+const flag_at = 2 * half; // the peer's epoch, then this rank's send counter a cache line on
+const counter_at = flag_at + 128;
+const bytes = flag_at + 256;
+
+pub const PeerSlots = struct {
+    lib: platform.DynLib,
+    ipc: Ipc,
+    d: *const cuda.Driver,
+    local: u64,
+    peer: u64,
+    rank: usize,
+    epoch: u32 = 0,
+
+    /// Both ranks at the same point after load: a buffer each, handles swapped over `link`, the peer's mapped.
+    pub fn init(d: *const cuda.Driver, link: wire.Link, rank: usize, timeout_ms: u64) !PeerSlots {
+        if (rank > 1) return error.BadRank;
+        var lib = platform.DynLib.open(platform.cuda_driver) catch return error.MissingSymbol;
+        errdefer lib.close();
+        var ipc: Ipc = undefined;
+        const info = @typeInfo(Ipc).@"struct";
+        inline for (info.field_names, info.field_types) |name, T| @field(ipc, name) = lib.lookup(T, name) orelse return error.MissingSymbol;
+        var local: u64 = 0;
+        try d.check(d.api.cuMemAlloc_v2(&local, bytes), "cuMemAlloc_v2");
+        errdefer _ = d.api.cuMemFree_v2(local);
+        try d.check(d.api.cuMemsetD8_v2(local, 0, bytes), "cuMemsetD8_v2");
+        var mine: Handle = undefined;
+        try d.check(ipc.cuIpcGetMemHandle(&mine, local), "cuIpcGetMemHandle");
+        var theirs: Handle = undefined;
+        const until = wire.deadline(timeout_ms);
+        if (rank == 0) {
+            try link.send(std.mem.asBytes(&mine), until);
+            try link.receive(std.mem.asBytes(&theirs), until);
+        } else {
+            try link.receive(std.mem.asBytes(&theirs), until);
+            try link.send(std.mem.asBytes(&mine), until);
+        }
+        var peer: u64 = 0;
+        try d.check(ipc.cuIpcOpenMemHandle_v2(&peer, theirs, lazy_peer_access), "cuIpcOpenMemHandle_v2");
+        return .{ .lib = lib, .ipc = ipc, .d = d, .local = local, .peer = peer, .rank = rank };
+    }
+
+    pub fn deinit(p: *PeerSlots) void {
+        _ = p.ipc.cuIpcCloseMemHandle(p.peer);
+        _ = p.d.api.cuMemFree_v2(p.local);
+        p.lib.close();
+    }
+
+    pub fn fits(n: usize) bool {
+        return n <= rows;
+    }
+
+    /// Owner columns of `send` rows' pairs to the peer, then the peer's into y for `merge` rows: the collective's sums.
+    pub fn exchange(p: *PeerSlots, send_fn: cuda.Function, merge_fn: cuda.Function, stream: cuda.Stream, y: u64, picks: u64, send: [2]usize, merge: [2]usize, own: Owner) !void {
+        if (send[1] <= send[0] or merge[1] <= merge[0] or send[1] > rows or merge[1] > rows) return error.UnexpectedTensor;
+        p.epoch +%= 1;
+        const rx = (p.epoch & 1) * half;
+        var a: cuda.Args = .{};
+        a.add(y);
+        a.add(p.peer + rx);
+        a.add(picks);
+        p.common(&a, send[0], own);
+        a.add(p.local + counter_at);
+        a.add(p.peer + flag_at);
+        a.add(p.epoch);
+        try cuda.launch.launch(send_fn, .{ .grid = .{ .x = @intCast((send[1] - send[0]) * wt.slots) }, .block = .{ .x = 128 } }, stream, &a);
+        var b: cuda.Args = .{};
+        b.add(y);
+        b.add(p.local + rx);
+        b.add(picks);
+        p.common(&b, merge[0], own);
+        b.add(p.local + flag_at);
+        b.add(p.epoch);
+        try cuda.launch.launch(merge_fn, .{ .grid = .{ .x = @intCast((merge[1] - merge[0]) * wt.slots) }, .block = .{ .x = 128 } }, stream, &b);
+    }
+
+    fn common(p: *const PeerSlots, a: *cuda.Args, row0: usize, own: Owner) void {
+        a.add(@as(i32, @intCast(row0 * wt.slots)));
+        a.add(@as(i32, @intCast(own.first)));
+        a.add(@as(i32, @intCast(own.count)));
+        a.add(@as(i32, @intCast(wt.experts_n)));
+        a.add(@as(i32, @intFromBool(own.split_shared)));
+        a.add(@as(i32, @intCast(p.rank)));
+        a.add(@as(i32, @intCast(quads)));
+    }
+};
+
+/// The experts a rank holds and how the shared slot divides (cuda_mixed_experts.Owned's fields).
+pub const Owner = struct { first: usize, count: usize, split_shared: bool };
+
+/// The send and merge rows of a pass of `n` rows: every row below the split, else the peer's share and this rank's.
+pub fn plan(n: usize, split: bool, rank: usize) struct { send: [2]usize, merge: [2]usize } {
+    if (!split) return .{ .send = .{ 0, n }, .merge = .{ 0, n } };
+    const share = cuda.rank_scatter.share;
+    return .{ .send = share(n, 2, 1 - rank), .merge = share(n, 2, rank) };
+}
+
+test "a split pass sends the peer's rows and merges its own; a short one sends and merges every row" {
+    const a = plan(7, false, 1);
+    try std.testing.expectEqual([2]usize{ 0, 7 }, a.send);
+    try std.testing.expectEqual([2]usize{ 0, 7 }, a.merge);
+    const r0 = plan(7, true, 0);
+    const r1 = plan(7, true, 1);
+    try std.testing.expectEqual(r0.merge, r1.send);
+    try std.testing.expectEqual(r1.merge, r0.send);
+    try std.testing.expectEqual(@as(usize, 7), r0.merge[1] - r0.merge[0] + r1.merge[1] - r1.merge[0]);
+}
