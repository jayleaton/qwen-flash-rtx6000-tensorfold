+/// A late prompt chunk's rows into the MTP head of stream `arg`'s lane in a `Cuda`, as they land at `rows`.
+pub fn absorbLate(comptime Cuda: type) *const fn (*anyopaque, *anyopaque, u64) anyerror!void {
+    return struct {
+        fn run(ctx: *anyopaque, arg: *anyopaque, rows: u64) anyerror!void {
+            const self: *Cuda = @ptrCast(@alignCast(ctx));
+            const d = &((self.lanes.getPtr(@ptrCast(@alignCast(arg))) orelse return error.UnknownLane).draft orelse return error.UnknownLane);
+            const next = d.late_ids;
+            d.late_ids = &.{};
+            try self.ops().forwardHead(d, next, rows, false);
+        }
+    }.run;
+}
