index 000000000..4ee3def62
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_pp_spec.zig
@@ -0,0 +1,181 @@
+//! --pp 2 guesses (TF_FLASHNEXT_PP_SPEC): during rank 1's stage, rank 0 runs its layers on a guess at the next window.
+const std = @import("std");
+const cuda = @import("cuda");
+const lanes = @import("lanes");
+const wt = @import("cuda_prompt_wt.zig");
+const prompt = @import("cuda_prompt.zig");
+const mtp = @import("cuda_mtp.zig");
+const pass = @import("cuda_pp_spec_pass.zig");
+const be = lanes.backend;
+const environment = @import("sys").environment;
+
+/// The draft head's chance that a window keeps every draft and the next starts with the guess, below which none is run.
+pub const default_confidence: f64 = 0.3;
+
+/// TF_FLASHNEXT_PP_SPEC=1 on both ranks of --pp 2 (it joins their identity); off by default.
+pub fn enabled() !bool {
+    return environment.read(bool, "TF_FLASHNEXT_PP_SPEC", false);
+}
+
+/// Where a guess stands: none; run beside the window it follows (open); that window kept whole as guessed (held).
+pub const Phase = enum { none, open, held };
+
+/// Rank 0's guess at a lone greedy stream's next window: its rows, its records and the stream's counts.
+pub const Spec = struct {
+    gpa: std.mem.Allocator,
+    /// The guess's records as a draft lays out its own (`saved`, a spare state per DeltaNet layer) and its rows.
+    layout: mtp.Draft.Layout,
+    saved: cuda.DeviceBuffer,
+    spare: []cuda.DeviceBuffer,
+    stash: cuda.DeviceBuffer,
+    keep: prompt.batch.Keep,
+    confidence: f64,
+    log: bool,
+    phase: Phase = .none,
+    owner: ?*lanes.Stream = null,
+    owner_id: u64 = 0,
+    name: [64]u8 = undefined,
+    name_len: usize = 0,
+    /// The guessed window (its first token, then its drafts), the drafts' head probabilities, and its rows.
+    ids: [mtp.max_rows]u32 = undefined,
+    probs: [mtp.max_chain]f64 = undefined,
+    rows: usize = 0,
+    /// Rows of the window the guess follows, and the n-gram history past the guess.
+    after: usize = 0,
+    history: [2]i64 = .{ 0, 0 },
+    /// A hit's kept tokens, which the head absorbs once the guessed rows are on their way.
+    follow: [mtp.max_rows]u32 = undefined,
+    follow_n: usize = 0,
+    /// The drafts the stream's last request held at most.
+    depth: usize = mtp.default_depth_greedy,
+    attempts: u64 = 0,
+    hits: u64 = 0,
+    misses: u64 = 0,
+    rolled: u64 = 0,
+
+    /// Rank 0's buffers when TF_FLASHNEXT_PP_SPEC is on, else null.
+    pub fn init(gpa: std.mem.Allocator, e: *prompt.Engine, stream: cuda.Stream) !?*Spec {
+        if (!try enabled()) return null;
+        const layout = mtp.Draft.Layout.of(e.heads);
+        const confidence = try environment.read(f64, "TF_FLASHNEXT_PP_SPEC_CONFIDENCE", default_confidence);
+        const log = try environment.read(bool, "TF_FLASHNEXT_PP_SPEC_LOG", false);
+        const sp = try gpa.create(Spec);
+        errdefer gpa.destroy(sp);
+        sp.* = .{ .gpa = gpa, .layout = layout, .saved = undefined, .spare = undefined, .stash = undefined, .keep = .{}, .confidence = confidence, .log = log };
+        sp.saved = try cuda.DeviceBuffer.alloc(e.driver, layout.saved);
+        errdefer sp.saved.free();
+        sp.spare = try e.span.zeros(gpa, e.driver, stream, .linear, layout.state);
+        errdefer {
+            for (sp.spare) |*b| b.free();
+            gpa.free(sp.spare);
+        }
+        sp.stash = try cuda.DeviceBuffer.alloc(e.driver, mtp.max_rows * wt.wide * 2);
+        sp.keep = mtp.Draft.recordsIn(layout, sp.saved.ptr, sp.spare);
+        return sp;
+    }
+
+    pub fn deinit(sp: *Spec) void {
+        sp.stash.free();
+        for (sp.spare) |*b| b.free();
+        sp.gpa.free(sp.spare);
+        sp.saved.free();
+        sp.gpa.destroy(sp);
+    }
+
+    /// Whether `d` is the guessing stream's draft.
+    fn mine(sp: *const Spec, self: anytype, d: *const mtp.Draft) bool {
+        const l = self.lanes.getPtr(sp.owner orelse return false) orelse return false;
+        return if (l.draft) |*x| x == d else false;
+    }
+
+    /// A guess no window takes: undone on rank 0 by bit copies; a held one's kept rows still go into the head.
+    pub fn discard(sp: *Spec, self: anytype) !void {
+        const was = sp.phase;
+        if (was == .none) return;
+        sp.phase = .none;
+        const l = try self.lane(sp.owner.?);
+        try pass.undo(self.engine, sp, &l.seq);
+        sp.misses += 1;
+        sp.rolled += sp.rows;
+        if (was == .held) try pass.catchUp(self, sp, l);
+    }
+
+    /// The lone greedy text stream whose window is its whole held chain, as its own; null when it may not guess.
+    fn eligible(sp: *Spec, self: anytype, q: *prompt.Seq, d: *mtp.Draft, ids: []const u32) ?*lanes.Stream {
+        if (self.lanes.count() != 1 or ids.len < 2 or d.log != null or d.saved.borrowed or q.media != null or d.media != null) return null;
+        if (@import("cuda_batch_state.zig").verifyHostLogits()) return null;
+        var it = self.lanes.iterator();
+        const kv = it.next() orelse return null;
+        const s = kv.key_ptr.*;
+        const l = kv.value_ptr;
+        if (&l.seq != q or s.sampling != null or s.grammar != null or s.logprobs != null or s.images.len != 0) return null;
+        if (!std.meta.eql(s.penalties, lanes.Penalties{})) return null;
+        if (!std.mem.eql(u32, ids[1..], l.chain.slice()) or d.drafted > l.chain.n) return null;
+        if (sp.owner != s) {
+            sp.owner = s;
+            sp.owner_id = q.rank_id;
+            sp.name_len = @min(s.id.len, sp.name.len);
+            @memcpy(sp.name[0..sp.name_len], s.id[0..sp.name_len]);
+        }
+        return s;
+    }
+
+    /// The owner's sequence going away (TF_FLASHNEXT_PP_SPEC_LOG=1: its counts first); its guess needs no undo then.
+    pub fn drop(sp: *Spec, q: *const prompt.Seq) void {
+        if (sp.owner == null or sp.owner_id != q.rank_id) return;
+        if (sp.log) std.debug.print("PP_SPEC stream={s} attempts={d} hits={d} misses={d} rolled_back_rows={d}\n", .{ sp.name[0..sp.name_len], sp.attempts, sp.hits, sp.misses, sp.rolled });
+        sp.phase = .none;
+        sp.owner = null;
+        sp.owner_id = 0;
+        sp.attempts = 0;
+        sp.hits = 0;
+        sp.misses = 0;
+        sp.rolled = 0;
+    }
+};
+
+/// Rank 0's drafted window: the held guess's rows sent when this is the guessed window, else the pass with a guess.
+pub fn verify(comptime Tri: type, self: anytype, q: *prompt.Seq, d: *mtp.Draft, ids: []const u32) !void {
+    const r = self.ranks.?;
+    const sp = self.spec orelse return r.verify(Tri, self.tri(), q, d, ids);
+    if (sp.phase == .held and sp.mine(self, d) and std.mem.eql(u32, ids, sp.ids[0..sp.rows])) return pass.hit(Tri, self, sp, sp.owner.?, q, d);
+    try sp.discard(self);
+    const s = sp.eligible(self, q, d, ids) orelse return r.verify(Tri, self.tri(), q, d, ids);
+    return pass.attempt(Tri, self, sp, s, q, d, ids);
+}
+
+/// A keep of fewer rows than the window a guess follows drops the guess first; a held guess's window keeps whole.
+pub fn rollback(comptime Tri: type, self: anytype, q: *prompt.Seq, d: *mtp.Draft, keep: usize) !void {
+    if (self.spec) |sp| if (sp.phase != .none and keep < d.rows and sp.mine(self, d)) {
+        if (sp.phase == .held) return error.CannotRewind;
+        try sp.discard(self);
+    };
+    return self.ranks.?.keep(Tri, self.tri(), q, d, keep);
+}
+
+/// After `r`'s rollback: a whole window then the guess's first token makes the guess its chain (true); else it drops.
+pub fn drafted(self: anytype, r: be.DraftRequest, l: anytype, count: usize) !bool {
+    const sp = self.spec orelse return false;
+    if (self.lanes.count() == 1) sp.depth = r.depth;
+    if (sp.phase != .open or sp.owner != r.stream) return false;
+    const path = r.rows orelse return error.PositionMismatch;
+    if (path.len != sp.after or r.follow[path.len - 1] != sp.ids[0] or count + 1 < sp.rows) {
+        try sp.discard(self);
+        return false;
+    }
+    sp.phase = .held;
+    sp.follow_n = path.len;
+    @memcpy(sp.follow[0..path.len], r.follow[0..path.len]);
+    l.chain.n = sp.rows - 1;
+    @memcpy(l.chain.tokens[0..l.chain.n], sp.ids[1..sp.rows]);
+    @memcpy(l.chain.probs[0..l.chain.n], sp.probs[0..l.chain.n]);
+    return true;
+}
+
+/// Before a round's verify: a guess its stream's lone window cannot take (other windows beside it) is dropped first.
+pub fn before(self: anytype, wins: []const be.Window) !void {
+    if (!@hasField(@TypeOf(self.*), "spec")) return;
+    const sp = self.spec orelse return;
+    if (sp.phase == .none or (wins.len == 1 and wins[0].stream == sp.owner.?)) return;
+    try sp.discard(self);
+}
diff --git a/zig/src/families/flashnext/cuda_pp_spec_pass.zig b/zig/src/families/flashnext/cuda_pp_spec_pass.zig
new file mode 100644
index 000000000..578a76d5c
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_pp_spec_pass.zig
@@ -0,0 +1,170 @@
+//! Rank 0's device work for a --pp 2 guess: the window split at its send, the guess held, its undo and its promotion.
+const std = @import("std");
+const cuda = @import("cuda");
+const lanes = @import("lanes");
+const wt = @import("cuda_prompt_wt.zig");
+const prompt = @import("cuda_prompt.zig");
+const batch = prompt.batch;
+const mtp = @import("cuda_mtp.zig");
+const hops = @import("cuda_batch_hop.zig");
+const lanes_draft = @import("cuda_lanes_draft.zig");
+const Spec = @import("cuda_pp_spec.zig").Spec;
+
+const tail_bytes = wt.ple_tail_n * wt.wide * 2;
+
+fn copyAsync(st: cuda.Stream, dst: u64, src: u64, n: usize) !void {
+    if (n == 0) return;
+    try st.d.check(st.d.api.cuMemcpyDtoDAsync_v2(dst, src, n, st.handle), "cuMemcpyDtoDAsync");
+}
+
+/// Window `ids` (the stream's whole chain): sent as Session.verify sends it, a guess run while rank 1 runs its stage.
+pub fn attempt(comptime Tri: type, self: anytype, sp: *Spec, s: *lanes.Stream, q: *prompt.Seq, d: *mtp.Draft, ids: []const u32) !void {
+    const r = self.ranks.?;
+    if (!r.drafting or ids.len > mtp.max_rows or q.fed + ids.len > q.cap) return error.UnsupportedRankOperation;
+    for (ids) |t| if (t >= wt.vocab) return error.InvalidToken;
+    const h = try r.command(.{ .kind = .verify, .object = q.rank_id, .bytes = @intCast(ids.len * 4) }, std.mem.sliceAsBytes(ids));
+    errdefer r.poison();
+    var p = try open(Tri, self.engine, self.tri(), q, d, ids);
+    try guess(Tri, self, sp, s, q, d);
+    try hops.rejoin(&p);
+    try r.later(h);
+}
+
+/// The held guess is the window verified: its rows sent at once, its records the draft's, then the next guess.
+pub fn hit(comptime Tri: type, self: anytype, sp: *Spec, s: *lanes.Stream, q: *prompt.Seq, d: *mtp.Draft) !void {
+    const r = self.ranks.?;
+    const e = self.engine;
+    const m = sp.rows;
+    const h = try r.command(.{ .kind = .verify, .object = q.rank_id, .bytes = @intCast(m * 4) }, std.mem.sliceAsBytes(sp.ids[0..m]));
+    errdefer r.poison();
+    const hop = e.hop.?;
+    try hop.give(hop.ctx, sp.stash.ptr, m);
+    var p = try passOf(Tri, e, self.tri(), q, m, .{ .logits = .all, .logits_out = d.logits.ptr, .keep = &d.keep, .streams = d.streams.ptr, .host_logits = false, .stage = .{ .split = true } });
+    p.rows = m;
+    p.pos0 = q.fed;
+    // the window as Ops.verify leaves it: its rows and records, the sequence past it, the end states in the spares
+    d.settle(q);
+    d.fed0 = q.fed;
+    d.rows = m;
+    d.history = q.history;
+    @memcpy(d.ids[0..m], sp.ids[0..m]);
+    d.swapRecords(&sp.saved, sp.spare);
+    sp.keep = mtp.Draft.recordsIn(sp.layout, sp.saved.ptr, sp.spare);
+    q.fed += m;
+    q.history = sp.history;
+    d.open = true;
+    sp.phase = .none;
+    sp.hits += 1;
+    try catchUp(self, sp, try self.lane(s));
+    try guess(Tri, self, sp, s, q, d);
+    try hops.rejoin(&p);
+    try r.later(h);
+}
+
+/// A held guess's window's kept rows into the head (Ops.absorb, deferred past the send); scores when no chain follows.
+pub fn catchUp(self: anytype, sp: *const Spec, l: anytype) !void {
+    const d = &l.draft.?;
+    try self.ops().absorb(d, sp.follow[0..sp.follow_n], d.streams.ptr, l.chain.n == 0);
+}
+
+/// The guess undone on rank 0 with bit copies: each DeltaNet conv window and the n-gram tail as before it ran.
+pub fn undo(e: *prompt.Engine, sp: *const Spec, q: *prompt.Seq) !void {
+    const st = e.stream.*;
+    for (e.own(), e.span.first..) |*lw, layer| if (lw.linear) try copyAsync(st, q.conv[wt.linearIndex(layer)].ptr, sp.keep.layers[layer].hist, sp.layout.conv);
+    try copyAsync(st, q.tail.ptr, sp.saved.ptr + sp.layout.tail_at, tail_bytes);
+}
+
+/// Ops.verify's window on rank 0 up to its send: the records a rollback reads, then the pass split before its receive.
+fn open(comptime Tri: type, e: *prompt.Engine, tri: Tri, q: *prompt.Seq, d: *mtp.Draft, ids: []const u32) !batch.Pass(Tri) {
+    const n = ids.len;
+    if (!d.layout.heads.eql(q.heads)) return error.DraftHeads;
+    d.settle(q);
+    d.fed0 = q.fed;
+    d.rows = n;
+    d.history = q.history;
+    @memcpy(d.ids[0..n], ids);
+    const st = e.stream.*;
+    try copyAsync(st, d.saved.ptr + d.layout.tail_at, q.tail.ptr, tail_bytes);
+    const hooks: batch.Hooks = .{ .logits = .all, .logits_out = d.logits.ptr, .keep = &d.keep, .streams = d.streams.ptr, .host_logits = false, .stage = .{ .split = true } };
+    var p = try passOf(Tri, e, tri, q, n, hooks);
+    if (!try @import("cuda_prompt_windows.zig").forwardGraph(e, Tri, &p, q, ids, hooks)) {
+        try p.chunk(ids, q.fed, null);
+        q.fed += n;
+    }
+    // a replayed graph sets none of the pass's host fields: the head reads its rows, written back with none pending
+    p.rows = n;
+    p.pos0 = d.fed0;
+    p.pending = null;
+    p.pending_f32 = false;
+    try copyAsync(st, d.saved.ptr + d.layout.nrow_at, e.batch_s.?.ple_nrow, n * wt.wide * 2);
+    d.open = true;
+    return p;
+}
+
+/// A pass over `rows` rows of `q` from q.fed with `hooks`, on the engine's scratch as Engine.forward builds it.
+fn passOf(comptime Tri: type, e: *prompt.Engine, tri: Tri, q: *prompt.Seq, rows: usize, hooks: batch.Hooks) !batch.Pass(Tri) {
+    if (rows == 0 or rows > e.chunk or q.fed + rows > q.cap) return error.UnexpectedTensor;
+    const s = try e.reserve(rows);
+    const scores = try e.reserveScores(q.cap, s.cap);
+    return .{ .gpa = e.gpa, .io = e.io, .stream = e.stream.*, .tri = tri, .k = &e.batch_k, .s = s, .m = if (q.untaught) e.shipped() else e.model(), .seq = q.view(scores), .hooks = hooks };
+}
+
+/// The next window guessed past `q`'s (every draft kept, the head's chain on), held if its chance clears the cut.
+fn guess(comptime Tri: type, self: anytype, sp: *Spec, s: *lanes.Stream, q: *prompt.Seq, d: *mtp.Draft) !void {
+    if (self.lanes.count() != 1) return;
+    const l = try self.lane(s);
+    const o = self.ops();
+    const rule = lanes_draft.rule(self, 1);
+    const depth = @min(@min(sp.depth, rule.greedy), mtp.max_chain);
+    // the guess's rows in the caches, the head through the chain and the guess in its own
+    if (d.drafted > l.chain.n or q.fed + 1 + depth > q.cap or d.len + (l.chain.n - d.drafted) + depth + 1 > d.cap) return;
+    // the window's rows sent: the head's picks below wait on the host for the stream's work alone
+    try self.engine.complete();
+    var chance: f64 = 1;
+    for (l.chain.probs[0..l.chain.n]) |p| chance *= p;
+    const from = d.drafted;
+    for (l.chain.tokens[from..l.chain.n], from..) |t, i| {
+        try o.forwardHead(d, &.{t}, d.out.ptr, i + 1 == l.chain.n);
+        d.drafted += 1;
+    }
+    const first = try o.pick(d, q.fed + 1, null);
+    chance *= first.prob;
+    if (chance < sp.confidence) return;
+    sp.ids[0] = first.token;
+    var n: usize = 1;
+    var stop: mtp.Stop = .{ .c = lanes_draft.stopFor(self, rule, null) };
+    var prev = first.token;
+    var j: usize = 0;
+    while (j < depth) : (j += 1) {
+        try o.forwardHead(d, &.{prev}, d.out.ptr, true);
+        d.drafted += 1;
+        const got = try o.pick(d, q.fed + 2 + j, null);
+        const t = stop.take(j, got.prob);
+        if (!t.propose) break;
+        sp.ids[n] = got.token;
+        sp.probs[j] = got.prob;
+        n += 1;
+        if (!t.more) break;
+        prev = got.token;
+    }
+    // a lone row would verify without records (Ops.verify keeps none for it): no guess
+    if (n < 2) return;
+    sp.rows = n;
+    sp.after = d.rows;
+    try held(Tri, self.engine, self.tri(), sp, q, d, sp.ids[0..n]);
+    sp.phase = .open;
+    sp.attempts += 1;
+}
+
+/// The guess `g` on rank 0's layers from the open window's end states, eagerly: rows into the stash, records its own.
+fn held(comptime Tri: type, e: *prompt.Engine, tri: Tri, sp: *Spec, q: *prompt.Seq, d: *mtp.Draft, g: []const u32) !void {
+    const st = e.stream.*;
+    sp.history = q.history;
+    try copyAsync(st, sp.saved.ptr + sp.layout.tail_at, q.tail.ptr, tail_bytes);
+    var p = try passOf(Tri, e, tri, q, g.len, .{ .logits = .all, .keep = &sp.keep, .host_logits = false, .stage = .{ .hold = sp.stash.ptr } });
+    // the open window's end states in, the guess's to its own spares; its n-gram history its own
+    p.seq.state = &d.spare;
+    p.seq.history = &sp.history;
+    try p.chunk(g, q.fed, null);
+    try copyAsync(st, sp.saved.ptr + sp.layout.nrow_at, e.batch_s.?.ple_nrow, g.len * wt.wide * 2);
+}
