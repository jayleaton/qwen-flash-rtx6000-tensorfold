+/// run over TF_FLASHNEXT_PEER_SLOTS' mapped buffer for a pass of up to its rows: the peer's partial added, no NCCL.
+pub fn runPeer(pass: anytype, p: anytype, n: usize, rank: usize) !void {
+    try moe.sumPart(pass, 0, n, @intCast(rank));
+    try p.sumRows(pass.k.peer_rows_send, pass.k.peer_rows_add, pass.stream, pass.s.moe_f32, n);
+    pass.pending_f32 = true;
+}
