diff --git a/zig/kernels/cuda/flashnext_peer.cuh b/zig/kernels/cuda/flashnext_peer.cuh
index bd6472198..c00798dbd 100644
--- a/zig/kernels/cuda/flashnext_peer.cuh
+++ b/zig/kernels/cuda/flashnext_peer.cuh
@@ -66,3 +66,38 @@ extern "C" __global__ void __launch_bounds__(128) fn_peer_merge(float4* __restri
         y[base + c] = fn_peer_plus0(mine ? y[base + c] : rx[base + c]);
