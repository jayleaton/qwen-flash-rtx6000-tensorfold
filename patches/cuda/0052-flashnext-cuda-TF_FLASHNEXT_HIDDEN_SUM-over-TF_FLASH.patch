 }
+
+// Rows r0.. (one block each) of this rank's FP32 hidden partials into the peer's rx; the last block raises its flag.
+extern "C" __global__ void __launch_bounds__(128) fn_peer_rows_send(const float4* __restrict__ src, float4* __restrict__ rx,
+                                                                    int q, unsigned* __restrict__ counter,
+                                                                    volatile unsigned* __restrict__ flag, unsigned epoch) {
+    const long long base = static_cast<long long>(blockIdx.x) * q;
+    for (int c = threadIdx.x; c < q; c += blockDim.x) rx[base + c] = src[base + c];
+    __syncthreads();
+    if (threadIdx.x == 0) {
+        __threadfence_system();
+        if (atomicAdd(counter, 1u) + 1u == gridDim.x) {
+            *counter = 0u;
+            __threadfence_system();
+            *flag = epoch;
+        }
+    }
+}
+
+// Rows (one block each), once the peer's flag reaches `epoch`: own partial plus the peer's, the all-reduce's sum.
+extern "C" __global__ void __launch_bounds__(128) fn_peer_rows_add(float4* __restrict__ dst, const float4* rx, int q,
+                                                                   volatile unsigned* __restrict__ flag, unsigned epoch) {
+    if (threadIdx.x == 0) {
+        const long long start = clock64();
+        while (static_cast<int>(*flag - epoch) < 0)
+            if (clock64() - start > (1ll << 35)) __trap();  // about 15 s: the peer is gone, fail rather than hang
+        __threadfence();
+    }
+    __syncthreads();
+    const long long base = static_cast<long long>(blockIdx.x) * q;
+    for (int c = threadIdx.x; c < q; c += blockDim.x) {
+        const float4 a = dst[base + c];
+        const float4 b = rx[base + c];
+        dst[base + c] = make_float4(a.x + b.x, a.y + b.y, a.z + b.z, a.w + b.w);
+    }
+}
