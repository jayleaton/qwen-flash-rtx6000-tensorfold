+    /// `n` rows of FP32 hidden partials in `buf` to the peer, then the peer's added in: the all-reduce's sums.
+    pub fn sumRows(p: *PeerSlots, send_fn: cuda.Function, add_fn: cuda.Function, stream: cuda.Stream, buf: u64, n: usize) !void {
+        if (n == 0 or n > rows) return error.UnexpectedTensor;
+        p.epoch +%= 1;
+        const rx = (p.epoch & 1) * half;
+        const grid: cuda.launch.Config = .{ .grid = .{ .x = @intCast(n) }, .block = .{ .x = 128 } };
+        var a: cuda.Args = .{};
+        a.add(buf);
+        a.add(p.peer + rx);
+        a.add(@as(i32, @intCast(quads)));
+        a.add(p.local + counter_at);
+        a.add(p.peer + flag_at);
+        a.add(p.epoch);
+        try cuda.launch.launch(send_fn, grid, stream, &a);
+        var b: cuda.Args = .{};
+        b.add(buf);
+        b.add(p.local + rx);
+        b.add(@as(i32, @intCast(quads)));
+        b.add(p.local + flag_at);
+        b.add(p.epoch);
+        try cuda.launch.launch(add_fn, grid, stream, &b);
+    }
+
     fn common(p: *const PeerSlots, a: *cuda.Args, row0: usize, own: Owner) void {
         a.add(@as(i32, @intCast(row0 * wt.slots)));
         a.add(@as(i32, @intCast(own.first)));
