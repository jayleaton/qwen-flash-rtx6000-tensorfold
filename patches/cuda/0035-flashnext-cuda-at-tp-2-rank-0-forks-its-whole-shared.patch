diff --git a/zig/src/families/flashnext/cuda_batch_side.zig b/zig/src/families/flashnext/cuda_batch_side.zig
index 282557604..0cc02a05e 100644
--- a/zig/src/families/flashnext/cuda_batch_side.zig
+++ b/zig/src/families/flashnext/cuda_batch_side.zig
@@ -55,10 +55,10 @@ pub fn down(pass: anytype, st: cuda.Stream, input: u64, native: anytype, n: usiz
     try glue.sharedScatter(st, s.shared_out, s.y, n, dims, slots);
 }
 
-/// After y is cleared: the shared expert forked onto the side stream (one GPU, not a prompt fill), or null.
+/// After y is cleared: the whole shared expert forked onto rank 0's side stream (not a prompt fill), or null.
 pub fn fork(pass: anytype, native: anytype, n: usize) !?Side {
     const x = pass.s.side orelse return null;
-    if (native.rank != 0 or native.world != 1 or pass.hooks.prompt) return null;
+    if (native.rank != 0 or native.split_shared or pass.hooks.prompt) return null;
     try x.fork.record(pass.stream);
     try x.stream.wait(x.fork);
     try run(pass, x.stream, native, n);
