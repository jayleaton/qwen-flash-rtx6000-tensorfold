+//! Freed pinned host buffers, kept whole for the next kept state or disk recall of the same size.
+const HostBuffer = @import("memory.zig").HostBuffer;
+const Driver = @import("driver.zig").Driver;
+
+/// Freed pinned buffers, oldest first; one comes back only once no copy into or out of it can still be queued.
+pub const HostSpares = struct {
+    bufs: [cap]HostBuffer = undefined,
+    n: usize = 0,
+    /// Buffers mapped into the device's address space (HostBuffer.allocMapped), which device copies reach directly.
+    mapped: bool = false,
+
+    /// The most buffers kept; the prompt cache's budget trims them further (`trim`).
+    pub const cap = 2;
+
+    /// The newest spare of exactly `len` bytes.
+    fn find(s: *const HostSpares, len: usize) ?usize {
+        var i = s.n;
+        while (i > 0) {
+            i -= 1;
+            if (s.bufs[i].bytes.len == len) return i;
+        }
+        return null;
+    }
+
+    fn remove(s: *HostSpares, i: usize) HostBuffer {
+        const host = s.bufs[i];
+        for (i..s.n - 1) |j| s.bufs[j] = s.bufs[j + 1];
+        s.n -= 1;
+        return host;
+    }
+
+    /// Whether a spare of exactly `len` bytes waits.
+    pub fn fits(s: *const HostSpares, len: usize) bool {
+        return s.find(len) != null;
+    }
+
+    /// A buffer of `len` bytes: a spare of that size, else newly pinned memory.
+    pub fn take(s: *HostSpares, d: *const Driver, len: usize) !HostBuffer {
+        const i = s.find(len) orelse return if (s.mapped) HostBuffer.allocMapped(d, len) else HostBuffer.alloc(d, len);
+        return s.remove(i);
+    }
+
+    /// A drained buffer back (no copy queued into or out of it); a full list frees its oldest.
+    pub fn give(s: *HostSpares, host: HostBuffer) void {
+        if (s.n == cap) {
+            var old = s.remove(0);
+            old.free();
+        }
+        s.bufs[s.n] = host;
+        s.n += 1;
+    }
+
+    /// The spares' bytes.
+    pub fn bytes(s: *const HostSpares) u64 {
+        var n: u64 = 0;
+        for (s.bufs[0..s.n]) |b| n += b.bytes.len;
+        return n;
+    }
+
+    /// Spares freed, the largest first, until at most `room` bytes stay.
+    pub fn trim(s: *HostSpares, room: u64) void {
+        while (s.bytes() > room) {
+            var big: usize = 0;
+            for (s.bufs[1..s.n], 1..) |b, i| if (b.bytes.len > s.bufs[big].bytes.len) {
+                big = i;
+            };
+            var old = s.remove(big);
+            old.free();
+        }
+    }
+
+    /// Every spare freed: with the engine, after the prompt cache dropped its states.
+    pub fn deinit(s: *HostSpares) void {
+        s.trim(0);
+    }
+};
