+/// fn_row_best's pick from two fn_row_best_part rows: larger best, ties to the lower column, lse NaN as the row's.
+pub fn mergeParts(a: [4]f32, b: [4]f32) [4]f32 {
+    const ca: i32 = @bitCast(a[2]);
+    const cb: i32 = @bitCast(b[2]);
+    const second = b[0] > a[0] or (b[0] == a[0] and cb < ca);
+    const top = if (second) b[0] else a[0];
+    const ok = a[1] == 0 and b[1] == 0 and std.math.isFinite(top);
+    return .{ top, if (ok) top else std.math.nan(f32), @bitCast(if (second) cb else ca), 0 };
+}
+
+fn testPart(row: []const u16, base: i32) [4]f32 {
+    var top = -std.math.inf(f32);
+    var at: i32 = std.math.maxInt(i32);
+    var bad = false;
+    for (row, 0..) |u, i| {
+        const x: f32 = @bitCast(@as(u32, u) << 16);
+        if (x > top) {
+            top = x;
+            at = @intCast(i);
+        }
+        if (u & 0x7fff > 0x7f80 or u == 0x7f80) bad = true;
+    }
+    return .{ top, if (bad) 1 else 0, @bitCast(if (at == std.math.maxInt(i32)) at else at + base), 0 };
+}
+
+test "split head rows merge to fn_row_best's pick: ties to the lower column, a NaN or +Inf anywhere refused" {
+    const picks = [_]u16{ 0x3f80, 0xbf80, 0x0000, 0x8000, 0x7fc0, 0xffc0, 0x7f80, 0xff80, 0x4000, 0x4000 };
+    var prng = std.Random.DefaultPrng.init(7);
+    const r = prng.random();
+    const v: Scores = .{ .vocab = 12, .logical = 12, .stride = 12 };
+    for (0..20000) |_| {
+        var row: [12]u16 = undefined;
+        for (&row) |*u| u.* = if (r.boolean()) picks[r.uintLessThan(usize, picks.len)] else 0xff80;
+        const whole = testPart(&row, 0);
+        var sum: f32 = 0;
+        for (row) |u| sum += @exp(@as(f32, @bitCast(@as(u32, u) << 16)) - whole[0]);
+        const want = v.pickBest(.{ whole[0], whole[0] + @log(sum), whole[2], 0 });
+        const got_row = mergeParts(testPart(row[0..6], 0), testPart(row[6..], 6));
+        const got = v.pickBest(got_row);
+        if (want) |t| {
+            try std.testing.expectEqual(t, try got);
+            try std.testing.expectEqual(@as(u32, @bitCast(whole[0])), @as(u32, @bitCast(got_row[0])));
+        } else |_| try std.testing.expectError(error.ProposalNonfinite, got);
+    }
+}
