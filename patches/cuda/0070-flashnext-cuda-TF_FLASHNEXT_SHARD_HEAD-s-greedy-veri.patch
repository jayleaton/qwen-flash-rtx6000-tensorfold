@@ -0,0 +1,56 @@
+//! TF_FLASHNEXT_SHARD_HEAD's greedy verify: each rank's half-vocabulary best rows, one gather, rank 0's host merge.
+const std = @import("std");
+const cuda = @import("cuda");
+const mtp = @import("cuda_mtp.zig");
+const vocab = @import("cuda_prompt_wt.zig").vocab;
+const rows_ = @import("core").proposal_rows;
+const full: rows_.Scores = .{ .vocab = vocab, .logical = vocab, .stride = vocab };
+
+/// A verify's gathered part rows: [2, total, 4] fp32 at ptr (rank 0's block, then rank 1's), its window's from row0.
+pub const Rows = struct { ptr: u64, total: usize, row0: usize };
+
+/// Whether the engine's verify can take the split head: --tp 2, each rank's half of the head, fn_row_best_part loaded.
+pub fn capable(e: anytype) bool {
+    return e.collective != null and e.head_q.n == vocab / 2 and e.batch_k.head_part != null;
+}
+
+/// Rank 0's choice for a pass of greedy unmasked windows; rank 1 follows the frame's flag.
+pub fn wanted(e: anytype) bool {
+    return capable(e) and !@import("cuda_batch_state.zig").verifyHostLogits();
+}
+
+/// The pass's head: this rank's half of every row's scores, its part rows at its block of `out`, then the gather.
+pub fn project(p: anytype, out: u64, n: usize) !void {
+    const s = p.s;
+    const c = p.m.collective orelse return error.TensorParallelUnavailable;
+    const f = p.k.head_part orelse return error.TensorParallelUnavailable;
+    if (p.m.head.n != vocab / 2 or n == 0 or n > s.cap or n > s.head_rows) return error.UnexpectedTensor;
+    _ = try p.lane(s.mixed, s.xsm, p.m.head, s.head_local, s.dummy, n, 1);
+    const mine = out + c.rank * n * 16;
+    var a: cuda.Args = .{};
+    a.add(s.head_local);
+    a.add(@as(c_int, vocab / 2));
+    a.add(@as(c_longlong, vocab / 2));
+    a.add(@as(c_int, @intCast(c.rank * (vocab / 2))));
+    a.add(mine);
+    try cuda.launch.launch(f, .{ .grid = .{ .x = @intCast(n) }, .block = .{ .x = 1024 } }, p.stream, &a);
+    try c.gatherF32(p.stream, mine, out, n * 4);
+}
+
+/// A split verify's draws: both ranks' part rows merged into best_host, then pickBest as the whole row's draws do.
+pub fn draws(st: cuda.Stream, d: *mtp.Draft, at: Rows, sm: ?mtp.Sampling, masks: []const u32, out: []u32) !void {
+    d.head_best = null;
+    if (mtp.isSampled(sm) or masks.len != 0) return error.UnexpectedTensor;
+    const n = d.rows;
+    if (n == 0 or n > mtp.max_rows or at.row0 + n > at.total or out.len < n) return error.UnexpectedTensor;
+    var parts: [2 * mtp.max_rows * 4]f32 = undefined;
+    try st.synchronize();
+    for (0..2) |k| try cuda.memory.download(st.d, at.ptr + (k * at.total + at.row0) * 16, std.mem.sliceAsBytes(parts[k * n * 4 ..][0 .. n * 4]));
+    for (0..n) |r| d.best_host[r * 4 ..][0..4].* = rows_.mergeParts(parts[r * 4 ..][0..4].*, parts[(n + r) * 4 ..][0..4].*);
+    var pending: [mtp.max_rows]u32 = undefined;
+    for (pending[0..n], 0..) |*t, r| t.* = full.pickBest(d.best_host[r * 4 ..][0..4].*) catch |err| {
+        @import("cuda_mtp_draw.zig").badVerify(d, r, d.best_host[r * 4 ..][0..4].*, null, false);
+        return err;
+    };
+    @memcpy(out[0..n], pending[0..n]);
+}
