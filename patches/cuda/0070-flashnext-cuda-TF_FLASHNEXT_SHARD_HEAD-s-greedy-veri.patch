diff --git a/zig/kernels/cuda/flashnext_mtp.cu b/zig/kernels/cuda/flashnext_mtp.cu
index 010e1b453..73c177113 100644
--- a/zig/kernels/cuda/flashnext_mtp.cu
+++ b/zig/kernels/cuda/flashnext_mtp.cu
@@ -224,3 +224,42 @@ extern "C" __global__ void __launch_bounds__(1024) fn_row_topk(const __nv_bfloat
     __syncthreads();
     if (t == 0 && row_bad) oc[0] = -1;
 }
+
+// A split head's rank part, fn_row_best's scan and folds: out [rows, 4] = best, any NaN or +inf (1) or 0, id + base, 0.
+extern "C" __global__ void __launch_bounds__(1024) fn_row_best_part(const __nv_bfloat16* __restrict__ L, int V,
+                                                                    long long ld, int base, float* __restrict__ out) {
+    using namespace fn_mtp;
+    const int r = blockIdx.x, t = threadIdx.x, lane = t & 31, warp = t >> 5;
+    const __nv_bfloat16* row = L + static_cast<long long>(r) * ld;
+    float v = -CUDART_INF_F;
+    int at = 0x7fffffff;
+    int bad = 0;
+    for (int i = t; i < V; i += blockDim.x) {
+        const unsigned short u = __bfloat16_as_ushort(row[i]);
+        const float x = __bfloat162float(row[i]);
+        if (x > v) {
+            v = x;
+            at = i;
+        }
+        if ((u & 0x7fffu) > 0x7f80u || u == 0x7f80u) bad = 1;
+    }
+    for (int o = 16; o; o >>= 1) better(v, at, __shfl_xor_sync(0xffffffffu, v, o), __shfl_xor_sync(0xffffffffu, at, o));
+    __shared__ float sv[32];
+    __shared__ int si[32];
+    if (lane == 0) {
+        sv[warp] = v;
+        si[warp] = at;
+    }
+    bad = __syncthreads_or(bad);
+    if (warp == 0) {
+        v = lane < (int)(blockDim.x >> 5) ? sv[lane] : -CUDART_INF_F;
+        at = lane < (int)(blockDim.x >> 5) ? si[lane] : 0x7fffffff;
+        for (int o = 16; o; o >>= 1) better(v, at, __shfl_xor_sync(0xffffffffu, v, o), __shfl_xor_sync(0xffffffffu, at, o));
+        if (lane == 0) {
+            out[r * 4 + 0] = v;
+            out[r * 4 + 1] = bad ? 1.0f : 0.0f;
+            out[r * 4 + 2] = __int_as_float(at == 0x7fffffff ? at : at + base);
+            out[r * 4 + 3] = 0.0f;
+        }
+    }
+}
