@@ -41,7 +45,14 @@ pub fn windows(self: anytype, wins: []const be.Window, out: []be.Verified, draft
                 outputs[i] = out[wi].sampled[0..wins[wi].rows()];
             }
             try self.ops().drawsMany(self.logits.ptr, ds[0..n], sms[0..n], masks[0..n], outputs[0..n]);
-        } else for (drafted[at..][0..n], ds[0..n]) |wi, d| try self.ops().draws(d, wins[wi].stream.sampling, wins[wi].masks, out[wi].sampled[0..wins[wi].rows()]);
+        } else for (drafted[at..][0..n], ds[0..n]) |wi, d| {
+            const got = out[wi].sampled[0..wins[wi].rows()];
+            if (comptime @hasField(@TypeOf(self.*), "engine")) if (d.head_best) |rows_at| {
+                try @import("cuda_head_best.zig").draws(self.engine.stream.*, d, rows_at, wins[wi].stream.sampling, wins[wi].masks, got);
+                continue;
+            };
+            try self.ops().draws(d, wins[wi].stream.sampling, wins[wi].masks, got);
+        }
         at += n;
     }
 }
