+/// Whether a pass on heads h splits each head's state rows over blocks: when every block has an SM of its own.
+pub fn splitOn(sms: u32, h: Heads) bool {
+    return sms >= h.nv * (gdn.dv / split_rows);
+}
+
+/// The unfused rows the split form passes through memory: fn_gdn_front's outputs and the chain's readouts.
+pub const Rows = struct { q: u64, k: u64, v: u64, gb: u64, ys: u64 };
+
+/// The split form of `launch`: fn_gdn_front, fn_gdn_chain_split (marks included) and fn_gdn_norm, launch's bits.
+pub fn split(g: *const Gdn, stream: cuda.Stream, in: In, rows: usize, r: Rows, out: u64, xs: u64) !void {
+    const h = in.heads;
+    var f: cuda.Args = .{};
+    for ([_]u64{ in.proj, in.conv, in.cw, in.a_log, in.dt, r.q, r.k, r.v, r.gb }) |v| f.add(v);
+    try cuda.launch.launch(g.front, .{ .grid = .{ .x = @intCast(rows), .y = h.nk + h.nv }, .block = .{ .x = 256 } }, stream, &f);
+    var a: cuda.Args = .{};
+    for ([_]u64{ r.q, r.k, r.v, r.gb, in.state, in.state_out }) |v| a.add(v);
+    a.add(@as(c_int, @intCast(rows)));
+    a.add(r.ys);
+    // the marks run with whole heads only: a rank's half set (fn_gdn_chain_split_h8) takes none
+    std.debug.assert(h.nv == gdn.nv or (in.cuts[0].row == 0 and in.cuts[1].row == 0));
+    if (h.nv == gdn.nv) for (in.cuts) |c| {
+        a.add(@as(c_int, @intCast(c.row)));
+        a.add(c.state);
+    };
+    const grid: cuda.launch.Dim3 = .{ .x = h.nv, .y = @as(u32, @intCast(gdn.dv)) / split_rows };
+    try cuda.launch.launch(g.split, .{ .grid = grid, .block = .{ .x = split_threads }, .shared = split_smem }, stream, &a);
+    try norm(g.norm, stream, r.ys, in.proj, in.norm, out, xs, rows, h);
+}
+
+test "the split chain runs where each of its blocks has an SM: a GB10's rank halves, every head set on 188 SMs" {
+    try std.testing.expect(!splitOn(48, .full));
+    try std.testing.expect(splitOn(48, .half));
+    try std.testing.expect(splitOn(96, .full));
+    try std.testing.expect(splitOn(188, .full) and splitOn(188, .half));
+    try std.testing.expect(!splitOn(40, .half));
+}
