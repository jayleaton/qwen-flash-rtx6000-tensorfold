diff --git a/zig/tests/cuda/contract_flashnext_split.zig b/zig/tests/cuda/contract_flashnext_split.zig
new file mode 100644
index 000000000..57098a591
--- /dev/null
+++ b/zig/tests/cuda/contract_flashnext_split.zig
@@ -0,0 +1,273 @@
+//! Flash Next's split prompt chain: fn_gdn_chain_split's readouts, state and marks' states equal fn_gdn_chain_tpr's.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const rig_ = @import("contract_rig.zig");
+
+const c = core.contract.spec;
+const g = core.contract.gates;
+const parts = flash.batch_state;
+const split = flash.gdn_fused;
+const Heads = flash.Heads;
+const dk = 128;
+const dv = 128;
+const slice = split.split_rows * dk; // the state floats one block holds
+
+/// The whole layer's split chain, a rank's twin, and two planted controls on the whole layer's kernel.
+pub const Kind = enum {
+    full,
+    half,
+    /// The split launched one slice short: each head's last state rows are never stepped.
+    short,
+    /// The split reading its neighbour slice's state: state_in moved one slice on.
+    neighbour,
+
+    fn heads(k: Kind) Heads {
+        return if (k == .half) .half else .full;
+    }
+};
+
+fn noSums(_: c.Shape) usize {
+    return 0;
+}
+
+/// The fused dispatch seam, the default chunk and the most a chunk may ask for, on the heads `h`.
+fn served(comptime h: Heads) [3]c.Shape {
+    return .{
+        .{ .rows = 64, .n = h.nv * dv, .k = dk },
+        .{ .rows = parts.default_chunk, .n = h.nv * dv, .k = dk },
+        .{ .rows = parts.max_chunk, .n = h.nv * dv, .k = dk },
+    };
+}
+const full_served = served(.full);
+const half_served = served(.half);
+
+pub fn spec(kind: Kind) c.Spec {
+    const name = switch (kind) {
+        .full => "cuda flashnext DeltaNet prompt chain fn_gdn_chain_split (each value head over 2 blocks)",
+        .half => "cuda flashnext DeltaNet prompt chain fn_gdn_chain_split_h8 on a rank's 24 value heads",
+        .short => "control: fn_gdn_chain_split launched one slice short",
+        .neighbour => "control: fn_gdn_chain_split reading the neighbour slice's state",
+    };
+    const stated = "ys, the state and on even row counts two cache marks' states bit-equal to fn_gdn_chain_tpr's, non-finite inputs included";
+    return .{ .name = name, .accum = .none, .depth = noSums, .out = .raw, .nan = .{ .stated = stated }, .replaces = if (kind == .half) "fn_gdn_chain_tpr_h8" else "fn_gdn_chain_tpr", .tiles = .{ .{ .size = 16 }, .{}, .{} }, .served = if (kind == .half) &half_served else &full_served };
+}
+
+/// Two cache marks on an even row count (after its middle and last rows); an odd count runs without marks (0: none).
+fn cutRows(rows: usize) [2]usize {
+    return if (rows % 2 == 0) .{ rows / 2, rows } else .{ 0, 0 };
+}
+
+pub const Fns = struct { split: cuda.Function, split_h8: cuda.Function, tpr: cuda.Function, tpr_h8: cuda.Function };
+
+pub fn load(batch: cuda.Module) !Fns {
+    const f: Fns = .{
+        .split = try batch.function("fn_gdn_chain_split"),
+        .split_h8 = try batch.function("fn_gdn_chain_split_h8"),
+        .tpr = try batch.function("fn_gdn_chain_tpr"),
+        .tpr_h8 = try batch.function("fn_gdn_chain_tpr_h8"),
+    };
+    try f.split.allowDynamicShared(split.split_smem);
+    try f.split_h8.allowDynamicShared(split.split_smem);
+    try f.tpr.allowDynamicShared(parts.chain_tpr_smem);
+    try f.tpr_h8.allowDynamicShared(parts.chain_tpr_smem);
+    return f;
+}
+
+pub const Split = struct {
+    rig: rig_.Rig,
+    kind: Kind,
+    f: *const Fns,
+    rows: usize = 0,
+    /// qn, kn, v, gb and the state; the neighbour control's state holds one more slice past the last head.
+    ins: [5]u64 = @splat(0),
+    outs: [4]u64 = @splat(0),
+    lens: [4]usize = @splat(0),
+    nout: usize = 0,
+    base: u64 = 0,
+    ys: u64 = 0,
+    seen: std.ArrayList(u8) = .empty,
+    msg: [160]u8 = undefined,
+
+    pub fn deinit(self: *Split) void {
+        self.seen.deinit(self.rig.gpu.gpa);
+        self.rig.deinit();
+    }
+
+    pub fn kernel(self: *Split) g.Kernel {
+        const control: ?g.Gate = switch (self.kind) {
+            .short, .neighbour => .shapes,
+            else => null,
+        };
+        return .{ .spec = spec(self.kind), .ctx = self, .vt = &vt, .control = control };
+    }
+
+    const vt = g.hooks(Split);
+
+    fn f32s(self: *Split, n: usize, r: std.Random, lo: f32, hi: f32) ![]f32 {
+        const v = try self.rig.gpu.gpa.alloc(f32, n);
+        for (v) |*x| x.* = lo + r.float(f32) * (hi - lo);
+        return v;
+    }
+
+    pub fn prepare(self: *Split, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        self.rig.reset();
+        self.nout = 0;
+        self.rows = shape.rows;
+        const h = self.kind.heads();
+        if (shape.rows == 0 or shape.n != h.nv * dv or shape.k != dk) return false;
+        var prng = std.Random.DefaultPrng.init(seed ^ 0x73706c6974);
+        const r = prng.random();
+        const a = self.rig.gpu.gpa;
+        const m = shape.rows;
+        const qn = try self.f32s(m * h.nk * dk, r, -0.1, 0.1);
+        defer a.free(qn);
+        const kn = try self.f32s(m * h.nk * dk, r, -0.1, 0.1);
+        defer a.free(kn);
+        const v = try self.f32s(m * h.nv * dv, r, -1, 1);
+        defer a.free(v);
+        const gb = try self.f32s(m * h.nv * 2, r, 0, 1);
+        defer a.free(gb);
+        for (0..m * h.nv) |i| gb[2 * i] = -gb[2 * i]; // a log decay, then beta in (0, 1)
+        const st = try self.f32s(h.nv * dv * dk + slice, r, -0.5, 0.5);
+        defer a.free(st);
+        if (fill == .nonfinite) {
+            qn[3] = std.math.nan(f32);
+            v[(m / 2) * h.nv * dv + 5] = std.math.inf(f32);
+            v[(m - 1) * h.nv * dv + dv - 1] = -std.math.inf(f32); // a head's last state row: its last slice
+            st[dv * dk + 7] = -std.math.inf(f32);
+        }
+        for ([_][]const f32{ qn, kn, v, gb }, 0..) |x, i| self.ins[i] = try self.rig.input(std.mem.sliceAsBytes(x));
+        self.ins[4] = try self.rig.input(std.mem.sliceAsBytes(st[0 .. h.nv * dv * dk + if (self.kind == .neighbour) slice else 0]));
+        for ([_]usize{ m * h.nv * dv * 4, h.nv * dv * dk * 4 }) |len| try self.out(len);
+        if (cutRows(m)[0] != 0 and h.nv == Heads.full.nv) for (0..2) |_| try self.out(h.nv * dv * dk * 4);
+        var total: usize = 0;
+        for (self.lens[0..self.nout]) |l| total += l;
+        self.base = try self.rig.scratch(total);
+        self.ys = try self.rig.scratch(m * h.nv * dv * 4);
+        return true;
+    }
+
+    fn out(self: *Split, len: usize) !void {
+        self.outs[self.nout] = try self.rig.output(len);
+        self.lens[self.nout] = len;
+        self.nout += 1;
+    }
+
+    /// The split as the pass launches it (each control with its planted fault), into `o`.
+    fn ours(self: *Split, o: []const u64) !void {
+        const h = self.kind.heads();
+        var a: cuda.Args = .{};
+        const moved: u64 = if (self.kind == .neighbour) slice * 4 else 0;
+        for ([_]u64{ self.ins[0], self.ins[1], self.ins[2], self.ins[3], self.ins[4] + moved, o[1] }) |x| a.add(x);
+        a.add(@as(c_int, @intCast(self.rows)));
+        a.add(o[0]);
+        if (self.kind != .half) for (cutRows(self.rows), 0..) |at, i| {
+            a.add(@as(c_int, @intCast(at)));
+            a.add(if (at == 0) 0 else o[2 + i]);
+        };
+        const slices: u32 = dv / split.split_rows - @intFromBool(self.kind == .short);
+        const f = if (self.kind == .half) self.f.split_h8 else self.f.split;
+        try cuda.launch.launch(f, .{ .grid = .{ .x = h.nv, .y = slices }, .block = .{ .x = split.split_threads }, .shared = split.split_smem }, self.rig.s, &a);
+    }
+
+    /// fn_gdn_chain_tpr over `rows` rows from the state in: the state into `st`, the readouts into `ys`.
+    fn tpr(self: *Split, rows: usize, st: u64, ys: u64) !void {
+        const h = self.kind.heads();
+        var a: cuda.Args = .{};
+        for ([_]u64{ self.ins[0], self.ins[1], self.ins[2], self.ins[3], self.ins[4], st }) |x| a.add(x);
+        a.add(@as(c_int, @intCast(rows)));
+        a.add(ys);
+        const f = if (self.kind == .half) self.f.tpr_h8 else self.f.tpr;
+        try cuda.launch.launch(f, .{ .grid = .{ .x = h.nv }, .block = .{ .x = 256 }, .shared = parts.chain_tpr_smem }, self.rig.s, &a);
+    }
+
+    /// The replaced chain over the rows into `o`, and over each mark's rows into its state.
+    fn theirs(self: *Split, o: []const u64) !void {
+        try self.tpr(self.rows, o[1], o[0]);
+        if (o.len == 4) for (cutRows(self.rows), 0..) |at, i| try self.tpr(at, o[2 + i], self.ys);
+    }
+
+    pub fn run(self: *Split) !void {
+        try self.ours(self.outs[0..self.nout]);
+        try self.rig.s.synchronize();
+    }
+
+    /// The replaced chain's bytes in the outputs' layout, back to back, its scratch poisoned (0xff) first.
+    fn baseline(self: *Split) ![]const u8 {
+        var at = self.base;
+        var o: [4]u64 = undefined;
+        for (self.lens[0..self.nout], 0..) |l, i| {
+            o[i] = at;
+            at += l;
+        }
+        const total = at - self.base;
+        const ff = try self.rig.gpu.gpa.alloc(u8, total);
+        defer self.rig.gpu.gpa.free(ff);
+        @memset(ff, 0xff);
+        const b: cuda.DeviceBuffer = .{ .d = self.rig.gpu.d, .ptr = self.base, .len = total };
+        try b.upload(0, ff);
+        try self.theirs(o[0..self.nout]);
+        try self.rig.s.synchronize();
+        return self.rig.bytes(self.base, total);
+    }
+
+    pub fn replaced(self: *Split) ![]const u8 {
+        return self.baseline();
+    }
+
+    /// Gate 1's stated rule: the outputs on the planted inputs equal fn_gdn_chain_tpr's bytes.
+    pub fn check(self: *Split, gate: g.Gate) !?[]const u8 {
+        _ = gate;
+        self.seen.clearRetainingCapacity();
+        try self.seen.appendSlice(self.rig.gpu.gpa, try self.rig.outputBytes());
+        const want = try self.baseline();
+        if (std.mem.eql(u8, self.seen.items, want)) return null;
+        return try std.fmt.bufPrint(&self.msg, "bytes differ from fn_gdn_chain_tpr's from byte {d}", .{std.mem.indexOfDiff(u8, self.seen.items, want).?});
+    }
+
+    pub fn count(self: *Split) usize {
+        var total: usize = 0;
+        for (self.lens[0..self.nout]) |l| total += l;
+        return total;
+    }
+
+    pub fn reference(_: *Split, _: []f64, _: []f64) !void {
+        return error.NoFloat64Reference;
+    }
+};
+
+/// The four registrations, owned so their contexts outlive the run.
+pub const Set = struct {
+    fns: Fns = undefined,
+    splits: [std.enums.values(Kind).len]Split = undefined,
+
+    pub fn add(self: *Set, gpu: check.Gpu, s: cuda.Stream, batch: cuda.Module, kernels: *std.ArrayList(g.Kernel)) !void {
+        self.fns = try load(batch);
+        for (std.enums.values(Kind), &self.splits) |kind, *m| m.* = .{ .rig = .{ .gpu = gpu, .s = s }, .kind = kind, .f = &self.fns };
+        for (&self.splits) |*m| try kernels.append(gpu.gpa, m.kernel());
+    }
+
+    pub fn deinit(self: *Set) void {
+        for (&self.splits) |*m| m.deinit();
+    }
+};
+
+/// Gates 1-4 on both split chains and both planted controls (flashnext-gdn-split-contract).
+pub fn run(gpu: check.Gpu) !void {
+    var stream = try cuda.Stream.init(gpu.d, false);
+    defer stream.deinit();
+    var batch = try cuda.Module.load(gpu.d, cuda.kernels.flashnext_batch);
+    defer batch.unload();
+    var kernels: std.ArrayList(g.Kernel) = .empty;
+    defer kernels.deinit(gpu.gpa);
+    var set: Set = .{};
+    try set.add(gpu, stream, batch, &kernels);
+    defer set.deinit();
+    var tally: g.Tally = .{};
+    try g.runAll(gpu.gpa, kernels.items, 0x73706c, &tally);
+    std.debug.print("SUMMARY flashnext gdn split gates 1-4: {d} pass, {d} fail; {d} controls red, {d} missed\n", .{ tally.passed, tally.failed, tally.caught, tally.missed });
+    try check.expect(tally.problems() == 0, "flashnext gdn split contract failed", .{});
+}
