+//! Flash Next's split prompt chain (each value head's state rows over two blocks), nvcc 13.0's usage on every SM.
+const registry = @import("registry.zig");
+
+/// nvcc 13.0's usage (kernel-contract-limits on a GB10); later compilers' sets are pending.
+pub const records = [_]registry.CudaRecord{
+    .{ .launch = .{ .name = "flashnext_batch fn_gdn_chain_split", .symbol = "fn_gdn_chain_split", .image = "flashnext_batch", .threads = 512, .dynamic = 41472 }, .usage = .{
+        .{ .regs = 60, .static = 0, .bound = 512 },
+        .{ .regs = 64, .static = 0, .bound = 512 },
+        .{ .regs = 64, .static = 0, .bound = 512 },
+        .{ .regs = 64, .static = 0, .bound = 512 },
+        .{ .regs = 64, .static = 0, .bound = 512 },
+    }, .later_pending = true },
+    .{ .launch = .{ .name = "flashnext_batch fn_gdn_chain_split_h8", .symbol = "fn_gdn_chain_split_h8", .image = "flashnext_batch", .threads = 512, .dynamic = 41472 }, .usage = .{
+        .{ .regs = 60, .static = 0, .bound = 512 },
+        .{ .regs = 59, .static = 0, .bound = 512 },
+        .{ .regs = 59, .static = 0, .bound = 512 },
+        .{ .regs = 64, .static = 0, .bound = 512 },
+        .{ .regs = 64, .static = 0, .bound = 512 },
+    }, .later_pending = true },
+};
+
+test "Flash Next split chain: measured on every SM, within its limits, launched as the pass launches it" {
+    const std = @import("std");
+    const t = std.testing;
+    const split = 64 * 8; // gdn_split::ROWS x TPR, cuda_gdn_fused.zig's split_threads
+    try t.expectEqual(@as(usize, 0), try registry.checkCuda(t.allocator, &records, false));
+    for (records) |r| {
+        try t.expect(r.usage[0].regs != 0 and r.later_pending);
+        try t.expectEqual(@as(u32, split), r.launch.threads);
+        try t.expectEqual(@as(u32, 2 * 16 * ((2 * 128 + 64) * 4 + 16)), r.launch.dynamic);
+    }
+}
