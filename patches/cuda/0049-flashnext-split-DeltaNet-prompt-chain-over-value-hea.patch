+namespace gdn_split {
+constexpr int TPR = 8, ROWS = 64, STEPS = 16, THREADS = ROWS * TPR;
+template <int NK, int NV>
+__device__ __forceinline__ void run(const float* qn, const float* kn, const float* v, const float* gb, const float* state_in,
