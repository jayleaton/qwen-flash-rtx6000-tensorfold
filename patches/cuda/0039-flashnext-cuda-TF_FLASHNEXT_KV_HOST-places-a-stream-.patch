diff --git a/zig/src/families/flashnext/cuda_kv_host.zig b/zig/src/families/flashnext/cuda_kv_host.zig
new file mode 100644
index 000000000..d62436ea2
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_kv_host.zig
@@ -0,0 +1,176 @@
+//! TF_FLASHNEXT_KV_HOST: a stream's attention K/V rows on mapped pinned host pages, placed per stream.
+const std = @import("std");
+const cuda = @import("cuda");
+const prompt = @import("cuda_prompt.zig");
+const wt = @import("cuda_prompt_wt.zig");
+const sizes = @import("cuda_seq_bytes.zig");
+const Heads = @import("cuda_heads.zig").Heads;
+
+/// The placement a new stream's K/V rows take; the indexer keys, pooled rows and DeltaNet state stay on the device.
+pub const Mode = enum { off, overflow, all };
+
+/// The mode the family's load read (ranks.identity binds it, so a pair never serves one host stream and one device).
+pub var mode: Mode = .off;
+
+/// The device room left past every admitted stream's other buffers and the prompt cache: `overflow` spends it on K/V.
+pub var room: u64 = 0;
+
+/// The device K/V bytes `overflow` placed out of `room` and has not yet given back.
+pub var spent: u64 = 0;
+
+/// Freed K/V pages, kept whole for the next host-placed stream of the same size.
+pub var spares: cuda.HostSpares = .{ .mapped = true };
+
+/// The setting's word, read once at load (the startup check refused malformed text already).
+pub fn readMode() Mode {
+    return switch (@import("sys").environment.read(u64, "TF_FLASHNEXT_KV_HOST", 0) catch 0) {
+        1 => .overflow,
+        2 => .all,
+        else => .off,
+    };
+}
+
+/// A stream's K/V pages in mapped pinned host memory: the owner of the borrowed views its sequence holds.
+pub const Host = struct {
+    gpa: std.mem.Allocator,
+    pages: cuda.HostBuffer,
+    kc: []cuda.DeviceBuffer,
+    vc: []cuda.DeviceBuffer,
+
+    /// After the sequence drained (its own deinit frees the views it borrowed): its pages back to the spares.
+    pub fn release(h: *Host) void {
+        spares.give(h.pages);
+        h.gpa.destroy(h);
+    }
+};
+
+/// A new sequence's keys and values: pool pages, mapped host pages or device buffers, into its three fields.
+pub fn placeKv(e: *prompt.Engine, seq: *prompt.Seq) !void {
+    if (seq.paged) |*p| {
+        seq.kc = try p.views(e.gpa, e.driver, .key);
+        seq.vc = try p.views(e.gpa, e.driver, .value);
+        return;
+    }
+    if (try open(e, seq.cap)) |host| {
+        seq.kc = host.kc;
+        seq.vc = host.vc;
+        seq.kv_host = host;
+        return;
+    }
+    seq.kc = try prompt.zeros(e.gpa, e.driver, e.stream.*, wt.attn_n, sizes.kvBytes(seq.cap, e.heads));
+    seq.vc = try prompt.zeros(e.gpa, e.driver, e.stream.*, wt.attn_n, sizes.kvBytes(seq.cap, e.heads));
+    if (mode == .overflow) spent += kvBytes(seq.cap, e.heads);
+}
+
+/// A draining sequence's K/V: host pages back to the spares, or `overflow`'s device bytes back to the room.
+pub fn drop(seq: *prompt.Seq) void {
+    if (seq.kv_host) |h| return h.release();
+    if (mode != .overflow or seq.paged != null) return;
+    var held: u64 = 0;
+    for (seq.kc, seq.vc) |k, v| held += k.len + v.len;
+    spent -|= held;
+}
+
+/// This stream's K/V rows on mapped host pages (null: the device), by the mode and, at `overflow`, the budget.
+fn open(e: *prompt.Engine, cap: usize) !?*Host {
+    if (mode == .off or cap == 0) return null;
+    if (mode == .overflow and fits(spent, cap, e.heads)) return null;
+    const bytes = @as(usize, wt.attn_n) * sizes.kvBytes(cap, e.heads);
+    const host = try e.gpa.create(Host);
+    errdefer e.gpa.destroy(host);
+    host.* = .{ .gpa = e.gpa, .pages = try spares.take(e.driver, 2 * bytes), .kc = &.{}, .vc = &.{} };
+    errdefer host.pages.free();
+    const base = try host.pages.device();
+    try e.driver.check(e.driver.api.cuMemsetD8Async(base, 0, 2 * bytes, e.stream.handle), "cuMemsetD8Async");
+    host.kc = try views(e.gpa, e.driver, base, bytes);
+    errdefer e.gpa.free(host.kc);
+    host.vc = try views(e.gpa, e.driver, base + bytes, bytes);
+    return host;
+}
+
+/// `attn_n` borrowed views of `bytes` bytes at `base`, one a layer, 256-byte aligned.
+pub fn views(gpa: std.mem.Allocator, d: *const cuda.Driver, base: u64, bytes: usize) ![]cuda.DeviceBuffer {
+    const out = try gpa.alloc(cuda.DeviceBuffer, wt.attn_n);
+    errdefer gpa.free(out);
+    const row = std.mem.alignForward(usize, bytes / wt.attn_n, 256);
+    for (out, 0..) |*b, layer| b.* = .{ .d = d, .ptr = base + layer * row, .len = bytes / wt.attn_n, .borrowed = true };
+    return out;
+}
+
+/// One stream's keys and values over all attention layers: what the memory plan prices on the host, not the device.
+pub fn kvBytes(cap: usize, h: Heads) u64 {
+    return 2 * @as(u64, wt.attn_n) * sizes.kvBytes(cap, h);
+}
+
+/// A stream's device bytes in the memory plan: with K/V placement on, its K/V rows are not priced on the card.
+pub fn deviceStreamBytes(stream_bytes: usize, window: usize, h: Heads) usize {
+    return if (mode == .off) stream_bytes else stream_bytes - kvBytes(window, h);
+}
+
+/// The memory plan's device room left once the admitted streams and the prompt cache are priced.
+pub fn grant(left: u64) void {
+    room = left;
+    spent = 0;
+}
+
+/// Whether a `cap` sequence's K/V still fits the granted room past the `held` bytes `overflow` placed already.
+pub fn fits(held: u64, cap: usize, h: Heads) bool {
+    return held + kvBytes(cap, h) <= room;
+}
+
+test "a word read maps off, overflow and all, and a malformed value stays off" {
+    const env = @import("sys").environment;
+    const read = struct {
+        fn at(raw: []const u8) Mode {
+            return switch (env.value(u64, "TF_FLASHNEXT_KV_HOST", raw, 0) catch 0) {
+                1 => .overflow,
+                2 => .all,
+                else => .off,
+            };
+        }
+    }.at;
+    try std.testing.expectEqual(Mode.off, read("off"));
+    try std.testing.expectEqual(Mode.overflow, read("overflow"));
+    try std.testing.expectEqual(Mode.all, read("all"));
+    try std.testing.expectEqual(Mode.off, read("nonsense"));
+}
+
+test "overflow places a stream's K/V on the host once its rows no longer fit the granted room" {
+    const save = room;
+    defer room = save;
+    room = kvBytes(4096, .half);
+    try std.testing.expect(fits(0, 4096, .half)); // the room still fits this stream's rows
+    try std.testing.expect(!fits(1, 4096, .half)); // one byte over: its K/V goes to the host
+    try std.testing.expect(!fits(0, 8192, .half)); // a longer stream never fits the same room
+    room += kvBytes(4096, .half);
+    try std.testing.expect(fits(kvBytes(4096, .half), 4096, .half));
+}
+
+test "with placement on, the memory plan prices a stream's K/V rows off the card, and off it keeps them" {
+    const save = mode;
+    defer mode = save;
+    const whole = sizes.seqBytes(65536, .half);
+    mode = .off;
+    try std.testing.expectEqual(whole, deviceStreamBytes(whole, 65536, .half));
+    for ([_]Mode{ .overflow, .all }) |m| {
+        mode = m;
+        try std.testing.expectEqual(whole - kvBytes(65536, .half), deviceStreamBytes(whole, 65536, .half));
+    }
+}
+
+test "views cover each layer's rows once, 256-byte aligned, and the keys end where the values begin" {
+    const layers = wt.attn_n;
+    const bytes = layers * 4 * 256; // four aligned rows a layer
+    const fake: u64 = 0x10000;
+    const kc = try views(std.testing.allocator, undefined, fake, bytes);
+    defer std.testing.allocator.free(kc);
+    const vc = try views(std.testing.allocator, undefined, fake + bytes, bytes);
+    defer std.testing.allocator.free(vc);
+    try std.testing.expectEqual(layers, kc.len);
+    for (kc, 0..) |b, i| {
+        try std.testing.expectEqual(@as(u64, 4 * 256), b.len);
+        try std.testing.expectEqual(fake + i * 4 * 256, b.ptr);
+        try std.testing.expect(b.borrowed);
+    }
+    try std.testing.expectEqual(fake + bytes + layers * 4 * 256 - 4 * 256, vc[layers - 1].ptr);
+}
