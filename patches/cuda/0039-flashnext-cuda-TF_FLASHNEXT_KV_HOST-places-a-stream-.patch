diff --git a/zig/tests/cuda/flashnext_kv_host_tests.zig b/zig/tests/cuda/flashnext_kv_host_tests.zig
new file mode 100644
index 000000000..838f6cc91
--- /dev/null
+++ b/zig/tests/cuda/flashnext_kv_host_tests.zig
@@ -0,0 +1,74 @@
+//! A stream's K/V rows on mapped pinned host pages: device writes, memsets and copies reach them, byte for byte.
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const kv_host = flash.kv_host;
+const wt = flash.wt;
+const seq_bytes = flash.seq_bytes;
+
+pub fn run(gpu: check.Gpu) !void {
+    std.debug.print("flashnext-kv-host: placement mode {s}\n", .{@tagName(kv_host.mode)});
+    kv_host.mode = .all; // the serving mode's placement, whatever the process carried in
+    defer kv_host.mode = .off;
+    defer kv_host.spares.deinit();
+    var stream = try cuda.Stream.init(gpu.d, true);
+    defer stream.deinit();
+    // each band twice: the second takes the first's freed pages whole
+    for ([_]usize{ 8192, 32768 }) |cap| for (0..2) |pass| {
+        const reused = try one(gpu, &stream, cap, pass == 1);
+        try check.expect(reused == (pass == 1), "band of {d} rows, pass {d}: spare taken {}", .{ cap, pass, reused });
+    };
+    check.pass("flashnext-kv-host: mapped K/V pages take device writes and copies, byte for byte", .{});
+}
+
+fn one(gpu: check.Gpu, stream: *cuda.Stream, cap: usize, allow_spare: bool) !bool {
+    const d = gpu.d;
+    const bytes = @as(usize, wt.attn_n) * seq_bytes.kvBytes(cap, .full);
+    const reused = allow_spare and kv_host.spares.fits(2 * bytes);
+    const host = try gpu.gpa.create(kv_host.Host);
+    host.* = .{ .gpa = gpu.gpa, .pages = try kv_host.spares.take(d, 2 * bytes), .kc = &.{}, .vc = &.{} };
+    errdefer kv_host.Host.release(host);
+    errdefer gpu.gpa.free(host.kc);
+    const base = try host.pages.device();
+    host.kc = try kv_host.views(gpu.gpa, d, base, bytes);
+    host.vc = try kv_host.views(gpu.gpa, d, base + bytes, bytes);
+    try check.expect(host.kc[0].len == seq_bytes.kvBytes(cap, .full), "each layer's rows named once", .{});
+    // the keys' band: a pattern a kernel's stores would leave, read back through the device's eyes
+    const want = try gpu.gpa.alloc(u8, 2 * bytes);
+    defer gpu.gpa.free(want);
+    for (want[0..bytes], 0..) |*v, i| v.* = @truncate(i *% 2654435761 >> 7);
+    @memset(want[bytes..], 0x5a);
+    var src = try cuda.DeviceBuffer.alloc(d, 2 * bytes);
+    defer src.free();
+    try src.upload(0, want);
+    var dst = try cuda.DeviceBuffer.alloc(d, 2 * bytes);
+    defer dst.free();
+    const t0 = check.now(gpu.io);
+    try d.check(d.api.cuMemcpyDtoDAsync_v2(host.kc[0].ptr, src.ptr, bytes, stream.handle), "key band copy");
+    try stream.synchronize();
+    const t1 = check.now(gpu.io);
+    // the values' band: a device memset straight through the mapped pointer
+    try d.check(d.api.cuMemsetD8Async(host.vc[0].ptr, 0x5a, bytes, stream.handle), "value band memset");
+    try stream.synchronize();
+    const t2 = check.now(gpu.io);
+    try d.check(d.api.cuMemcpyDtoDAsync_v2(dst.ptr, base, 2 * bytes, stream.handle), "read back");
+    try stream.synchronize();
+    const t3 = check.now(gpu.io);
+    const got = try gpu.gpa.alloc(u8, 2 * bytes);
+    defer gpu.gpa.free(got);
+    try dst.download(0, got);
+    try check.sameBytes("mapped K/V pages", got, want);
+    gpu.gpa.free(host.kc);
+    gpu.gpa.free(host.vc);
+    kv_host.Host.release(host);
+    const gib = @as(f64, @floatFromInt(2 * bytes)) / (1 << 30);
+    std.debug.print("  {d} rows {s}: {d:.3} GiB, write {d:.2} GiB/s, memset {d:.2} GiB/s, read {d:.2} GiB/s\n", .{
+        cap, if (reused) "from a spare" else "newly pinned", gib, gib / s(t1 - t0), gib / s(t2 - t1), gib / s(t3 - t2),
+    });
+    return reused;
+}
+
+fn s(ns: i96) f64 {
+    return @as(f64, @floatFromInt(ns)) / 1e9;
+}
