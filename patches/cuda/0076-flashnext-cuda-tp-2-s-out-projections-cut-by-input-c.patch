diff --git a/zig/src/families/flashnext/cuda_outproj_ksplit.zig b/zig/src/families/flashnext/cuda_outproj_ksplit.zig
new file mode 100644
index 000000000..b1e252578
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_outproj_ksplit.zig
@@ -0,0 +1,61 @@
+//! TF_FLASHNEXT_OUTPROJ_KSPLIT: at --tp 2 each rank's out projection over its own heads, the two partials summed once.
+const std = @import("std");
+const cuda = @import("cuda");
+const wt = @import("cuda_prompt_wt.zig");
+const projections = @import("cuda_projection_load.zig");
+const Cut = @import("cuda_modelopt_experts.zig").Cut;
+const PeerSlots = @import("cuda_peer_slots.zig").PeerSlots;
+
+const dims = wt.dims;
+
+/// TF_FLASHNEXT_OUTPROJ_KSPLIT as read at load: under the head split the out projections are cut by input columns.
+pub var on = false;
+
+/// TF_FLASHNEXT_OUTPROJ_KSPLIT: unset, blank or 0 keeps the output-column cut; 1 cuts the inputs and sums partials.
+pub fn enabled() !bool {
+    return @import("sys").environment.read(bool, "TF_FLASHNEXT_OUTPROJ_KSPLIT", false) catch return error.BadOutProjSplit;
+}
+
+/// A rank's K slices: the whole projection's over its half, so each spans the inputs one of the whole one's does.
+pub fn slices(world: usize) u32 {
+    return @intCast(cuda.qmmf.splitK(dims, wt.out_k) / world);
+}
+
+/// This rank's input columns of a BF16 [dims, k] out projection: the ones its heads' outputs feed.
+pub fn load(gpa: std.mem.Allocator, driver: *const cuda.Driver, store: anytype, name: []const u8, k: usize, world: usize, rank: usize) !wt.Q4 {
+    if (k != wt.out_k) return error.UnexpectedTensor;
+    var q = try projections.loadCut(gpa, driver, store, name, dims, k, try Cut.init(k, world, rank), .cols);
+    errdefer q.free();
+    q.native = try cuda.qmmf.pinned(q.native orelse return error.UnexpectedTensor, slices(world));
+    return q;
+}
+
+/// A layer whose out weight holds this rank's input columns: whole outputs over half the inputs.
+pub fn cut(native: cuda.qmmf.Weight, width: usize) bool {
+    return native.n == dims and native.k == width;
+}
+
+/// part's FP32 [n, dims]: this rank's heads `x` [n, width] times its input columns, plus the peer's partial.
+pub fn run(self: anytype, c: anytype, x: u64, native: cuda.qmmf.Weight, width: usize) !usize {
+    const s = self.s;
+    const n = self.rows;
+    if (!cut(native, width) or 2 * width != wt.out_k or native.sk != slices(2)) return error.UnexpectedTensor;
+    try self.k.native_lane.matmulF32(self.stream, x, width, n, native, s.part, s.native_part);
+    // one add of two partials: a + b and b + a are the same IEEE sum, so both ranks hold identical rows
+    if (peer(c, n)) |p| {
+        try p.sumRows(self.k.peer_rows_send, self.k.peer_rows_add, self.stream, s.part, n);
+    } else try c.sum(self.stream, s.part, n * dims);
+    return 1;
+}
+
+/// The peer's mapped buffer (TF_FLASHNEXT_PEER_SLOTS) for a pass it takes, else null: NCCL's two-rank sum.
+fn peer(c: anytype, n: usize) ?*PeerSlots {
+    if (!PeerSlots.fits(n)) return null;
+    return if (c.peer) |*p| p else null;
+}
+
+test {
+    try std.testing.expectEqual(@as(u32, 4), slices(2));
+    try std.testing.expect(cut(cuda.modelopt.bf16Weight(0, dims, wt.out_k / 2), wt.out_k / 2));
+    try std.testing.expect(!cut(cuda.modelopt.bf16Weight(0, dims / 2, wt.out_k), wt.out_k / 2));
+}
