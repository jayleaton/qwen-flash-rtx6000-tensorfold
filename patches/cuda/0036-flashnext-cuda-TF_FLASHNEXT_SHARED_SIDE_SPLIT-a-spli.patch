diff --git a/zig/src/families/flashnext/cuda_batch_side.zig b/zig/src/families/flashnext/cuda_batch_side.zig
index 0cc02a05e..8666994d4 100644
--- a/zig/src/families/flashnext/cuda_batch_side.zig
+++ b/zig/src/families/flashnext/cuda_batch_side.zig
@@ -13,6 +13,17 @@ pub fn on() bool {
     return @import("sys").environment.read(bool, "TF_FLASHNEXT_SHARED_SIDE", true) catch true;
 }
 
+/// TF_FLASHNEXT_SHARED_SIDE_SPLIT=1: a shared expert the dense split cuts also runs on the side stream.
+pub fn splitOn() bool {
+    return @import("sys").environment.read(bool, "TF_FLASHNEXT_SHARED_SIDE_SPLIT", false) catch false;
+}
+
+/// Whether a pass's shared expert forks: whole on rank 0, or cut on every rank with splitOn; never a prompt fill.
+pub fn forks(rank: usize, split: bool, prompt: bool, split_on: bool) bool {
+    if (prompt) return false;
+    return if (split) split_on else rank == 0;
+}
+
 /// The shared expert's stream and the two points it forks and joins at.
 pub const Side = struct {
     stream: cuda.Stream,
@@ -55,13 +66,13 @@ pub fn down(pass: anytype, st: cuda.Stream, input: u64, native: anytype, n: usiz
     try glue.sharedScatter(st, s.shared_out, s.y, n, dims, slots);
 }
 
-/// After y is cleared: the whole shared expert forked onto rank 0's side stream (not a prompt fill), or null.
+/// After y is cleared: the shared expert on the side stream (forks), a cut one's gather the only collective till join.
 pub fn fork(pass: anytype, native: anytype, n: usize) !?Side {
     const x = pass.s.side orelse return null;
-    if (native.rank != 0 or native.split_shared or pass.hooks.prompt) return null;
+    if (!forks(native.rank, native.split_shared, pass.hooks.prompt, splitOn())) return null;
     try x.fork.record(pass.stream);
     try x.stream.wait(x.fork);
-    try run(pass, x.stream, native, n);
+    if (native.split_shared) try @import("cuda_shared_split.zig").runOn(pass, x.stream, native, n) else try run(pass, x.stream, native, n);
     try x.join.record(x.stream);
     return x;
 }
@@ -71,3 +82,10 @@ pub fn join(pass: anytype, side: ?Side, native: anytype, n: usize) !void {
     if (side) |x| return pass.stream.wait(x.join);
     if (native.rank == 0) try run(pass, pass.stream, native, n);
 }
+
+test "the shared expert forks whole on rank 0, cut on every rank only with the split switch, never in a prompt fill" {
+    const t = std.testing;
+    try t.expect(forks(0, false, false, false) and !forks(1, false, false, true));
+    try t.expect(!forks(0, true, false, false) and forks(0, true, false, true) and forks(1, true, false, true));
+    try t.expect(!forks(0, false, true, true) and !forks(0, true, true, true));
+}
diff --git a/zig/src/families/flashnext/cuda_shared_split.zig b/zig/src/families/flashnext/cuda_shared_split.zig
index 33b4c1ee4..bf7a5691a 100644
--- a/zig/src/families/flashnext/cuda_shared_split.zig
+++ b/zig/src/families/flashnext/cuda_shared_split.zig
@@ -4,25 +4,30 @@ const ops = @import("cuda_batch_ops.zig");
 const mixed = @import("cuda_mixed_experts.zig");
 
 pub fn run(self: anytype, native: *const mixed.Owned, n: usize) !void {
+    return runOn(self, self.stream, native, n);
+}
+
+/// run on `st`: the pass's stream, or the side stream forked after y is cleared (its gather then rides on `st`).
+pub fn runOn(self: anytype, st: anytype, native: *const mixed.Owned, n: usize) !void {
     if (!native.split_shared and native.rank != 0) return;
     const s = self.s;
     const dims = wt.dims;
     const glue = self.tri.own orelse return error.NativeGlueRequired;
     const width = if (native.split_shared) wt.moe_w / 2 else wt.moe_w;
-    try self.k.native_lane.matmul(self.stream, s.mixed, dims, n, native.shared[0].native.?, s.shared_gate, s.native_part);
-    try self.k.native_lane.matmul(self.stream, s.mixed, dims, n, native.shared[1].native.?, s.shared_up, s.native_part);
-    try glue.sharedSwiGLU(self.stream, s.shared_gate, s.shared_up, s.shared_act, n, width);
+    try self.k.native_lane.matmul(st, s.mixed, dims, n, native.shared[0].native.?, s.shared_gate, s.native_part);
+    try self.k.native_lane.matmul(st, s.mixed, dims, n, native.shared[1].native.?, s.shared_up, s.native_part);
+    try glue.sharedSwiGLU(st, s.shared_gate, s.shared_up, s.shared_act, n, width);
     var input = s.shared_act;
     if (native.split_shared) {
         const c = self.m.collective orelse return error.TensorParallelUnavailable;
-        try c.gather(self.stream, input, s.rank_gather, n * width);
+        try c.gather(st, input, s.rank_gather, n * width);
         // one row: the ranks' gathered blocks [2, 1, width] are already the row [1, moe_w] the down projection reads
-        if (n > 1) for (0..2) |rank| try ops.copyCols(self.k, self.stream, s.rank_gather + rank * n * width * 2, width, s.rank_input + rank * width * 2, wt.moe_w, width, n);
+        if (n > 1) for (0..2) |rank| try ops.copyCols(self.k, st, s.rank_gather + rank * n * width * 2, width, s.rank_input + rank * width * 2, wt.moe_w, width, n);
         input = if (n == 1) s.rank_gather else s.rank_input;
     }
     // the whole expert's down goes straight into its slot (cuda_batch_side.down), as on the side stream
-    if (!native.split_shared) return @import("cuda_batch_side.zig").down(self, self.stream, input, native, n);
-    try self.k.native_lane.matmulF32(self.stream, input, wt.moe_w, n, native.shared[2].native.?, s.shared_out, s.native_part);
+    if (!native.split_shared) return @import("cuda_batch_side.zig").down(self, st, input, native, n);
+    try self.k.native_lane.matmulF32(st, input, wt.moe_w, n, native.shared[2].native.?, s.shared_out, s.native_part);
     // Every routed slot and the peer's output columns stay at the zeros set before the expert launches.
-    try ops.copyCols(self.k, self.stream, s.shared_out, dims, s.y + (wt.slots - 1) * dims * 4 + native.rank * dims * 2, wt.slots * dims * 2, dims, n);
+    try ops.copyCols(self.k, st, s.shared_out, dims, s.y + (wt.slots - 1) * dims * 4 + native.rank * dims * 2, wt.slots * dims * 2, dims, n);
 }
