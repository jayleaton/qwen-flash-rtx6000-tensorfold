 .../families/flashnext/cuda_shared_split.zig  | 21 +++++++++-------
 zig/src/platform/environment.zig              |  1 +
 .../platform/environment_flashnext_test.zig   |  4 ++--
 5 files changed, 38 insertions(+), 13 deletions(-)

