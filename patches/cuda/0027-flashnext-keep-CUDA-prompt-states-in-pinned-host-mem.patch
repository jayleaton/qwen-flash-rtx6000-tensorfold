+const Placing = struct {
+    var integrated: c_int = 0;
+    var counts: struct { alloc: usize = 0, free: usize = 0, pin: usize = 0, unpin: usize = 0, mapped: bool = false } = .{};
+    fn attribute(v: *c_int, a: cuda.abi.DeviceAttribute, _: cuda.abi.Device) callconv(.c) cuda.abi.Result {
+        v.* = if (a == .integrated) integrated else 0;
+        return cuda.abi.success;
+    }
+    fn alloc(p: *cuda.abi.DevicePtr, _: usize) callconv(.c) cuda.abi.Result {
+        counts.alloc += 1;
+        p.* = 0x8000_0000;
+        return cuda.abi.success;
+    }
+    fn free(_: cuda.abi.DevicePtr) callconv(.c) cuda.abi.Result {
+        counts.free += 1;
+        return cuda.abi.success;
+    }
+    fn pin(p: *?*anyopaque, _: usize, flags: c_uint) callconv(.c) cuda.abi.Result {
+        counts.pin += 1;
+        counts.mapped = flags & cuda.abi.host_alloc_devicemap != 0;
+        p.* = @ptrFromInt(0x7000_0000); // never read or written: every copy goes through the driver
+        return cuda.abi.success;
+    }
+    fn device(p: *cuda.abi.DevicePtr, _: ?*anyopaque, _: c_uint) callconv(.c) cuda.abi.Result {
+        p.* = 0x6000_0000;
+        return cuda.abi.success;
+    }
+    fn unpin(_: ?*anyopaque) callconv(.c) cuda.abi.Result {
+        counts.unpin += 1;
+        return cuda.abi.success;
+    }
+    fn wait(_: cuda.abi.Stream) callconv(.c) cuda.abi.Result {
+        return cuda.abi.success;
+    }
+};
+
+test "a discrete card keeps states in mapped pinned host memory, an integrated GPU in device memory as before" {
+    var d: cuda.Driver = .{ .lib = undefined, .api = undefined };
+    d.api.cuDeviceGetAttribute = Placing.attribute;
+    d.api.cuMemAlloc_v2 = Placing.alloc;
+    d.api.cuMemFree_v2 = Placing.free;
+    d.api.cuMemHostAlloc = Placing.pin;
+    d.api.cuMemHostGetDevicePointer_v2 = Placing.device;
+    d.api.cuMemFreeHost = Placing.unpin;
+    d.api.cuStreamSynchronize = Placing.wait;
+    const ctx: cuda.Context = .{ .d = &d, .device = 0, .handle = null };
+    const stream: cuda.Stream = .{ .d = &d, .handle = null };
+    for ([_]c_int{ 0, 1 }) |integrated| {
+        Placing.integrated = integrated;
+        Placing.counts = .{};
+        const host = try onHost(&ctx);
+        try std.testing.expectEqual(integrated == 0, host);
+        const before = cuda.usage(false).device;
+        const kept = try prepare(std.testing.allocator, &d, host, 8, .{ 1, 2 }, true, .full);
+        // the device copies reach the state at buf.ptr either way: the host's mapped address, or its device buffer
+        try std.testing.expectEqual(@as(u64, if (host) 0x6000_0000 else 0x8000_0000), kept.buf.ptr);
+        try std.testing.expectEqual(bytes(8, true, .full), kept.buf.len);
+        try std.testing.expectEqual(host, kept.host != null and kept.buf.borrowed);
+        try std.testing.expectEqual(before + if (host) 0 else kept.buf.len, cuda.usage(false).device);
+        drop(std.testing.allocator, stream, kept);
+        const c = Placing.counts;
+        try std.testing.expectEqual([4]usize{ @intFromBool(!host), @intFromBool(!host), @intFromBool(host), @intFromBool(host) }, [4]usize{ c.alloc, c.free, c.pin, c.unpin });
+        try std.testing.expectEqual(host, c.mapped);
+    }
+}
+
