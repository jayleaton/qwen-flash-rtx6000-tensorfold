+/// Whether kept states go to pinned host memory: a discrete card's; an integrated GPU's (GB10) stay in device memory.
+pub fn onHost(ctx: *const cuda.Context) !bool {
+    return try ctx.attribute(.integrated) == 0;
+}
+
+/// `n` bytes of device memory, or of mapped pinned host memory (`host`) that the same device-to-device copies reach.
+fn room(driver: *const cuda.Driver, n: usize, host: bool) !struct { cuda.DeviceBuffer, ?cuda.HostBuffer } {
+    if (!host) return .{ try cuda.DeviceBuffer.alloc(driver, n), null };
+    var pinned = try cuda.HostBuffer.allocMapped(driver, n);
+    errdefer pinned.free();
+    return .{ .{ .d = driver, .ptr = try pinned.device(), .len = n, .borrowed = true }, pinned };
+}
+
+fn release(gpa: std.mem.Allocator, snap: *Snap) void {
+    snap.buf.free();
+    if (snap.host) |*h| h.free();
+    gpa.destroy(snap);
+}
