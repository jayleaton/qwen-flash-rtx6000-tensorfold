diff --git a/zig/src/families/flashnext/cuda_batch_hop.zig b/zig/src/families/flashnext/cuda_batch_hop.zig
index 6b01069ab..06daf05d8 100644
--- a/zig/src/families/flashnext/cuda_batch_hop.zig
+++ b/zig/src/families/flashnext/cuda_batch_hop.zig
@@ -8,8 +8,52 @@ pub const Hop = struct {
     give: *const fn (ctx: *anyopaque, h: u64, rows: usize) anyerror!void,
     /// A host wait for the stream's work, hops included, that ends when the other stage is lost.
     finish: *const fn (ctx: *anyopaque) anyerror!void,
+    late: *Late,
 };
 
+/// Rank 0's rows of a prompt chunk still to come back: received into `landing` before the next send, then absorbed.
+pub const Late = struct {
+    landing: u64 = 0,
+    /// The landing's bytes (0: no landing, rows always return in the pass).
+    cap: usize = 0,
+    rows: usize = 0,
+    absorb: ?Absorb = null,
+};
+
+/// What reads a late chunk's rows where they land (the MTP head), run once their receive and the next send are posted.
+pub const Absorb = struct {
+    ctx: *anyopaque,
+    arg: *anyopaque,
+    run: *const fn (ctx: *anyopaque, arg: *anyopaque, rows: u64) anyerror!void,
+};
+
+/// A pass's rows at a stage: `late` lets rank 0's rows come back during the next pass; `back` tells rank 1 they return.
+pub const Rows = struct { late: ?Absorb = null, back: bool = false };
+
+/// Whether every chunk's rows return to the head's stage: the MTP head's streams, a keep, a late absorb.
+pub fn always(h: anytype) bool {
+    return h.streams != 0 or h.keep != null or h.stage.late != null;
+}
+
+/// Whether this chunk's rows return: its scores too, or rank 0's word that they do (`Rows.back`, on rank 1).
+pub fn back(h: anytype) bool {
+    return h.logits != .none or always(h) or h.stage.back;
+}
+
+/// The late rows' receive and their absorb (rank 0), before anything else crosses the hop.
+pub fn settle(hop: Hop) !void {
+    const l = hop.late.*;
+    if (l.rows == 0) return;
+    hop.late.* = .{ .landing = l.landing, .cap = l.cap };
+    try hop.take(hop.ctx, l.landing, l.rows);
+    if (l.absorb) |a| try a.run(a.ctx, a.arg, l.landing);
+}
+
+/// The late rows still come, but nothing reads them: their reader is going away.
+pub fn forget(hop: Hop) void {
+    hop.late.absorb = null;
+}
+
 /// A stage's layers from `first` (an absolute index); its rows cross through `hop`.
 pub const Stage = struct { first: usize, hop: Hop };
 
@@ -30,12 +74,83 @@ pub fn enter(pass: anytype, n: usize) !void {
     try @import("cuda_media.zig").inject(pass.seq.media, pass.lanes, pass.stream, s.h, pass.pos0, n);
 }
 
-/// The pass's last step: the head, or the written-back rows on to the next stage (rank 0: back again, then its head).
+/// The pass's last step: the head, or its rows on to the next stage (rank 0: the late receive first, its absorb after).
 pub fn leave(pass: anytype, logits_host: ?[]u8) !void {
     const st = pass.m.stage orelse return pass.head(logits_host);
     try pass.writeback(0, pass.rows);
+    const returns = back(pass.hooks);
+    if (st.first > 0) {
+        if (returns) try st.hop.give(st.hop.ctx, pass.s.h, pass.rows);
+        return;
+    }
+    const prior = st.hop.late.*;
+    st.hop.late.* = .{ .landing = prior.landing, .cap = prior.cap };
+    if (prior.rows > 0) try st.hop.take(st.hop.ctx, prior.landing, prior.rows);
     try st.hop.give(st.hop.ctx, pass.s.h, pass.rows);
-    if (st.first > 0) return;
+    if (prior.rows > 0) if (prior.absorb) |a| try a.run(a.ctx, a.arg, prior.landing);
+    if (!returns) return;
+    if (pass.hooks.stage.late) |a| {
+        if (pass.rows * wt.wide * 2 > st.hop.late.cap) return error.UnexpectedTensor;
+        st.hop.late.rows = pass.rows;
+        st.hop.late.absorb = a;
+        return;
+    }
     try st.hop.take(st.hop.ctx, pass.s.h, pass.rows);
     try pass.head(logits_host);
 }
+
+test "rank 0 posts a late chunk's receive before the next send and absorbs it after; rank 1 returns only read rows" {
+    const std = @import("std");
+    const Log = struct {
+        ops: [16]u8 = undefined,
+        n: usize = 0,
+        fn add(l: *@This(), op: u8) void {
+            l.ops[l.n] = op;
+            l.n += 1;
+        }
+        fn of(ctx: *anyopaque) *@This() {
+            return @ptrCast(@alignCast(ctx));
+        }
+        fn take(ctx: *anyopaque, h: u64, _: usize) anyerror!void {
+            of(ctx).add(if (h == 7) 'L' else 'T');
+        }
+        fn give(ctx: *anyopaque, _: u64, _: usize) anyerror!void {
+            of(ctx).add('G');
+        }
+        fn finish(_: *anyopaque) anyerror!void {}
+        fn absorb(ctx: *anyopaque, _: *anyopaque, rows: u64) anyerror!void {
+            of(ctx).add(if (rows == 7) 'A' else '?');
+        }
+    };
+    const Hooks = @import("cuda_batch_state.zig").Hooks;
+    const Scratch = struct { h: u64 = 1 };
+    const Fake = struct {
+        m: struct { stage: ?Stage },
+        s: *const Scratch,
+        rows: usize = 4,
+        hooks: Hooks,
+        log: *Log,
+        fn writeback(_: *@This(), _: usize, _: usize) !void {}
+        fn head(f: *@This(), _: ?[]u8) !void {
+            f.log.add('H');
+        }
+    };
+    var log: Log = .{};
+    var late: Late = .{ .landing = 7, .cap = 4 * wt.wide * 2 };
+    const hop: Hop = .{ .ctx = &log, .take = Log.take, .give = Log.give, .finish = Log.finish, .late = &late };
+    const absorb: Absorb = .{ .ctx = &log, .arg = &log, .run = Log.absorb };
+    const h: Scratch = .{};
+    var zero: Fake = .{ .m = .{ .stage = .{ .first = 0, .hop = hop } }, .s = &h, .hooks = .{ .logits = .none }, .log = &log };
+    try leave(&zero, null); // nothing reads it: sent only
+    zero.hooks = .{ .logits = .none, .streams = 9, .stage = .{ .late = absorb } };
+    try leave(&zero, null); // late: sent, returns next pass
+    zero.hooks = .{ .logits = .last, .streams = 9 };
+    try leave(&zero, null); // the late receive, this send, its absorb, then this chunk back and the head
+    try std.testing.expectEqualStrings("GGLGATH", log.ops[0..log.n]);
+    log.n = 0;
+    var one: Fake = .{ .m = .{ .stage = .{ .first = 24, .hop = hop } }, .s = &h, .hooks = .{ .logits = .none }, .log = &log };
+    try leave(&one, null);
+    one.hooks = .{ .logits = .none, .stage = .{ .back = true } };
+    try leave(&one, null);
+    try std.testing.expectEqualStrings("G", log.ops[0..log.n]);
+}
