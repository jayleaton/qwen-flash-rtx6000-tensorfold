diff --git a/zig/src/families/flashnext/cuda_span_threads.zig b/zig/src/families/flashnext/cuda_span_threads.zig
new file mode 100644
index 000000000..6a5bc3aae
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_span_threads.zig
@@ -0,0 +1,201 @@
+//! Two pipeline stages on one GPU, a thread and a stream each, their rows through device flags a graph captures.
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+
+const prompt = flash.prompt;
+const hops = flash.hop;
+const wide = 4 * 2560;
+const vocab = prompt.vocabulary;
+const Value = *const fn (cuda.abi.Stream, u64, u32, c_uint) callconv(.c) cuda.abi.Result;
+const wait_eq: c_uint = 1;
+
+/// Window sizes a verify pass takes in turn, so each size's graph is captured, then replayed and updated.
+pub const sizes = [_]usize{ 3, 1, 3, 1, 2, 2, 4, 4 };
+
+/// One direction's rows and its flag: 1 while rows wait for the taker, 0 once taken.
+const Slot = struct {
+    rows: cuda.DeviceBuffer,
+    flag: cuda.DeviceBuffer,
+
+    fn init(d: *cuda.Driver, bytes: usize) !Slot {
+        var s: Slot = .{ .rows = try cuda.DeviceBuffer.alloc(d, bytes), .flag = undefined };
+        errdefer s.rows.free();
+        s.flag = try cuda.DeviceBuffer.alloc(d, 256);
+        try s.flag.fill8(0, null);
+        return s;
+    }
+
+    fn deinit(s: *Slot) void {
+        s.rows.free();
+        s.flag.free();
+    }
+};
+
+/// The two stages' slots and the driver's stream memory operations.
+pub const Pipe = struct {
+    d: *cuda.Driver,
+    io: std.Io,
+    wait: Value,
+    write: Value,
+    on: Slot,
+    back: Slot,
+    /// Rank 1 spoils the first row it takes (a planted control: the check must then fail).
+    plant: bool = false,
+
+    pub fn init(d: *cuda.Driver, io: std.Io, rows: usize, plant: bool) !Pipe {
+        const wait = d.lib.lookup(Value, "cuStreamWaitValue32_v2") orelse return error.MissingSymbol;
+        const write = d.lib.lookup(Value, "cuStreamWriteValue32_v2") orelse return error.MissingSymbol;
+        var on = try Slot.init(d, rows * wide * 2);
+        errdefer on.deinit();
+        return .{ .d = d, .io = io, .wait = wait, .write = write, .on = on, .back = try Slot.init(d, rows * wide * 2), .plant = plant };
+    }
+
+    pub fn deinit(p: *Pipe) void {
+        p.on.deinit();
+        p.back.deinit();
+    }
+};
+
+/// One stage's end of the pipe on its own stream.
+pub const End = struct {
+    pipe: *Pipe,
+    stream: cuda.Stream,
+    out: *Slot,
+    in: *Slot,
+    late: hops.Late = .{},
+    planted: bool = false,
+
+    pub fn hop(e: *End) hops.Hop {
+        return .{ .ctx = e, .take = take, .give = give, .finish = finish, .late = &e.late };
+    }
+
+    fn of(ctx: *anyopaque) *End {
+        return @ptrCast(@alignCast(ctx));
+    }
+
+    fn check(e: *End, r: cuda.abi.Result, what: []const u8) !void {
+        try e.pipe.d.check(r, what);
+    }
+
+    fn give(ctx: *anyopaque, h: u64, rows: usize) anyerror!void {
+        const e = of(ctx);
+        const p = e.pipe;
+        try e.check(p.wait(e.stream.handle, e.out.flag.ptr, 0, wait_eq), "cuStreamWaitValue32");
+        try e.check(p.d.api.cuMemcpyDtoDAsync_v2(e.out.rows.ptr, h, rows * wide * 2, e.stream.handle), "cuMemcpyDtoDAsync");
+        try e.check(p.write(e.stream.handle, e.out.flag.ptr, 1, 0), "cuStreamWriteValue32");
+    }
+
+    fn take(ctx: *anyopaque, h: u64, rows: usize) anyerror!void {
+        const e = of(ctx);
+        const p = e.pipe;
+        try e.check(p.wait(e.stream.handle, e.in.flag.ptr, 1, wait_eq), "cuStreamWaitValue32");
+        try e.check(p.d.api.cuMemcpyDtoDAsync_v2(h, e.in.rows.ptr, rows * wide * 2, e.stream.handle), "cuMemcpyDtoDAsync");
+        try e.check(p.write(e.stream.handle, e.in.flag.ptr, 0, 0), "cuStreamWriteValue32");
+        if (p.plant and e.in == &p.on and !e.planted) {
+            e.planted = true;
+            try e.check(p.d.api.cuMemsetD8Async(h, 0x7f, 64, e.stream.handle), "cuMemsetD8Async");
+        }
+    }
+
+    fn finish(ctx: *anyopaque) anyerror!void {
+        const e = of(ctx);
+        try idle(e.pipe, e.stream);
+    }
+};
+
+/// A host wait for `s` that polls and sleeps: a blocking wait or busy poll keeps the driver lock from the other stage.
+fn idle(p: *const Pipe, s: cuda.Stream) !void {
+    while (true) {
+        const r = p.d.api.cuStreamQuery(s.handle);
+        if (r != cuda.abi.error_not_ready) return p.d.check(r, "cuStreamQuery");
+        p.io.sleep(.fromMicroseconds(50), .awake) catch {};
+    }
+}
+
+/// What one stage runs after its prompt: each window of `tokens`, every row's scores left on the device.
+pub const Job = struct {
+    ctx: *const cuda.Context,
+    pipe: *const Pipe,
+    e: *prompt.Engine,
+    tri: flash.Tri,
+    seq: *prompt.Seq,
+    tokens: []const u32,
+    /// Every window row's scores [tokens.len, vocab], and a window's streams [rows, wide], on the device.
+    out: u64,
+    streams: u64,
+    /// The window it is on, times 4, plus 1 while it issues it, 2 while it waits for its stream, 3 once done.
+    step: std.atomic.Value(u32) = .init(0),
+
+    /// A stage that fails ends the process: the other stage would wait on its flags forever.
+    pub fn run(j: *Job) void {
+        j.go() catch |err| {
+            std.log.err("stage at layer {d}: {t}", .{ j.e.span.first, err });
+            if (@errorReturnTrace()) |t| std.debug.dumpStackTrace(t);
+            std.process.exit(1);
+        };
+    }
+
+    fn go(j: *Job) !void {
+        try j.ctx.makeCurrent();
+        const e = j.e;
+        var at: usize = 0;
+        var i: usize = 0;
+        while (at < j.tokens.len) : (i += 1) {
+            const n = @min(sizes[i % sizes.len], j.tokens.len - at);
+            const out = j.out + at * vocab * 2;
+            j.step.store(@intCast(i * 4 + 1), .release);
+            try e.forward(flash.Tri, j.tri, j.seq, j.tokens[at..][0..n], .{ .logits = .all, .logits_out = out, .streams = j.streams, .host_logits = false });
+            at += n;
+        }
+        j.step.store(j.step.load(.acquire) + 1, .release);
+        try idle(j.pipe, e.stream.*);
+        j.step.store(j.step.load(.acquire) + 1, .release);
+    }
+};
+
+/// Every window row's scores on one engine, eagerly (host scores keep a window off the graph), into `scores`.
+pub fn eager(e: *prompt.Engine, tri: flash.Tri, ids: []const u32, tokens: []const u32, cap: usize, scores: []u8) !void {
+    const d = e.driver;
+    var seq = try e.newSeq(cap);
+    defer seq.deinit(e.gpa);
+    var out = try cuda.DeviceBuffer.alloc(d, flash.mtp.max_rows * vocab * 2);
+    defer out.free();
+    var streams = try cuda.DeviceBuffer.alloc(d, flash.mtp.max_rows * wide * 2);
+    defer streams.free();
+    try e.forward(flash.Tri, tri, &seq, ids, .{});
+    var at: usize = 0;
+    var i: usize = 0;
+    while (at < tokens.len) : (i += 1) {
+        const n = @min(sizes[i % sizes.len], tokens.len - at);
+        try e.forward(flash.Tri, tri, &seq, tokens[at..][0..n], .{ .logits = .all, .logits_out = out.ptr, .streams = streams.ptr, .host_logits = true });
+        try e.stream.synchronize();
+        try cuda.memory.download(d, out.ptr, scores[at * vocab * 2 ..][0 .. n * vocab * 2]);
+        at += n;
+    }
+}
+
+/// Rank 0's window graphs: captured, updated in place and replayed as they were.
+pub const Counts = struct { captures: u64, updates: u64, replays: u64 };
+
+/// Both stages' windows on their own threads and streams; rank 0's scores stay in its job's `out`.
+pub fn stages(jobs: *[2]Job) !Counts {
+    var threads: [2]std.Thread = undefined;
+    threads[1] = try std.Thread.spawn(.{}, Job.run, .{&jobs[1]});
+    threads[0] = std.Thread.spawn(.{}, Job.run, .{&jobs[0]}) catch |err| {
+        threads[1].join();
+        return err;
+    };
+    const io = jobs[0].pipe.io;
+    var waited: usize = 0;
+    while (jobs[0].step.load(.acquire) % 4 != 3 or jobs[1].step.load(.acquire) % 4 != 3) : (waited += 1) {
+        if (waited == 300) {
+            std.log.err("windows stalled: rank 0 at step {d}, rank 1 at step {d}", .{ jobs[0].step.load(.acquire), jobs[1].step.load(.acquire) });
+            std.process.exit(2);
+        }
+        io.sleep(.fromSeconds(1), .awake) catch {};
+    }
+    for (threads) |t| t.join();
+    const g = &jobs[0].e.graphs.window;
+    return .{ .captures = g.captures, .updates = g.updates, .replays = g.replays };
+}
