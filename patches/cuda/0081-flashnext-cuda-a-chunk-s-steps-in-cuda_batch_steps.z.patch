diff --git a/zig/src/families/flashnext/cuda_batch_steps.zig b/zig/src/families/flashnext/cuda_batch_steps.zig
new file mode 100644
index 000000000..fcbe13308
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_batch_steps.zig
@@ -0,0 +1,126 @@
+//! A batched pass's chunk in steps (cuda_batch.zig's Pass): begin, each layer's mixer and experts halves, end.
+const std = @import("std");
+const wt = @import("cuda_prompt_wt.zig");
+const parts = @import("cuda_batch_state.zig");
+const hc = @import("cuda_batch_hc.zig");
+const ep_log = @import("cuda_ep_log.zig");
+const zs = @import("cuda_zero_slice.zig");
+const stage_hop = @import("cuda_batch_hop.zig");
+const batch_lanes = @import("cuda_batch_lanes.zig");
+const Layer = @import("cuda_prompt_load.zig").Layer;
+const Gather = parts.Gather;
+const LayerKeep = parts.LayerKeep;
+const Kernels = parts.Kernels;
+const dims = wt.dims;
+const streams = wt.streams;
+const eps = wt.eps;
+const ple_layer = wt.ple_layer;
+
+/// A chunk's checks, uploads, n-gram gather (after `history`) and first rows, before its layers.
+pub fn begin(p: anytype, ids: []const u32, pos0: usize, gather: *Gather, history: []i64) !void {
+    const s = p.s;
+    const n = ids.len;
+    if (n == 0 or n > s.cap) return error.UnexpectedTensor;
+    if (p.lanes.len > 0) {
+        // shared rounds read every row's scores; a lane keeps its own rollback and hidden rows, nothing else
+        if (p.hooks.logits != .all or p.hooks.keep != null or p.hooks.streams != 0 or p.hooks.moe_add != null) return error.UnexpectedTensor;
+        try batch_lanes.checkLanes(p.lanes, n);
+    } else if (pos0 + n > p.seq.cap) return error.UnexpectedTensor;
+    p.rows = n;
+    p.pos0 = pos0;
+    p.pending = null;
+    p.pending_f32 = false;
+    p.side_wait = false;
+    p.side_wait_out = false;
+    // the gather writes the scratch's pinned rows, so the last pass's uploads must have read them first
+    if (!p.prepared and !p.staged) try s.ready();
+    gather.* = .{ .ngram = p.m.ngram, .history = history, .ids = ids, .emb = s.hostEmb(n), .xs = s.hostXs(n), .io = p.io, .lanes = p.lanes };
+    p.gather_thread = if (p.prepared or p.staged or stage_hop.first(p.m) > 0) null else try std.Thread.spawn(.{}, Gather.main, .{gather});
+    if (!p.staged) try p.stage(ids);
+    try stage_hop.enter(p, n);
+}
+
+/// Joins the chunk's n-gram gather thread, if one still runs.
+pub fn joinGather(p: anytype) void {
+    if (p.gather_thread) |th| th.join();
+    p.gather_thread = null;
+}
+
+/// The pass's stream waits for an exchange still running on the side stream.
+pub fn awaitSide(p: anytype) !void {
+    if (p.side_wait_out) {
+        p.side_wait_out = false;
+        try p.stream.wait(p.side.?.done_out);
+    }
+    if (!p.side_wait) return;
+    p.side_wait = false;
+    try p.stream.wait(p.side.?.done);
+}
+
+/// Layer `layer` (absolute index) over the chunk's rows.
+pub fn layerStep(p: anytype, lw: *const Layer, layer: usize, ids: []const u32, gather: *Gather) !void {
+    try mixerStep(p, lw, layer, ids, gather);
+    try mlpStep(p, lw, layer);
+}
+
+/// A layer's first half: the n-gram block at its layer, the read-out, the mixer and its out projection into part.
+pub fn mixerStep(p: anytype, lw: *const Layer, layer: usize, ids: []const u32, gather: *Gather) !void {
+    const s = p.s;
+    const n = p.rows;
+    try awaitSide(p);
+    const keep: LayerKeep = if (p.hooks.keep) |kp| kp.layers[layer] else .{};
+    if (layer == ple_layer) {
+        joinGather(p);
+        if (gather.failed) |err| return err;
+        if (Kernels.profile()) std.debug.print("batch: {d} rows' n-gram rows gathered on the host in {d:.1} ms\n", .{ n, @as(f64, @floatFromInt(gather.ns)) / 1e6 });
+        if (!p.staged) {
+            try p.upload(s.ple_emb, std.mem.sliceAsBytes(gather.emb));
+            try p.upload(s.ple_xs, std.mem.sliceAsBytes(gather.xs));
+            if (!p.prepared) try s.uploaded();
+        }
+        if (p.pending != null) try p.writeback(0, n);
+        try p.pleBlock(lw, ids);
+    }
+    if (hc.fuses(p, lw.attn_hc, n, keep.attn_hc)) {
+        try hc.writebackNorm(p, lw.attn_hc, 0, n);
+        try hc.readoutNative(p, lw.attn_hc, 0, n);
+    } else {
+        try p.writeback(0, n);
+        try p.readoutKeep(lw.attn_hc, 0, n, keep.attn_hc);
+    }
+    p.zero_slices = zs.usable(p.s.part_zero, keep.mix_branch, p.m.collective != null, lw.out.native != null);
+    if (lw.linear) {
+        try p.gdnBlock(lw, layer, wt.linearIndex(layer), keep);
+    } else {
+        try p.attnBlockKeep(lw, wt.attnIndex(layer), keep);
+    }
+    if (keep.mix_branch != 0) try p.sumSlices(s.part, keep.mix_branch, true, n * dims, p.out_slices);
+}
+
+/// A layer's second half: part written back, the read-out, the experts and their exchange.
+pub fn mlpStep(p: anytype, lw: *const Layer, layer: usize) !void {
+    const s = p.s;
+    const n = p.rows;
+    try awaitSide(p);
+    const keep: LayerKeep = if (p.hooks.keep) |kp| kp.layers[layer] else .{};
+    const sl = zs.slices(p.zero_slices, s.cap, n, p.out_slices);
+    p.zero_slices = false;
+    if (hc.fuses(p, lw.mlp_hc, n, keep.mlp_hc)) {
+        try p.tri.hcWritebackNorm(s.h, s.h, s.pss, s.part, s.inj, s.dummy, s.dummy, lw.mlp_hc.scale.ptr, s.norm, eps, sl.stride, n, dims, streams, 4, 1, 1, sl.count);
+        try hc.readoutNative(p, lw.mlp_hc, 0, n);
+    } else {
+        try p.tri.hcWriteback(s.h, s.h, s.pss, s.part, "*fp32", s.inj, s.dummy, "*bf16", s.dummy, "*bf16", sl.stride, n, dims, streams, 4, 1, 1, sl.count);
+        try p.readoutKeep(lw.mlp_hc, 0, n, keep.mlp_hc);
+    }
+    try p.moeBlockKeep(lw, keep);
+    if (ep_log.on) try ep_log.layer(p, layer);
+    try p.moeAdds(layer, keep);
+    p.pending = layer;
+}
+
+/// After the last layer: the head (or the next stage).
+pub fn end(p: anytype, logits_host: ?[]u8) !void {
+    try awaitSide(p);
+    try stage_hop.leave(p, logits_host);
+    if (ep_log.on) try ep_log.window(p);
+}
