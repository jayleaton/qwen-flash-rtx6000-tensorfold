 zig/src/families/flashnext/cuda_disk.zig      |  4 +-
 zig/src/families/flashnext/cuda_lanes.zig     |  2 +
 .../families/flashnext/cuda_lanes_snap.zig    |  6 +-
 .../flashnext/cuda_paging_snap_test.zig       | 47 +++++++++++++--
 .../families/flashnext/cuda_rank_engine.zig   |  4 +-
