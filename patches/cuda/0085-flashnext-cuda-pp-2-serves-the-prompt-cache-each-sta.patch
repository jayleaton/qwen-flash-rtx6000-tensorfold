+
+test "a pipeline stage's state holds its own layers only, and restores them in the order it saved them" {
+    var d = Fake.driver();
+    const stream: cuda.Stream = .{ .d = &d, .handle = null };
+    const Span = @import("cuda_span.zig").Span;
+    const stages = [2]Span{ try Span.ofRank(24, 0), try Span.ofRank(24, 1) };
+    const tail = wt.ple_tail_n * wt.wide * 2;
+    try std.testing.expectEqual(snap.bytes(150, false, .full) + tail, snap.stageBytes(150, false, .full, stages[0]) + snap.stageBytes(150, false, .full, stages[1]));
+    const sp = stages[1];
+    var lin: [2][wt.linear_n]cuda.DeviceBuffer = undefined;
+    var att: [4][wt.attn_n]cuda.DeviceBuffer = undefined;
+    for (&lin, 0..) |*arr, k| for (arr, 0..) |*b, i| {
+        const own = sp.owns(@import("cuda_span.zig").Kind.linear.layer(i));
+        b.* = .{ .d = &d, .ptr = if (own) 0x10_0000 * (k + 1) + i * 0x1000 else 0, .len = 0, .borrowed = true };
+    };
+    for (&att, 0..) |*arr, k| for (arr, 0..) |*b, i| {
+        const own = sp.owns(@import("cuda_span.zig").Kind.attn.layer(i));
+        b.* = .{ .d = &d, .ptr = if (own) 0x100_0000 * (k + 1) + i * 0x1000 else 0, .len = 0, .borrowed = true };
+    };
+    var seq: prompt.Seq = .{ .conv = &lin[0], .state = &lin[1], .kc = &att[0], .vc = &att[1], .ikc = &att[2], .pooled = &att[3], .tail = .{ .d = &d, .ptr = 0x9000_0000, .len = 0, .borrowed = true }, .history = .{ 5, 9 }, .fed = 150, .logits = &.{}, .cap = 200 };
+    const kept = try snap.save(std.testing.allocator, &d, null, stream, &seq, null, sp);
+    defer snap.drop(std.testing.allocator, stream, kept);
+    const saved = Fake.copies;
+    const n = Fake.n;
+    var off: u64 = 0;
+    for (saved[0..n]) |c| {
+        try std.testing.expectEqual(kept.buf.ptr + off, c[0]);
+        try std.testing.expect(c[1] != 0); // no layer another stage holds
+        off += c[2];
+    }
+    try std.testing.expectEqual(@as(u64, snap.stageBytes(150, false, .full, sp)), off);
+    try std.testing.expectEqual(sp, kept.span);
+    seq.fed = 0;
+    Fake.n = 0;
+    try snap.restore(stream, &seq, null, kept);
+    try std.testing.expectEqual(n, Fake.n);
+    for (saved[0..n], Fake.copies[0..n]) |s, r| try std.testing.expectEqual([3]u64{ s[1], s[0], s[2] }, r);
+    try std.testing.expectEqual(@as(usize, 150), seq.fed);
+}
