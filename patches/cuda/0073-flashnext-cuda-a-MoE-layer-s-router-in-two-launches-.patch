+    /// logits for up to 16 rows over 8 experts a one-warp block: few's tiles and mma chains, each logit's bits.
+    pub fn logitsSpread(g: *const RouteRows, s: Stream, x: u64, x_ld: usize, w: u64, out: u64, rows: usize, d: usize, e: usize) !void {
+        if (d % 16 != 0 or x_ld % 8 != 0 or x % 16 != 0 or w % 16 != 0 or rows > 16) return error.RowShape;
+        if (rows == 0 or e == 0) return;
+        var a: launch_.Args = .{};
+        a.add(x);
+        a.add(@as(i32, @intCast(x_ld)));
+        a.add(w);
+        a.add(out);
+        for ([_]usize{ rows, d, e }) |v| a.add(@as(i32, @intCast(v)));
+        try launch_.launch(g.spread_fn, .{ .grid = .{ .x = 1, .y = @intCast((e + 7) / 8), .z = 1 }, .block = .{ .x = 32 }, .shared = spread_shared }, s, &a);
+    }
+
+    /// topkPlan's plan: picks as a rank's ids into `own` (`local` from `first`; null: as picked), `tile`-pair items.
+    pub const Planned = struct { first: usize = 0, local: ?usize, own: u64 = 0, experts: usize, tile: usize, plan: grouped.Plan };
+
+    /// topk, then the picks' plan (fn_ep_picks and experts.route's one block when `local` is set), in one launch.
+    pub fn topkPlan(g: *const RouteRows, s: Stream, l: u64, ld: usize, experts: usize, top_k: usize, picks: u64, wts: u64, slots: usize, rows: usize, shared: bool, p: Planned) !void {
+        const need = experts + @intFromBool(shared);
+        if (experts > most_experts or top_k == 0 or top_k > most_picks or top_k > experts or slots != top_k + @intFromBool(shared) or ld < need) return error.RowShape;
+        if (rows * slots > grouped.small or p.experts == 0 or p.experts > grouped.max_experts or p.tile == 0 or (p.local != null and p.own == 0)) return error.RowShape;
+        if (rows == 0) return;
+        var a: launch_.Args = .{};
+        a.add(l);
+        for ([_]usize{ ld, experts, top_k }) |v| a.add(@as(i32, @intCast(v)));
+        a.add(picks);
+        a.add(wts);
+        for ([_]usize{ slots, @intFromBool(shared), rows, p.first }) |v| a.add(@as(i32, @intCast(v)));
+        a.add(if (p.local) |n| @as(i32, @intCast(n)) else -1);
+        a.add(p.own);
+        a.add(@as(i32, @intCast(p.experts)));
+        a.add(@as(i32, @intCast(p.tile)));
+        for ([_]u64{ p.plan.members, p.plan.items, p.plan.counts }) |v| a.add(v);
+        try launch_.launch(g.topk_plan_fn, .{ .grid = .{ .x = 1, .y = 1, .z = 1 }, .block = .{ .x = 1024 } }, s, &a);
+    }
