diff --git a/zig/kernels/cuda/route_rows.cu b/zig/kernels/cuda/route_rows.cu
index 8190cf709..522174b7a 100644
--- a/zig/kernels/cuda/route_rows.cu
+++ b/zig/kernels/cuda/route_rows.cu
@@ -42,6 +42,84 @@ __device__ __forceinline__ void block_best(float& v, int& i, float (*sv)[NT / 32
         }
 }
 
+// block_best over one group of NT threads (named barrier `bar`): the same tree, so groups can take rows side by side.
+__device__ __forceinline__ void group_best(float& v, int& i, float (*sv)[NT / 32], int (*si)[NT / 32], int parity, int bar) {
+    for (int off = 16; off > 0; off >>= 1) {
+        const float ov = __shfl_xor_sync(0xffffffffu, v, off);
+        const int oi = __shfl_xor_sync(0xffffffffu, i, off);
+        if (ov > v || (ov == v && oi < i)) {
+            v = ov;
+            i = oi;
+        }
+    }
+    const int warp = (threadIdx.x % NT) >> 5;
+    if ((threadIdx.x & 31) == 0) {
+        sv[parity][warp] = v;
+        si[parity][warp] = i;
+    }
+    asm volatile("bar.sync %0, %1;" ::"r"(bar), "r"(NT) : "memory");
+    v = sv[parity][0];
+    i = si[parity][0];
+    for (int w = 1; w < NT / 32; ++w)
+        if (sv[parity][w] > v || (sv[parity][w] == v && si[parity][w] < i)) {
+            v = sv[parity][w];
+            i = si[parity][w];
+        }
+}
+
+constexpr int PLAN_NT = 1024, GROUPS = PLAN_NT / NT, PLAN_E = 1024, PLAN_P = 1024;  // experts.cu's one-block plan
+
+// experts.cu's place_items: expert tid's count c into items of at most T pairs; returns its first member slot.
+__device__ __forceinline__ int place_items(int c, int E, int T, int* __restrict__ items, int* __restrict__ counts) {
+    __shared__ int wsum[3][32];
+    const int tid = threadIdx.x, lane = tid & 31, warp = tid >> 5;
+    const int tiles = (c + T - 1) / T;
+    int a = c, b = tiles, u = c > 0;
+#pragma unroll
+    for (int o = 1; o < 32; o <<= 1) {
+        const int ua = __shfl_up_sync(0xffffffffu, a, o), ub = __shfl_up_sync(0xffffffffu, b, o);
+        const int uu = __shfl_up_sync(0xffffffffu, u, o);
+        if (lane >= o) {
+            a += ua;
+            b += ub;
+            u += uu;
+        }
+    }
+    if (lane == 31) {
+        wsum[0][warp] = a;
+        wsum[1][warp] = b;
+        wsum[2][warp] = u;
+    }
+    __syncthreads();
+    if (warp == 0) {
+#pragma unroll
+        for (int s = 0; s < 3; ++s) {
+            int v = wsum[s][lane];
+#pragma unroll
+            for (int o = 1; o < 32; o <<= 1) {
+                const int w = __shfl_up_sync(0xffffffffu, v, o);
+                if (lane >= o) v += w;
+            }
+            wsum[s][lane] = v;
+        }
+    }
+    __syncthreads();
+    const int off = (warp ? wsum[0][warp - 1] : 0) + a - c;
+    const int ioff = (warp ? wsum[1][warp - 1] : 0) + b - tiles;
+    if (tid == 0) {
+        counts[0] = wsum[1][31];
+        counts[1] = wsum[2][31];
+    }
+    if (tid < E)
+        for (int j = 0; j < tiles; ++j) {
+            int* it = items + 3 * (ioff + j);
+            it[0] = tid;
+            it[1] = off + T * j;
+            it[2] = min(T, c - T * j);
+        }
+    return off;
+}
+
 }  // namespace tf_route
 
 using namespace tf_route;
@@ -67,6 +145,13 @@ extern "C" __global__ void __launch_bounds__(128) tf_route_logits_few(const __nv
     tf_router_mma::logits<4, 3, 256>(X, x_ld, W, OUT, M, D, E);
 }
 
+// tf_route_logits_few's sums over 8 experts a one-warp block: each logit the same tile and mma chain, 4x the blocks.
+extern "C" __global__ void __launch_bounds__(32) tf_route_logits_spread(const __nv_bfloat16* __restrict__ X, int x_ld,
+                                                                       const __nv_bfloat16* __restrict__ W, float* __restrict__ OUT,
+                                                                       int M, int D, int E) {
+    tf_router_mma::logits<1, 6, 256>(X, x_ld, W, OUT, M, D, E);
+}
+
 // A row's TOPK largest of NE logits (lower id on ties), bf16(e^(l_k - l_0) / sum); `shared`: slot TOPK gated by NE.
 extern "C" __global__ void __launch_bounds__(NT) tf_route_topk(const float* __restrict__ L, int NL, int NE, int TOPK,
                                                                int* __restrict__ PICK, float* __restrict__ WTS, int SLOTS,
@@ -115,3 +200,84 @@ extern "C" __global__ void __launch_bounds__(NT) tf_route_topk(const float* __re
         WTS[static_cast<long long>(r) * SLOTS + TOPK] = rbf(tf_sigmoid(rbf(row[NE])));
     }
 }
+
+// tf_route_topk's R rows (8 groups side by side), fn_ep_picks into OWN (local >= 0), then experts.cu's plan_kernel.
+extern "C" __global__ void __launch_bounds__(PLAN_NT) tf_route_topk_plan(const float* __restrict__ L, int NL, int NE, int TOPK,
+                                                                         int* __restrict__ PICK, float* __restrict__ WTS, int SLOTS,
+                                                                         int shared, int R, int first, int local,
+                                                                         int* __restrict__ OWN, int E, int T,
+                                                                         int* __restrict__ members, int* __restrict__ items,
+                                                                         int* __restrict__ counts) {
+    __shared__ float sv[GROUPS][2][NT / 32];
+    __shared__ int si[GROUPS][2][NT / 32];
+    __shared__ int pk[PLAN_P];
+    __shared__ int cnt[PLAN_E];
+    __shared__ int off[PLAN_E];
+    const int grp = threadIdx.x / NT, lt = threadIdx.x % NT;
+    for (int e = threadIdx.x; e < PLAN_E; e += PLAN_NT) cnt[e] = 0;
+    for (int r = grp; r < R; r += GROUPS) {
+        const float* row = L + static_cast<long long>(r) * NL;
+        float v[MOST];
+#pragma unroll
+        for (int j = 0; j < MOST; ++j) {
+            const int i = lt + j * NT;
+            v[j] = i < NE ? row[i] : -INFINITY;
+        }
+        float top = 0.0f, total = 0.0f, mine = 0.0f;
+        int pick = 0;
+        for (int k = 0; k < TOPK; ++k) {
+            float bv = -INFINITY;
+            int bi = 0x7fffffff;
+#pragma unroll
+            for (int j = 0; j < MOST; ++j) {
+                const int i = lt + j * NT;
+                if (v[j] > bv || (v[j] == bv && i < bi)) {
+                    bv = v[j];
+                    bi = i;
+                }
+            }
+            group_best(bv, bi, sv[grp], si[grp], k & 1, 1 + grp);
+            if (k == 0) top = bv;
+#pragma unroll
+            for (int j = 0; j < MOST; ++j)
+                if (lt + j * NT == bi) v[j] = -INFINITY;
+            const float ex = tf_exp(__fsub_rn(bv, top));
+            total = __fadd_rn(total, ex);
+            if (lt == k) {
+                mine = ex;
+                pick = bi;
+            }
+        }
+        if (lt < TOPK) {
+            PICK[static_cast<long long>(r) * SLOTS + lt] = pick;
+            WTS[static_cast<long long>(r) * SLOTS + lt] = rbf(__fdiv_rn(mine, total));
+            pk[r * SLOTS + lt] = pick;
+        }
+        if (shared && lt == 0) {
+            PICK[static_cast<long long>(r) * SLOTS + TOPK] = NE;
+            WTS[static_cast<long long>(r) * SLOTS + TOPK] = rbf(tf_sigmoid(rbf(row[NE])));
+            pk[r * SLOTS + TOPK] = NE;
+        }
+    }
+    __syncthreads();
+    const int P = R * SLOTS;
+    for (int p = threadIdx.x; p < P; p += PLAN_NT) {
+        int e = pk[p];
+        if (local >= 0) {
+            e = e >= first && e < first + local ? e - first : local;
+            OWN[p] = e;
+            pk[p] = e;
+        }
+        atomicAdd(&cnt[e], 1);
+    }
+    __syncthreads();
+    const int o = place_items(threadIdx.x < E ? cnt[threadIdx.x] : 0, E, T, items, counts);
+    if (threadIdx.x < E) off[threadIdx.x] = o;
+    __syncthreads();
+    for (int p = threadIdx.x; p < P; p += PLAN_NT) {
+        const int e = pk[p];
+        int rank = 0;
+        for (int q = 0; q < p; ++q) rank += pk[q] == e;
+        members[off[e] + rank] = p;
+    }
+}
