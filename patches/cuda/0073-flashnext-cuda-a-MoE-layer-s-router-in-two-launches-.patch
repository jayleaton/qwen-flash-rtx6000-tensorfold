--- /dev/null
+++ b/zig/src/families/flashnext/cuda_route_fused.zig
@@ -0,0 +1,43 @@
+//! TF_FLASHNEXT_ROUTE_FUSED: a native layer's router in two launches for passes of up to 16 rows, the same bits.
+const cuda = @import("cuda");
+const wt = @import("cuda_prompt_wt.zig");
+const glue_ = @import("cuda_glue.zig");
+const mixed = @import("cuda_mixed_experts.zig");
+const moe_native = @import("cuda_moe_native.zig");
+
+/// TF_FLASHNEXT_ROUTE_FUSED as read at load; off keeps the logits, top-k, own-picks and plan launches.
+pub var on = false;
+
+pub fn enabled() !bool {
+    return @import("sys").environment.read(bool, "TF_FLASHNEXT_ROUTE_FUSED", false);
+}
+
+/// The rows tf_route_logits_few takes, whose tiles the spread logits keep.
+pub const most_rows = 16;
+
+/// Our glue when it owns both router launches (a captured set's would sum otherwise), else null.
+fn ours(t: anytype) ?*const glue_.Glue {
+    if (!@hasField(@TypeOf(t), "own") or !@hasField(@TypeOf(t), "set")) return null;
+    if (t.set == null) return t.own;
+    const g = t.own orelse return null;
+    const bits = glue_.entryBit("_router") | glue_.entryBit("_topk_rows");
+    return if (g.mixed & bits == bits) g else null;
+}
+
+/// Whether a pass of `n` rows takes the fused router: the switch on, few's rows, our glue and a format run plans.
+pub fn takes(t: anytype, k: anytype, native: *const mixed.Owned, n: usize) ?*const glue_.Glue {
+    if (!on or n == 0 or n > most_rows or moe_native.routeTile(k, &native.experts, n) == null) return null;
+    return ours(t);
+}
+
+/// moeBlockKeep's router, top-k, own picks and plan for a native layer: the spread logits, then tf_route_topk_plan.
+pub fn run(self: anytype, native: *const mixed.Owned, n: usize, router_w: u64, plan: cuda.grouped.Plan) !bool {
+    const g = takes(self.tri, self.k, native, n) orelse return false;
+    const s = self.s;
+    const owned = &native.experts;
+    const st = self.tri.s;
+    try g.route.logitsSpread(st, s.mixed, wt.dims, router_w, s.router_l, n, wt.dims, wt.experts_n + 1);
+    const p: cuda.route_rows.RouteRows.Planned = .{ .first = owned.first, .local = if (native.world == 1) null else owned.count, .own = s.picks_ep, .experts = owned.count + 1, .tile = moe_native.routeTile(self.k, owned, n).?, .plan = plan };
+    try g.route.topkPlan(st, s.router_l, wt.experts_n + 1, wt.experts_n, wt.slots - 1, s.picks, s.wts, wt.slots, n, true, p);
+    return true;
+}
