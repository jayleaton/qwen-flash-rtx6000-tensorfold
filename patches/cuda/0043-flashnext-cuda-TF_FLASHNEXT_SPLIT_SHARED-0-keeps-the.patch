From: Jay Leaton <58495321+jayleaton@users.noreply.github.com>
Date: Fri, 20 Nov 2026 19:26:53 +0700
Subject: [PATCH 43/46] flashnext cuda: TF_FLASHNEXT_SPLIT_SHARED=0 keeps the
 dense split but runs the shared expert whole on rank 0, one gather a layer
 fewer

---
 docs/environment.md                             |  1 +
 zig/src/families/flashnext/cuda_dense_split.zig | 10 ++++++++++
 zig/src/families/flashnext/cuda_prompt_load.zig |  2 +-
 zig/src/families/flashnext/cuda_rank_engine.zig |  3 ++-
 zig/src/families/flashnext/cuda_rank_memory.zig |  2 +-
 zig/src/platform/environment.zig                |  1 +
 zig/src/platform/environment_flashnext_test.zig |  5 +++--
 7 files changed, 19 insertions(+), 5 deletions(-)

diff --git a/docs/environment.md b/docs/environment.md
index 91006c8f2..b2cf4454b 100644
--- a/docs/environment.md
+++ b/docs/environment.md
@@ -151,6 +151,7 @@ stops the start with the variable, the supplied text and the accepted forms.
 | `TF_FLASHNEXT_KEEP_LATE` | Exactly `0` or `1`; unset or blank leaves the choice to the loader |
 | `TF_FLASHNEXT_DECODE_GRAPH` | Exactly `0` or `1`; default off |
 | `TF_FLASHNEXT_SPLIT_DENSE` | Exactly `0` or `1`; default on: two ranks split the BF16 dense projections |
+| `TF_FLASHNEXT_SPLIT_SHARED` | Exactly `0` or `1`; default on: under the dense split the shared expert is split too, with one gather a layer. `0` runs it whole on rank 0 instead, as without the split. Give every rank the same value. |
 | `TF_FLASHNEXT_SHARD_HEAD` | Exactly `0` or `1`; default off: each rank keeps its half of the output head |
 | `TF_FLASHNEXT_ATTN_LANES` | Exactly `0` or `1`; default off |
 | `TF_FLASHNEXT_WARM_AHEAD` | Exactly `0` or `1`; default off |
diff --git a/zig/src/families/flashnext/cuda_dense_split.zig b/zig/src/families/flashnext/cuda_dense_split.zig
index 3c4a27580..2503db477 100644
--- a/zig/src/families/flashnext/cuda_dense_split.zig
+++ b/zig/src/families/flashnext/cuda_dense_split.zig
@@ -27,6 +27,16 @@ pub fn setting(value: ?[]const u8) !bool {
     return @import("sys").environment.value(bool, "TF_FLASHNEXT_SPLIT_DENSE", value, true) catch return error.BadDenseSplit;
 }
 
+/// TF_FLASHNEXT_SPLIT_SHARED: unset, blank or 1 splits the shared expert too; 0 runs it whole on rank 0.
+pub fn sharedSplit() !bool {
+    return @import("sys").environment.read(bool, "TF_FLASHNEXT_SPLIT_SHARED", true) catch return error.BadDenseSplit;
+}
+
+/// A shared expert projection, which TF_FLASHNEXT_SPLIT_SHARED=0 keeps whole on rank 0 under the split.
+pub fn isShared(name: []const u8) bool {
+    return std.mem.indexOf(u8, name, ".mlp.shared_expert.") != null;
+}
+
 pub fn enabled() !bool {
     return setting(@import("sys").getenv("TF_FLASHNEXT_SPLIT_DENSE"));
 }
