diff --git a/docs/environment.md b/docs/environment.md
index 4a5e50beb..d177452de 100644
--- a/docs/environment.md
+++ b/docs/environment.md
@@ -175,6 +175,7 @@ stops the start with the variable, the supplied text and the accepted forms.
 | `TF_FLASHNEXT_PP_SPEC_LOG` | Exactly `0` or `1`; default off. `1` prints each guessing stream's guesses, hits, misses and rows rolled back when it ends |
 | `TF_FLASHNEXT_TP_WINDOW_GRAPH` | Exactly `0` or `1`; default off. `1`: at `--tp 2` the drafted verify windows run as CUDA graphs on both ranks with their collectives captured, whatever `TF_FLASHNEXT_WINDOW_GRAPH` says; `TF_FLASHNEXT_PEER_SLOTS`' epoch moves to the device so a replay advances it. Same kernels and bits as the eager pass. Give every rank the same value. |
 | `TF_FLASHNEXT_PEER_SLOTS` | Exactly `0` or `1`; default off. At `--tp 2` on one host, a pass of up to 128 rows exchanges its MoE slots by writing each rank's own experts' rows (and its half of the shared expert's) into the peer's mapped buffer, about half the bytes of the all-reduce or reduce-scatter, with the same sums. Refused across hosts and with `TF_FLASHNEXT_DECODE_GRAPH`. Give every rank the same value. |
+| `TF_FLASHNEXT_GATHER_SLOTS` | Exactly `0` or `1`; default off. With `TF_FLASHNEXT_PEER_SLOTS=1` at `--tp 2`, a pass of up to 128 rows moves the out projection's two gathers (each rank's heads before it, each rank's output columns after it) by writing into the peer's mapped buffer and waiting on its flag instead of NCCL: the same bytes in the same places, so the same bits. Inert without `TF_FLASHNEXT_PEER_SLOTS` and outside `--tp 2`. Give every rank the same value. |
 | `TF_FLASHNEXT_READOUT_ROWS` | Whole row count; default 64; `0` never takes the tiles |
 | `TF_FLASHNEXT_CHUNK` | Whole prompt rows a pass, 1 through 16384; default 3072 |
 | `TF_FLASHNEXT_PP_SPLIT` | At `--pp 2`, rank 1's first layer, 2 through 47; default 24. Rank 0 holds the layers before it, the embedding and the head. Give both ranks the same value. |
diff --git a/zig/kernels/cuda/flashnext_peer.cuh b/zig/kernels/cuda/flashnext_peer.cuh
index 940363239..4c72ef65b 100644
--- a/zig/kernels/cuda/flashnext_peer.cuh
+++ b/zig/kernels/cuda/flashnext_peer.cuh
@@ -119,3 +119,23 @@ extern "C" __global__ void __launch_bounds__(128) fn_peer_rows_add(float4* __res
         dst[base + c] = make_float4(a.x + b.x, a.y + b.y, a.z + b.z, a.w + b.w);
     }
 }
+
+// Rows (one block each) of [rows, 2q] dst: this rank's q float4s at block `rank`, then the peer's from rx: a gather.
+extern "C" __global__ void __launch_bounds__(128) fn_peer_rows_take(float4* __restrict__ dst, const float4* __restrict__ own,
+                                                                    const float4* rx, int q, int rank,
+                                                                    volatile unsigned* __restrict__ flag, unsigned epoch,
+                                                                    const unsigned* ep, long long half) {
+    epoch = fn_peer_epoch(ep, epoch, 0u);
+    rx += (epoch & 1u) * half;
+    const long long base = static_cast<long long>(blockIdx.x) * q;
+    float4* row = dst + 2 * base;
+    for (int c = threadIdx.x; c < q; c += blockDim.x) row[rank * q + c] = own[base + c];
+    if (threadIdx.x == 0) {
+        const long long start = clock64();
+        while (static_cast<int>(*flag - epoch) < 0)
+            if (clock64() - start > (1ll << 35)) __trap();  // about 15 s: the peer is gone, fail rather than hang
+        __threadfence();
+    }
+    __syncthreads();
+    for (int c = threadIdx.x; c < q; c += blockDim.x) row[(1 - rank) * q + c] = rx[base + c];
+}
