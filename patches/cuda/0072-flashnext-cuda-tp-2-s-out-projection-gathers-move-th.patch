diff --git a/zig/src/families/flashnext/cuda_peer_slots.zig b/zig/src/families/flashnext/cuda_peer_slots.zig
index fb4fd009d..6715d09a2 100644
--- a/zig/src/families/flashnext/cuda_peer_slots.zig
