 }
 
+/// TF_FLASHNEXT_GATHER_SLOTS as read at load: with this buffer, the out projection's two gathers move through it.
+pub var gather_on = false;
+
+/// TF_FLASHNEXT_GATHER_SLOTS: unset, blank or 0 keeps NCCL's gathers; 1 writes them into the peer's buffer.
+pub fn gatherEnabled() !bool {
+    return platform.environment.read(bool, "TF_FLASHNEXT_GATHER_SLOTS", false) catch return error.BadPeerSlots;
+}
+
 /// Rows a pass exchanges this way (a decode round's or verify window's); longer passes keep the collective.
 pub const rows: usize = 128;
 const quads = wt.dims / 4;
@@ -124,6 +132,32 @@ pub const PeerSlots = struct {
         try cuda.launch.launch(add_fn, grid, stream, &b);
     }
 
+    /// `n` rows of `width` bytes at `own` to the peer, then [n, 2 * width] at `dst`, rank 0's block first.
+    pub fn gatherRows(p: *PeerSlots, send_fn: cuda.Function, take_fn: cuda.Function, stream: cuda.Stream, own: u64, dst: u64, width: usize, n: usize) !void {
+        if (n == 0 or n > rows or width % 16 != 0 or n * width > half) return error.UnexpectedTensor;
+        p.epoch +%= 1;
+        const rx = p.parity();
+        const q: i32 = @intCast(width / 16);
+        const grid: cuda.launch.Config = .{ .grid = .{ .x = @intCast(n) }, .block = .{ .x = 128 } };
+        var a: cuda.Args = .{};
+        a.add(own);
+        a.add(p.peer + rx);
+        a.add(q);
+        a.add(p.local + counter_at);
+        a.add(p.peer + flag_at);
+        p.stamp(&a);
+        try cuda.launch.launch(send_fn, grid, stream, &a);
+        var b: cuda.Args = .{};
+        b.add(dst);
+        b.add(own);
+        b.add(p.local + rx);
+        b.add(q);
+        b.add(@as(i32, @intCast(p.rank)));
+        b.add(p.local + flag_at);
+        p.stamp(&b);
+        try cuda.launch.launch(take_fn, grid, stream, &b);
+    }
+
     /// The receive half this exchange writes: the host's parity, or 0 when the kernels choose it from the device epoch.
     fn parity(p: *const PeerSlots) u64 {
         return if (p.device) 0 else (p.epoch & 1) * half;
