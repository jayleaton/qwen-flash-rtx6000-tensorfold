+test "split out lane: gather slots move the two gathers as peer writes to the same places; past the buffer's rows NCCL's" {
+    if (builtin.os.tag == .windows) return error.SkipZigTest;
+    const peer_slots = @import("cuda_peer_slots.zig");
+    var r: Rig = undefined;
+    try r.init();
+    defer r.deinit();
+    defer peer_slots.gather_on = false;
+    peer_slots.gather_on = true;
+    for ([_]usize{ 1, 7, peer_slots.rows, peer_slots.rows + 1 }) |n| for (0..2) |rank| {
+        r.c.rank = rank;
+        r.c.peer = .{ .lib = undefined, .ipc = undefined, .d = &r.d, .local = 0xa000_0000, .peer = 0xb000_0000, .rank = rank };
+        const lw = r.layer(out_k, true, try Cut.init(dims, 2, rank));
+        var p = r.pass(n, true);
+        Rec.n = 0;
+        try std.testing.expectEqual(@as(usize, 1), try split_lane.out(&p, x_at, 0x20, &lw));
+        const calls = recorded();
+        if (n > peer_slots.rows) {
+            try std.testing.expect(calls[0].kind == .gather);
+            continue;
+        }
+        // heads out and in at [n, out_k], the product from them, then its columns out and in at part's [n, dims]
+        const want = [_]Call{
+            .{ .kind = .launch, .f = send_id, .a = .{ x_at, 0, out_k / 2 * 2 / 16, 0, 0, 0 } },
+            .{ .kind = .launch, .f = take_id, .a = .{ @intCast(r.s.rank_input), x_at, out_k / 2 * 2 / 16, @intCast(rank), 0, 0 } },
+            .{ .kind = .launch, .f = send_id, .a = .{ @intCast(r.s.rank_output), 0, dims / 2 * 4 / 16, 0, 0, 0 } },
+            .{ .kind = .launch, .f = take_id, .a = .{ part_at, @intCast(r.s.rank_output), dims / 2 * 4 / 16, @intCast(rank), 0, 0 } },
+        };
+        var got: [4]Call = undefined;
+        var i: usize = 0;
+        for (calls) |c| {
+            try std.testing.expect(c.kind == .launch and c.f != copy_id);
+            if (c.f == send_id or c.f == take_id) {
+                got[i] = c;
+                i += 1;
+            } else if (c.f == qmmf_id) {
