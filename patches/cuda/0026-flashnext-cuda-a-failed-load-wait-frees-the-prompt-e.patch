From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Scott Biggart <swbiggart@users.noreply.github.com>
Date: Thu, 12 Nov 2026 07:38:25 -0800
Subject: [PATCH 26/46] flashnext cuda: a failed load wait frees the prompt
 engine

---
 zig/src/families/flashnext/cuda_lanes_load.zig      | 2 +-
 zig/src/families/flashnext/cuda_rank_start_test.zig | 6 ++++--
 zig/tests/fixtures/gradient-serving.tsv             | 2 +-
 3 files changed, 6 insertions(+), 4 deletions(-)

diff --git a/zig/src/families/flashnext/cuda_lanes_load.zig b/zig/src/families/flashnext/cuda_lanes_load.zig
index 1f0ba55c7..30b3dceec 100644
--- a/zig/src/families/flashnext/cuda_lanes_load.zig
+++ b/zig/src/families/flashnext/cuda_lanes_load.zig
@@ -62,13 +62,13 @@ pub fn open(comptime F: type, gpa: std.mem.Allocator, io: std.Io, ctx: *const cu
         r.deinit();
     };
     own.engine = try prompt.Engine.initRank(gpa, io, driver, &own.stream, dir, o.tp, o.rank);
+    errdefer own.engine.deinit();
     own.engine.chunk = chunk;
     if (own.ranks) |r| {
         r.engine = own.engine;
         own.engine.collective = &r.collective;
         try r.afterLoad(io, ctx, own.stream);
     }
-    errdefer own.engine.deinit();
     const e = own.engine;
     if (e.chunk != e.busy_chunk) std.log.info("flashnext: prompt passes of {d} rows, {d} while another stream decodes", .{ e.chunk, e.busy_chunk });
     if (o.vision) |limits| {
diff --git a/zig/src/families/flashnext/cuda_rank_start_test.zig b/zig/src/families/flashnext/cuda_rank_start_test.zig
index a8f9d4b1c..50f9a2b08 100644
--- a/zig/src/families/flashnext/cuda_rank_start_test.zig
+++ b/zig/src/families/flashnext/cuda_rank_start_test.zig
@@ -90,8 +90,10 @@ test "rank start: a peer that closes its link during the wait ends it at once, b
     }
 }
 
-test "rank start: the loader's first collective waits for the peer's load" {
+test "rank start: the loader's first collective waits for the peer's load, and a failed wait frees the engine" {
     const load = @embedFile("cuda_lanes_load.zig");
     try std.testing.expect(std.mem.indexOf(u8, load, "benchmark_group.") == null);
-    try std.testing.expect(std.mem.indexOf(u8, load, "try r.afterLoad(io, ctx, own.stream);") != null);
+    const wait = std.mem.indexOf(u8, load, "try r.afterLoad(io, ctx, own.stream);") orelse return error.TestUnexpectedResult;
+    const free = std.mem.indexOf(u8, load, "errdefer own.engine.deinit();") orelse return error.TestUnexpectedResult;
+    try std.testing.expect(free < wait);
 }
