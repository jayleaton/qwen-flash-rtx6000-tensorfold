From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jay Leaton <58495321+jayleaton@users.noreply.github.com>
Date: Mon, 23 Nov 2026 15:00:38 +0700
Subject: [PATCH 53/76] flashnext cuda: the collective's NCCL entry-point check
 takes the prompt exchange's grouped send and receive

---
 zig/src/families/flashnext/cuda_collective.zig | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/zig/src/families/flashnext/cuda_collective.zig b/zig/src/families/flashnext/cuda_collective.zig
index 3c86ffeeb..a7ab12b34 100644
--- a/zig/src/families/flashnext/cuda_collective.zig
+++ b/zig/src/families/flashnext/cuda_collective.zig
@@ -417,7 +417,8 @@ test "this file calls NCCL only to start, poll and abort, and for collectives NC
     const allowed = [_][]const u8{
         "ncclGetUniqueId",       "ncclCommInitRankConfig", "ncclCommSplit", "ncclCommAbort",
         "ncclCommGetAsyncError", "ncclAllGather",          "ncclBroadcast", "ncclAllReduce",
-        "ncclReduceScatter",
+        "ncclReduceScatter",     "ncclGroupStart",         "ncclGroupEnd",  "ncclSend",
+        "ncclRecv",
     };
     inline for (@typeInfo(Advanced).@"struct".field_names) |name| {
         var known = false;
@@ -435,5 +436,5 @@ test "this file calls NCCL only to start, poll and abort, and for collectives NC
         try std.testing.expect(known);
         at = i + needle.len;
     }
-    try std.testing.expectEqual(@as(usize, 11), calls);
+    try std.testing.expectEqual(@as(usize, 17), calls);
 }
