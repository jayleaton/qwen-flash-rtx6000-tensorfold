index 000000000..0e4eb73d5
--- /dev/null
+++ b/zig/tests/cuda/flashnext_snap_host_tests.zig
@@ -0,0 +1,56 @@
+//! Kept states in mapped pinned host memory: the device copies reach them both ways, byte for byte, on this card.
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const snap = flash.snap;
+
+pub fn run(gpu: check.Gpu) !void {
+    const chosen = try snap.onHost(gpu.ctx);
+    std.debug.print("flashnext-snap-host: this card keeps states {s}\n", .{if (chosen) "in pinned host memory" else "on the device"});
+    for ([_]usize{ 8192, 32768 }) |at| for ([_]bool{ true, false }) |host| try one(gpu, at, host);
+    check.pass("flashnext-snap-host: saved and restored states equal their source", .{});
+}
+
+fn one(gpu: check.Gpu, at: usize, host: bool) !void {
+    const d = gpu.d;
+    const n = snap.bytes(at, true, .full);
+    const want = try gpu.gpa.alloc(u8, n);
+    defer gpu.gpa.free(want);
+    for (want, 0..) |*v, i| v.* = @truncate(i *% 2654435761 >> 7);
+    var src = try cuda.DeviceBuffer.alloc(d, n);
+    defer src.free();
+    var dst = try cuda.DeviceBuffer.alloc(d, n);
+    defer dst.free();
+    try src.upload(0, want);
+    var stream = try cuda.Stream.init(d, true);
+    defer stream.deinit();
+    const t0 = check.now(gpu.io);
+    const st = try snap.prepare(gpu.gpa, d, host, at, .{ 0, 0 }, true, .full);
+    const t1 = check.now(gpu.io);
+    try check.expect((st.host != null) == host, "state at {d}: placed {s}", .{ at, if (st.host != null) "on host" else "on device" });
+    try d.check(d.api.cuMemcpyDtoDAsync_v2(st.buf.ptr, src.ptr, n, stream.handle), "save copy");
+    try stream.synchronize();
+    const t2 = check.now(gpu.io);
+    try d.check(d.api.cuMemcpyDtoDAsync_v2(dst.ptr, st.buf.ptr, n, stream.handle), "restore copy");
+    try stream.synchronize();
+    const t3 = check.now(gpu.io);
+    snap.drop(gpu.gpa, stream, st);
+    const t4 = check.now(gpu.io);
+    const got = try gpu.gpa.alloc(u8, n);
+    defer gpu.gpa.free(got);
+    try dst.download(0, got);
+    try check.sameBytes("restored state", got, want);
+    const gib = @as(f64, @floatFromInt(n)) / (1 << 30);
+    std.debug.print("  at {d} {s}: {d:.3} GiB, place {d:.1} ms, save {d:.2} GiB/s, restore {d:.2} GiB/s, drop {d:.1} ms\n", .{
+        at, if (host) "host" else "device", gib, ms(t1 - t0), gib / s(t2 - t1), gib / s(t3 - t2), ms(t4 - t3),
+    });
+}
+
+fn ms(ns: i96) f64 {
+    return @as(f64, @floatFromInt(ns)) / 1e6;
+}
+
+fn s(ns: i96) f64 {
+    return @as(f64, @floatFromInt(ns)) / 1e9;
+}
