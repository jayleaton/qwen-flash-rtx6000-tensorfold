+    .{ .name = "TF_FLASHNEXT_WINDOW_PAD", .scope = .flashnext, .kind = .size, .forms = "a whole row count from 0 to the native size maximum (default 0: off; a lone drafted window narrower than this runs padded to it on the rank link)" },
     .{ .name = "TF_FLASHNEXT_PP_WINDOW_GRAPH", .scope = .flashnext, .kind = .flag, .forms = "0 or 1 (default 0; 1: at --pp 2 the stage windows run as graphs); give every rank the same" },
