From: Jay Leaton <58495321+jayleaton@users.noreply.github.com>
Date: Tue, 24 Nov 2026 09:47:21 +0700
Subject: [PATCH 67/76] flashnext cuda: draft chains of up to 24
 (TF_FLASHNEXT_DRAFTS_GREEDY), and TF_FLASHNEXT_WINDOW_PAD pads a rank-link
 window to one width

---
 docs/environment.md                             |  5 +++--
 zig/src/families/flashnext/cuda_lanes.zig       |  8 ++++----
 zig/src/families/flashnext/cuda_mtp.zig         | 16 ++++++++++++++--
 zig/src/platform/environment.zig                |  5 +++--
 zig/src/platform/environment_flashnext_test.zig |  4 ++--
 zig/tests/fixtures/gradient-serving.tsv         |  4 ++--
 6 files changed, 28 insertions(+), 14 deletions(-)

diff --git a/docs/environment.md b/docs/environment.md
index f247955b5..818aaf5fb 100644
--- a/docs/environment.md
+++ b/docs/environment.md
@@ -161,11 +161,12 @@ stops the start with the variable, the supplied text and the accepted forms.
 | `TF_FLASHNEXT_TABLE_WARM` | Exactly `0` or `1`; default off |
 | `TF_FLASHNEXT_PROFILE` | Exactly `0` or `1`; default off |
 | `TF_FLASHNEXT_VERIFY_HOST_LOGITS` | Exactly `0` or `1`; default off |
-| `TF_FLASHNEXT_DRAFTS` | Whole draft count; default 6, then clamped to 1 through 15 |
-| `TF_FLASHNEXT_DRAFTS_GREEDY` | Whole draft count; default 8, then clamped to 1 through 15 |
+| `TF_FLASHNEXT_DRAFTS` | Whole draft count; default 6, then clamped to 1 through 24 |
+| `TF_FLASHNEXT_DRAFTS_GREEDY` | Whole draft count; default 8, then clamped to 1 through 24 |
 | `TF_FLASHNEXT_GREEDY_WIDE` | Whole round width; default 4 |
 | `TF_FLASHNEXT_WINDOW_ROWS` | Whole row count; default the shared round's rows, capped by them |
 | `TF_FLASHNEXT_SPLIT_ROWS` | Whole row count; `0` or unset takes the link's default (64, the shared round's rows). At `--tp 2`, a pass of more rows than this reduce-scatters its experts' rows and gathers the sums instead of one all-reduce. Give every rank the same value. |
+| `TF_FLASHNEXT_WINDOW_PAD` | Whole row count; default `0`, off. At `--tp 2` or `--pp 2`, a lone stream's verify window of fewer rows runs with its last token repeated up to this many (at most 32), so its window graphs see one width; the extra rows are never kept and the tokens are unchanged. |
 | `TF_FLASHNEXT_PP_WINDOW_GRAPH` | Exactly `0` or `1`; default off. `1`: at `--pp 2` each stage's verify windows run as CUDA graphs with their hop captured, whatever `TF_FLASHNEXT_WINDOW_GRAPH` says; the draft head's graphs still follow `TF_FLASHNEXT_WINDOW_GRAPH`. Same kernels and bits as the eager pass. Give every rank the same value. |
 | `TF_FLASHNEXT_TP_WINDOW_GRAPH` | Exactly `0` or `1`; default off. `1`: at `--tp 2` the drafted verify windows run as CUDA graphs on both ranks with their collectives captured, whatever `TF_FLASHNEXT_WINDOW_GRAPH` says; `TF_FLASHNEXT_PEER_SLOTS`' epoch moves to the device so a replay advances it. Same kernels and bits as the eager pass. Give every rank the same value. |
 | `TF_FLASHNEXT_PEER_SLOTS` | Exactly `0` or `1`; default off. At `--tp 2` on one host, a pass of up to 128 rows exchanges its MoE slots by writing each rank's own experts' rows (and its half of the shared expert's) into the peer's mapped buffer, about half the bytes of the all-reduce or reduce-scatter, with the same sums. Refused across hosts and with `TF_FLASHNEXT_DECODE_GRAPH`. Give every rank the same value. |
diff --git a/zig/src/families/flashnext/cuda_lanes.zig b/zig/src/families/flashnext/cuda_lanes.zig
index 16a6499d3..e5c08ba65 100644
--- a/zig/src/families/flashnext/cuda_lanes.zig
+++ b/zig/src/families/flashnext/cuda_lanes.zig
@@ -196,8 +196,8 @@ pub fn Namespace(comptime Tri: type) type {
             }
 
             fn mainVerify(ptr: *anyopaque, q: *prompt.Seq, d: *mtp.Draft, ids: []const u32) anyerror!void {
-                const self = of(ptr);
-                return self.ranks.?.verify(Tri, self.tri(), q, d, ids);
+                var wide: [mtp.max_rows]u32 = undefined;
+                return of(ptr).ranks.?.verify(Tri, of(ptr).tri(), q, d, mtp.padded(&wide, ids, q.fed, q.cap));
             }
 
             fn mainRollback(ptr: *anyopaque, q: *prompt.Seq, d: *mtp.Draft, keep: usize) anyerror!void {
@@ -226,12 +226,12 @@ pub fn Namespace(comptime Tri: type) type {
                 return .{ .ptr = self, .proposal_head = if (self.head) |h| &h.service else null, .first_before_draft = mtp.firstEarly(), .vtable = if (self.ranks == null) &scoring_table else &ranked_table };
             }
 
-            /// With the head: chains of up to 16 rows cut by its confidence, copies of up to 32; else one-row rounds.
+            /// With the head: chains of up to 25 rows cut by its confidence, copies of up to 32; else one-row rounds.
             pub fn facts(self: *const Cuda) lanes.Model {
                 const drafting = self.head != null;
                 return .{
                     .exact_width = if (drafting) mtp.max_rows else 2,
-                    .first_copy_rows = if (drafting) mtp.max_chain + 1 else 0,
+                    .first_copy_rows = if (drafting) mtp.first_copy_rows else 0,
                     .gpu_tokens = false,
                     .mtp = drafting,
                     .speculate = drafting,
diff --git a/zig/src/families/flashnext/cuda_mtp.zig b/zig/src/families/flashnext/cuda_mtp.zig
index ec169772e..d0a96490a 100644
--- a/zig/src/families/flashnext/cuda_mtp.zig
+++ b/zig/src/families/flashnext/cuda_mtp.zig
@@ -28,7 +28,9 @@ const HcW = wt.HcW;
 pub const Sampling = lanes.sampling.Sampling;
 
 /// Drafts an MTP chain holds at most beside its pending token.
-pub const max_chain: usize = 15;
+pub const max_chain: usize = 24;
+/// A lone stream's first copied window at most.
+pub const first_copy_rows: usize = 16;
 /// Preserve the existing recipe unless an explicit depth is selected.
 pub const default_depth: usize = 6;
 /// A greedy stream's chain at most (TF_FLASHNEXT_DRAFTS_GREEDY): greedy drafts land more often, so a deeper chain pays.
@@ -82,6 +84,15 @@ test "the stop rule: per draft above zero, the running product below it, every d
 }
 /// A verify window's rows at most: the pending token and a chain, or a copied continuation.
 pub const max_rows: usize = 32;
+
+/// `ids` at `fed`, its last token repeated up to TF_FLASHNEXT_WINDOW_PAD rows when they fit `cap`.
+pub fn padded(buf: *[max_rows]u32, ids: []const u32, fed: usize, cap: usize) []const u32 {
+    const rows = @import("sys").environment.read(usize, "TF_FLASHNEXT_WINDOW_PAD", 0) catch 0;
+    if (rows <= ids.len or rows > max_rows or fed + rows > cap) return ids;
+    @memcpy(buf[0..ids.len], ids);
+    @memset(buf[ids.len..rows], ids[ids.len - 1]);
+    return buf[0..rows];
+}
 /// A drafting round's rows at most: a shared verify's (TF_FLASHNEXT_WINDOW_ROWS lowers it; 0: each alone).
 pub const round_rows: usize = 64;
 /// qmm.split_for(2560, 2560): fc_embedding and fc_hidden sum K in four slices, in order.
@@ -459,7 +470,8 @@ test "a masked row draws only allowed tokens, greedy the best of them" {
 }
 
 test "draft chains fit one verify window while the default stays six" {
-    try std.testing.expectEqual(@as(usize, 16), max_chain + 1);
+    try std.testing.expectEqual(@as(usize, 25), max_chain + 1);
+    try std.testing.expectEqual(@as(usize, 16), first_copy_rows);
     try std.testing.expectEqual(@as(usize, 32), max_rows);
     try std.testing.expect(max_chain < max_rows and max_rows <= round_rows);
     try std.testing.expectEqual(@as(usize, 6), default_depth);
