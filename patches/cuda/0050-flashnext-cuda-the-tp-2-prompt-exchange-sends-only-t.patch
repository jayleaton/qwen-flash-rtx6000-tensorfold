+// The --tp 2 prompt exchange by owner slots: a rank sends the peer only the half rows of y it owns for the peer's rows.
+
+// Half rows (bit u: columns from u * dims / 2) rank src owns of slot k; first/count are rank me's experts.
+__device__ __forceinline__ unsigned fn_owner_units(int pick, int k, int slots, int first, int count, int split, int me,
+                                                   int src) {
+    if (k == slots - 1) return split ? 1u << src : (src == 0 ? 3u : 0u);
+    const bool mine = pick >= first && pick < first + count;
+    return mine == (src == me) ? 3u : 0u;
+}
+
+// out[b * (h + 1) + i]: half rows of block b's rows below i (b 0: ours in the peer's rows, 1: the peer's in ours).
+extern "C" __global__ void __launch_bounds__(1024) fn_owner_rows(const int* __restrict__ picks, int* __restrict__ out,
+                                                                 int peer0, int peer_rows, int own0, int own_rows,
+                                                                 int h, int slots, int first, int count, int split,
+                                                                 int me) {
+    __shared__ int warps[32];
+    __shared__ int carry;
+    const int b = blockIdx.x, lane = threadIdx.x & 31, warp = threadIdx.x >> 5;
+    const int row0 = b == 0 ? peer0 : own0, rows = b == 0 ? peer_rows : own_rows, src = b == 0 ? me : 1 - me;
+    int* pre = out + static_cast<long long>(b) * (h + 1);
+    if (threadIdx.x == 0) {
+        pre[0] = 0;
+        carry = 0;
+    }
+    for (int base = 0; base < h; base += 1024) {
+        const int i = base + threadIdx.x;
+        int x = 0;
+        if (i < rows)
+            for (int k = 0; k < slots; ++k)
+                x += __popc(fn_owner_units(picks[(row0 + i) * slots + k], k, slots, first, count, split, me, src));
+        for (int o = 1; o < 32; o <<= 1) {
+            const int y = __shfl_up_sync(0xffffffffu, x, o);
+            if (lane >= o) x += y;
+        }
+        if (lane == 31) warps[warp] = x;
+        __syncthreads();
+        if (warp == 0) {
+            int w = warps[lane];
+            for (int o = 1; o < 32; o <<= 1) {
+                const int y = __shfl_up_sync(0xffffffffu, w, o);
+                if (lane >= o) w += y;
+            }
+            warps[lane] = w;
+        }
+        __syncthreads();
+        const int sum = carry + x + (warp > 0 ? warps[warp - 1] : 0);
+        if (i < h) pre[i + 1] = sum;
+        __syncthreads();
+        if (threadIdx.x == 1023) carry = sum;
+        __syncthreads();
+    }
+}
+
+// The peer's rows from k0 (a block each): this rank's half rows (q float4s each) packed in pair order from pre[k0].
+extern "C" __global__ void __launch_bounds__(256) fn_owner_pack(const float4* __restrict__ y, const int* __restrict__ picks,
+                                                                const int* __restrict__ pre, float4* __restrict__ out,
+                                                                int peer0, int rows, int k0, int q, int slots,
+                                                                int first, int count, int split, int me) {
+    const int i = k0 + blockIdx.x;
+    if (i >= rows) return;
+    const long long r = peer0 + i;
+    long long at = pre[i] - pre[k0];
+    for (int k = 0; k < slots; ++k) {
+        const unsigned m = fn_owner_units(picks[r * slots + k], k, slots, first, count, split, me, me);
+        for (int u = 0; u < 2; ++u) {
+            if (!(m >> u & 1u)) continue;
+            const float4* src = y + ((r * slots + k) * 2 + u) * q;
+            for (int c = threadIdx.x; c < q; c += blockDim.x) out[at * q + c] = src[c];
+            ++at;
+        }
+    }
+}
+
+// fn_moe_sum over our rows from k0: the peer's half rows from recv, ours from y, each plus 0 as the reduce-scatter.
+extern "C" __global__ void fn_owner_sum(const float* __restrict__ y, const float* __restrict__ recv,
+                                        const float* __restrict__ wts, const int* __restrict__ picks,
+                                        const int* __restrict__ pre, float* __restrict__ out, int own0, int rows,
+                                        int k0, int d, int slots, int first, int count, int split, int me) {
+    const int i = k0 + blockIdx.x, col = blockIdx.y * blockDim.x + threadIdx.x;
+    if (i >= rows || col >= d) return;
+    const long long r = own0 + i;
+    const int half = d / 2, u = col >= half, c = col - u * half;
+    long long at = pre[i] - pre[k0];
+    float acc = 0.0f;
+    for (int k = 0; k < slots; ++k) {
+        const unsigned m = fn_owner_units(picks[r * slots + k], k, slots, first, count, split, me, 1 - me);
+        const float v = m >> u & 1u ? recv[(at + __popc(m & ((1u << u) - 1u))) * half + c] : y[(r * slots + k) * d + col];
+        acc = __fmaf_rn(v + 0.0f, wts[r * slots + k], acc);
+        at += __popc(m);
+    }
+    out[r * d + col] = acc;
+}
