diff --git a/zig/src/families/flashnext/cuda_owner_slots.zig b/zig/src/families/flashnext/cuda_owner_slots.zig
new file mode 100644
index 000000000..33b1d03e0
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_owner_slots.zig
@@ -0,0 +1,129 @@
+//! A --tp 2 prompt pass's expert exchange by owner slots: each rank sends only the half rows of y the peer needs.
+const std = @import("std");
+const cuda = @import("cuda");
+const wt = @import("cuda_prompt_wt.zig");
+
+const dims = wt.dims;
+const slots = wt.slots;
+const share = cuda.rank_scatter.share;
+/// Floats a half row of y: the unit a rank owns, two a routed pair's owner, one each of the split shared slot.
+pub const unit = dims / 2;
+
+/// The rank's experts and shared split: what decides which half rows of each pair it owns.
+pub const Owner = struct { first: usize, count: usize, split: bool, rank: usize };
+
+/// Each block's half-row prefix sums on the device, their pinned host copy, and the event after the copy.
+pub const Bufs = struct {
+    dev: cuda.DeviceBuffer,
+    host: cuda.HostBuffer,
+    ready: cuda.Event,
+
+    /// Ints of the two blocks' prefix sums for passes of up to `cap` rows.
+    pub fn ints(cap: usize) usize {
+        return 2 * ((cap + 1) / 2 + 1);
+    }
+
+    pub fn alloc(d: *const cuda.Driver, cap: usize) !Bufs {
+        var dev = try cuda.DeviceBuffer.alloc(d, ints(cap) * 4);
+        errdefer dev.free();
+        var host = try cuda.HostBuffer.alloc(d, ints(cap) * 4);
+        errdefer host.free();
+        return .{ .dev = dev, .host = host, .ready = try cuda.Event.init(d, false) };
+    }
+
+    pub fn free(b: *Bufs) void {
+        b.ready.deinit();
+        b.host.free();
+        b.dev.free();
+    }
+};
+
+/// Rows [k0, k1) of both blocks and the half rows each way: what one send and receive move.
+pub const Round = struct { k0: usize, k1: usize, send: usize, recv: usize };
+
+/// From row k0, the most rows whose half rows each way fit `cap`: both ranks see the same two sums, so the same rounds.
+pub fn nextRound(send: []const i32, recv: []const i32, k0: usize, cap: usize) Round {
+    var k1 = k0 + 1;
+    std.debug.assert(fits(send, recv, k0, k1, cap)); // a row's 22 half rows; the pack space holds 2.75 a cap row
+    while (k1 + 1 < send.len and fits(send, recv, k0, k1 + 1, cap)) k1 += 1;
+    return .{ .k0 = k0, .k1 = k1, .send = span(send, k0, k1), .recv = span(recv, k0, k1) };
+}
+
+fn span(pre: []const i32, k0: usize, k1: usize) usize {
+    return @intCast(pre[k1] - pre[k0]);
+}
+
+fn fits(send: []const i32, recv: []const i32, k0: usize, k1: usize, cap: usize) bool {
+    return span(send, k0, k1) <= cap and span(recv, k0, k1) <= cap;
+}
+
+fn ownerArgs(a: *cuda.Args, o: Owner) void {
+    for ([_]usize{ slots, o.first, o.count, @intFromBool(o.split), o.rank }) |v| a.add(@as(i32, @intCast(v)));
+}
+
+/// Before the experts: each block's half-row sums, copied to the host while the experts run.
+pub fn plan(pass: anytype, b: Bufs, o: Owner, n: usize, h: usize) !void {
+    const peer = share(n, 2, 1 - o.rank);
+    const own = share(n, 2, o.rank);
+    var a: cuda.Args = .{};
+    a.add(pass.s.picks);
+    a.add(b.dev.ptr);
+    for ([_]usize{ peer[0], peer[1] - peer[0], own[0], own[1] - own[0], h }) |v| a.add(@as(i32, @intCast(v)));
+    ownerArgs(&a, o);
+    try cuda.launch.launch(pass.k.owner_rows, .{ .grid = .{ .x = 2 }, .block = .{ .x = 1024 } }, pass.stream, &a);
+    const d = pass.stream.d;
+    try d.check(d.api.cuMemcpyDtoHAsync_v2(b.host.bytes.ptr, b.dev.ptr, 2 * (h + 1) * 4, pass.stream.handle), "cuMemcpyDtoHAsync");
+    try b.ready.record(pass.stream);
+}
+
+/// After the experts: rounds of packed half rows each way, each round's own rows summed as fn_moe_sum would.
+pub fn exchange(pass: anytype, c: anytype, b: Bufs, o: Owner, n: usize, h: usize) !void {
+    const s = pass.s;
+    try c.reached(b.ready);
+    const pre = b.host.slice(i32);
+    const send = pre[0 .. h + 1];
+    const recv = pre[h + 1 ..][0 .. h + 1];
+    const peer = share(n, 2, 1 - o.rank);
+    const own = share(n, 2, o.rank);
+    // the experts' activations are spent by now: the packed half rows go there
+    const cap = s.cap * slots * wt.moe_w * 2 / (unit * 4);
+    var k0: usize = 0;
+    while (k0 < h) {
+        const r = nextRound(send, recv, k0, cap);
+        try pack(pass, b.dev.ptr, o, peer, r);
+        // the peer's rows in y are packed already: what arrives goes there
+        const region = s.y + (peer[0] + r.k0) * slots * dims * 4;
+        try c.swap(pass.stream, s.moe_act, r.send * unit, region, r.recv * unit);
+        try sum(pass, b.dev.ptr + (h + 1) * 4, o, region, own, r);
+        k0 = r.k1;
+    }
+}
+
+fn pack(pass: anytype, pre: u64, o: Owner, peer: [2]usize, r: Round) !void {
+    var a: cuda.Args = .{};
+    a.add(pass.s.y);
+    a.add(pass.s.picks);
+    a.add(pre);
+    a.add(pass.s.moe_act);
+    for ([_]usize{ peer[0], peer[1] - peer[0], r.k0, unit / 4 }) |v| a.add(@as(i32, @intCast(v)));
+    ownerArgs(&a, o);
+    try cuda.launch.launch(pass.k.owner_pack, .{ .grid = .{ .x = @intCast(r.k1 - r.k0) }, .block = .{ .x = 256 } }, pass.stream, &a);
+}
+
+fn sum(pass: anytype, pre: u64, o: Owner, recv: u64, own: [2]usize, r: Round) !void {
+    const s = pass.s;
+    var a: cuda.Args = .{};
+    a.add(s.y);
+    a.add(recv);
+    a.add(s.wts);
+    a.add(s.picks);
+    a.add(pre);
+    a.add(s.moe_f32);
+    for ([_]usize{ own[0], own[1] - own[0], r.k0, dims }) |v| a.add(@as(i32, @intCast(v)));
+    ownerArgs(&a, o);
+    try cuda.launch.launch(pass.k.owner_sum, .{ .grid = .{ .x = @intCast(r.k1 - r.k0), .y = dims / 256 }, .block = .{ .x = 256 } }, pass.stream, &a);
+}
+
+test {
+    _ = @import("cuda_owner_slots_test.zig");
+}
diff --git a/zig/src/families/flashnext/cuda_owner_slots_test.zig b/zig/src/families/flashnext/cuda_owner_slots_test.zig
new file mode 100644
index 000000000..858ce1865
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_owner_slots_test.zig
@@ -0,0 +1,190 @@
+//! The owner-slot exchange's rounds, and both ranks' launches and sends over a faked NCCL and driver.
+const std = @import("std");
+const cuda = @import("cuda");
+const wt = @import("cuda_prompt_wt.zig");
+const owner = @import("cuda_owner_slots.zig");
+const exchange = @import("cuda_moe_exchange.zig");
+const Collective = @import("cuda_collective.zig").Collective;
+const nccl = cuda.nccl;
+const abi = cuda.abi;
+const expect = std.testing.expect;
+const expectEqual = std.testing.expectEqual;
+
+const dims = wt.dims;
+const slots = wt.slots;
+const unit = owner.unit;
+
+/// Each row's half rows both ways from a seed: 0 to 22, as eleven slots' owners can give.
+fn prefixes(a: std.mem.Allocator, h: usize, seed: u64) ![2][]i32 {
+    var prng = std.Random.DefaultPrng.init(seed);
+    const rng = prng.random();
+    var out: [2][]i32 = undefined;
+    for (&out) |*pre| {
+        pre.* = try a.alloc(i32, h + 1);
+        pre.*[0] = 0;
+        for (0..h) |i| pre.*[i + 1] = pre.*[i] + @as(i32, @intCast(rng.uintAtMost(u32, 22)));
+    }
+    return out;
+}
+
+test "rounds cover every row once, fit the pack space both ways, take every row that fits, and match across ranks" {
+    const a = std.testing.allocator;
+    for ([_]usize{ 1, 2, 33, 4096, 8192 }) |h| for ([_]usize{ 22, 23, 500, 1 << 20 }) |cap| {
+        const pre = try prefixes(a, h, h * 31 + cap);
+        defer for (pre) |p| a.free(p);
+        var k0: usize = 0;
+        while (k0 < h) {
+            const r = owner.nextRound(pre[0], pre[1], k0, cap);
+            const mirror = owner.nextRound(pre[1], pre[0], k0, cap);
+            try expect(r.k0 == k0 and r.k1 > k0 and r.k1 <= h and mirror.k1 == r.k1 and mirror.send == r.recv);
+            try expect(r.send <= cap and r.recv <= cap);
+            try expectEqual(@as(usize, @intCast(pre[0][r.k1] - pre[0][k0])), r.send);
+            if (r.k1 < h) try expect(pre[0][r.k1 + 1] - pre[0][k0] > cap or pre[1][r.k1 + 1] - pre[1][k0] > cap);
+            k0 = r.k1;
+        }
+        try expectEqual(h, k0);
+    };
+}
+
+const Fake = struct {
+    const Call = struct { kind: enum { pack, sum, send, recv, gather, start, end }, ptr: u64 = 0, count: usize = 0, peer: c_int = 0, grid: u32 = 0, k0: i32 = 0, rows: i32 = 0 };
+    var calls: [256]Call = undefined;
+    var len: usize = 0;
+
+    fn record(c: Call) void {
+        calls[len] = c;
+        len += 1;
+    }
+    fn send(p: abi.DevicePtr, count: usize, t: nccl.DataType, peer: c_int, _: nccl.Comm, _: abi.Stream) callconv(.c) nccl.Result {
+        record(.{ .kind = .send, .ptr = p, .count = if (t == .f32) count else 0, .peer = peer });
+        return 0;
+    }
+    fn recv(p: abi.DevicePtr, count: usize, t: nccl.DataType, peer: c_int, _: nccl.Comm, _: abi.Stream) callconv(.c) nccl.Result {
+        record(.{ .kind = .recv, .ptr = p, .count = if (t == .f32) count else 0, .peer = peer });
+        return 0;
+    }
+    fn start() callconv(.c) nccl.Result {
+        record(.{ .kind = .start });
+        return 0;
+    }
+    fn end() callconv(.c) nccl.Result {
+        record(.{ .kind = .end });
+        return 0;
+    }
+    fn gather(p: abi.DevicePtr, _: abi.DevicePtr, count: usize, _: nccl.DataType, _: nccl.Comm, _: abi.Stream) callconv(.c) nccl.Result {
+        record(.{ .kind = .gather, .ptr = p, .count = count });
+        return 0;
+    }
+    fn arg(comptime T: type, args: ?[*]?*anyopaque, i: usize) T {
+        return @as(*const T, @ptrCast(@alignCast(args.?[i].?))).*;
+    }
+    // pack: four pointers, then peer0, rows, k0; sum: six pointers, then own0, rows, k0
+    fn launch(f: abi.Function, gx: c_uint, _: c_uint, _: c_uint, _: c_uint, _: c_uint, _: c_uint, _: c_uint, _: abi.Stream, args: ?[*]?*anyopaque, _: ?[*]?*anyopaque) callconv(.c) abi.Result {
+        const pack = @intFromPtr(f) == 1;
+        const at: usize = if (pack) 4 else 6;
+        record(.{ .kind = if (pack) .pack else .sum, .grid = gx, .ptr = arg(u64, args, if (pack) 3 else 1), .rows = arg(c_int, args, at + 1), .k0 = arg(c_int, args, at + 2) });
+        return 0;
+    }
+    fn query(_: abi.Event) callconv(.c) abi.Result {
+        return 0;
+    }
+    fn asyncError(_: nccl.Comm, out: *nccl.Result) callconv(.c) nccl.Result {
+        out.* = 0;
+        return 0;
+    }
+};
+
+const Bufs = struct { y: u64 = 0x1000_0000, wts: u64 = 0x2000_0000, moe_f32: u64 = 0x3000_0000, picks: u64 = 0x4000_0000, moe_act: u64 = 0x5000_0000, cap: usize, owner: ?owner.Bufs };
+const Pass = struct {
+    s: *const Bufs,
+    k: struct { moe_sum: cuda.Function, owner_pack: cuda.Function, owner_sum: cuda.Function },
+    stream: cuda.Stream,
+    pending_f32: bool = false,
+};
+
+/// One rank's calls for a split pass of `n` rows whose host prefix sums are `pre` (its sends, then its receives).
+fn runRank(d: *cuda.Driver, rank: usize, n: usize, pre: [2][]const i32, host: []align(16) u8) ![]const Fake.Call {
+    var pair: [2]c_int = .{ -1, -1 };
+    if (std.c.socketpair(std.posix.AF.UNIX, std.posix.SOCK.STREAM, 0, &pair) != 0) return error.SocketPair;
+    defer for (pair) |fd| {
+        _ = std.c.close(fd);
+    };
+    var c: Collective = undefined;
+    c.failed = false;
+    c.comm = @ptrFromInt(0x1000);
+    c.link = .{ .fd = pair[0] };
+    c.timeout_ms = 1000;
+    c.rank = rank;
+    c.lib.api.ncclSend = Fake.send;
+    c.lib.api.ncclRecv = Fake.recv;
+    c.lib.api.ncclGroupStart = Fake.start;
+    c.lib.api.ncclGroupEnd = Fake.end;
+    c.lib.api.ncclAllGather = Fake.gather;
+    c.api.ncclCommGetAsyncError = Fake.asyncError;
+    const h = exchange.block(n);
+    const ints = std.mem.bytesAsSlice(i32, host[0 .. 2 * (h + 1) * 4]);
+    @memcpy(ints[0 .. h + 1], pre[0]);
+    @memcpy(ints[h + 1 ..], pre[1]);
+    const b: owner.Bufs = .{ .dev = .{ .d = d, .ptr = 0x6000_0000, .len = host.len }, .host = .{ .d = d, .bytes = host }, .ready = .{ .d = d, .handle = @ptrFromInt(8) } };
+    const bufs: Bufs = .{ .cap = n, .owner = b };
+    const f = struct {
+        fn of(dd: *cuda.Driver, x: usize) cuda.Function {
+            return .{ .d = dd, .handle = @ptrFromInt(x) };
+        }
+    };
+    var pass: Pass = .{ .s = &bufs, .k = .{ .moe_sum = f.of(d, 3), .owner_pack = f.of(d, 1), .owner_sum = f.of(d, 2) }, .stream = .{ .d = d, .handle = null } };
+    Fake.len = 0;
+    try exchange.run(&pass, &c, .{ .first = rank * 256, .count = 256, .split = true, .rank = rank }, n);
+    try expect(pass.pending_f32 and !c.failed);
+    return Fake.calls[0..Fake.len];
+}
+
+test "each round packs the peer's rows, sends what the peer receives into its packed rows, then sums its own" {
+    const a = std.testing.allocator;
+    var d: cuda.Driver = undefined;
+    d.api.cuLaunchKernel = Fake.launch;
+    d.api.cuEventQuery = Fake.query;
+    for ([_]usize{ 65, 66, 1537, 8192 }) |n| {
+        const h = exchange.block(n);
+        const pre = try prefixes(a, h, n);
+        defer for (pre) |p| a.free(p);
+        // rank 1's block is short a row when n is odd: its last offset is the pad, which holds nothing either way
+        if (n % 2 == 1) for (pre) |p| {
+            p[h] = p[h - 1];
+        };
+        const host = try a.alignedAlloc(u8, .@"16", 2 * (h + 1) * 4);
+        defer a.free(host);
+        const zero = try runRank(&d, 0, n, .{ pre[0], pre[1] }, host);
+        const got0 = try a.dupe(Fake.Call, zero);
+        defer a.free(got0);
+        const got1 = try runRank(&d, 1, n, .{ pre[1], pre[0] }, host);
+        try expectEqual(got0.len, got1.len);
+        const cap = n * slots * wt.moe_w * 2 / (unit * 4);
+        var k0: usize = 0;
+        var i: usize = 0;
+        while (k0 < h) : (i += 6) {
+            const r = owner.nextRound(pre[0], pre[1], k0, cap);
+            for ([_][]const Fake.Call{ got0, got1 }, 0..) |got, rank| {
+                const peer0 = if (rank == 0) h else 0;
+                const sent = if (rank == 0) r.send else r.recv;
+                const taken = if (rank == 0) r.recv else r.send;
+                const pk = got[i];
+                try expect(pk.kind == .pack and pk.grid == r.k1 - r.k0 and pk.k0 == r.k0 and pk.ptr == 0x5000_0000);
+                try expectEqual(@as(i32, @intCast(if (rank == 0) n - h else h)), pk.rows);
+                try expect(got[i + 1].kind == .start and got[i + 4].kind == .end);
+                const region = 0x1000_0000 + (peer0 + r.k0) * slots * dims * 4;
+                try expectEqual(Fake.Call{ .kind = .send, .ptr = 0x5000_0000, .count = sent * unit, .peer = @intCast(1 - rank) }, got[i + 2]);
+                try expectEqual(Fake.Call{ .kind = .recv, .ptr = region, .count = taken * unit, .peer = @intCast(1 - rank) }, got[i + 3]);
+                const sm = got[i + 5];
+                try expect(sm.kind == .sum and sm.grid == r.k1 - r.k0 and sm.k0 == r.k0 and sm.ptr == region);
+                try expectEqual(@as(i32, @intCast(if (rank == 0) h else n - h)), sm.rows);
+            }
+            k0 = r.k1;
+        }
+        try expect(i > 6 or n < 1000); // a full chunk takes several rounds through the experts' activations
+        for ([_][]const Fake.Call{ got0, got1 }, 0..) |got, rank| {
+            try expectEqual(i + 1, got.len);
+            try expectEqual(Fake.Call{ .kind = .gather, .ptr = 0x3000_0000 + rank * h * dims * 4, .count = h * dims }, got[i]);
+        }
+    }
+}
