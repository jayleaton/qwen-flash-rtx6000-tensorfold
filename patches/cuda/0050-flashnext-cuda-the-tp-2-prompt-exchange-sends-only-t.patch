diff --git a/zig/tests/cuda/contract_flashnext_owner.zig b/zig/tests/cuda/contract_flashnext_owner.zig
new file mode 100644
index 000000000..6af31fee0
--- /dev/null
+++ b/zig/tests/cuda/contract_flashnext_owner.zig
@@ -0,0 +1,308 @@
+//! The --tp 2 owner-slot exchange's kernels: the half-row prefix sums, the pack, and the sum fn_moe_sum's bits.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const check = @import("check.zig");
+const Rig = @import("contract_rig.zig").Rig;
+const c = core.contract.spec;
+const g = core.contract.gates;
+
+const dims = 2560;
+const slots = 11;
+const half = dims / 2;
+const share = cuda.rank_scatter.share;
+
+fn noSums(_: c.Shape) usize {
+    return 0;
+}
+
+// A pass's rows: past a verify window, odd and even, a default chunk and its scan tile's edges.
+const served = [_]c.Shape{ .{ .rows = 65, .n = 512, .k = 1 }, .{ .rows = 2049, .n = 512, .k = 1 }, .{ .rows = 3072, .n = 512, .k = 1 } };
+
+/// The kernels' rule on the host: the half rows (bits) rank `src` owns of slot k (fn_owner_units).
+fn units(pick: i32, k: usize, first: i32, split: bool, me: usize, src: usize) u32 {
+    if (k == slots - 1) return if (split) @as(u32, 1) << @intCast(src) else if (src == 0) 3 else 0;
+    const mine = pick >= first and pick < first + 256;
+    return if (mine == (src == me)) 3 else 0;
+}
+
+/// One pass's inputs: picks with edge experts planted, y with specials, weights, and the rank's view.
+const Case = struct {
+    n: usize,
+    h: usize,
+    me: usize,
+    split: bool,
+    picks: []i32,
+    y: []f32,
+    wts: []f32,
+    pre: []i32,
+
+    fn first(x: Case) i32 {
+        return @intCast(x.me * 256);
+    }
+
+    fn init(a: std.mem.Allocator, n: usize, me: usize, split: bool, seed: u64) !Case {
+        var prng = std.Random.DefaultPrng.init(seed);
+        const rng = prng.random();
+        const h = share(n, 2, 0)[1];
+        var x: Case = .{ .n = n, .h = h, .me = me, .split = split, .picks = try a.alloc(i32, (n + 1) * slots), .y = undefined, .wts = undefined, .pre = undefined };
+        errdefer a.free(x.picks);
+        for (x.picks, 0..) |*p, i| p.* = if (i % slots == slots - 1) 512 else @intCast(rng.uintLessThan(u32, 512));
+        for ([_]i32{ 0, 255, 256, 511 }, 0..) |e, i| x.picks[i] = e;
+        x.y = try a.alloc(f32, (n + 1) * slots * dims);
+        errdefer a.free(x.y);
+        const specials = [_]u32{ 0x8000_0000, 1, 0x8000_0001, 0x7f80_0000, 0xff80_0000, 0x7fc0_0000, 0x7f7f_ffff };
+        for (x.y, 0..) |*v, i| v.* = if (i % 997 == 3) @bitCast(specials[(i / 997) % specials.len]) else rng.float(f32) * 2 - 1;
+        x.wts = try a.alloc(f32, (n + 1) * slots);
+        errdefer a.free(x.wts);
+        for (x.wts) |*w| w.* = rng.float(f32);
+        x.wts[1] = @bitCast(@as(u32, 0x8000_0000));
+        x.pre = try a.alloc(i32, 2 * (h + 1));
+        for (0..2) |b| {
+            const row0 = if (b == 0) share(n, 2, 1 - me)[0] else share(n, 2, me)[0];
+            const rows = if (b == 0) share(n, 2, 1 - me)[1] - row0 else share(n, 2, me)[1] - row0;
+            const src = if (b == 0) me else 1 - me;
+            const pre = x.pre[b * (h + 1) ..][0 .. h + 1];
+            pre[0] = 0;
+            for (0..h) |i| {
+                var u: i32 = 0;
+                if (i < rows) for (0..slots) |k| {
+                    u += @popCount(units(x.picks[(row0 + i) * slots + k], k, x.first(), split, me, src));
+                };
+                pre[i + 1] = pre[i] + u;
+            }
+        }
+        return x;
+    }
+
+    fn deinit(x: Case, a: std.mem.Allocator) void {
+        a.free(x.picks);
+        a.free(x.y);
+        a.free(x.wts);
+        a.free(x.pre);
+    }
+
+    /// The first row of the round the pack and sum registrations run (a third in, so its offsets are not zero).
+    fn k0(x: Case) usize {
+        return x.h / 3;
+    }
+};
+
+const Kind = enum { rows, pack, sum };
+
+/// One kernel at one rank and shared split; the control launches it with the ranks swapped (or one expert off).
+pub const Owner = struct {
+    rig: Rig,
+    set: *const Set,
+    kind: Kind,
+    me: usize,
+    split: bool,
+    control: bool = false,
+    case: ?Case = null,
+    want: std.ArrayList(u8) = .empty,
+    dev: [6]u64 = @splat(0),
+    msg: [200]u8 = undefined,
+
+    const vt = g.hooks(Owner);
+
+    pub fn deinit(self: *Owner) void {
+        if (self.case) |x| x.deinit(self.rig.gpu.gpa);
+        self.want.deinit(self.rig.gpu.gpa);
+        self.rig.deinit();
+    }
+
+    pub fn kernel(self: *Owner) g.Kernel {
+        const names = [_][]const u8{ "cuda flashnext fn_owner_rows (half rows each way, prefix sums)", "cuda flashnext fn_owner_pack (a rank's half rows for the peer's rows)", "cuda flashnext fn_owner_sum (fn_moe_sum over the reduce-scatter's y)" };
+        const controls = [_][]const u8{ "control: fn_owner_rows one expert off", "control: fn_owner_pack the peer's half rows", "control: fn_owner_sum the ranks swapped" };
+        return .{ .ctx = self, .vt = &vt, .control = if (self.control) .shapes else null, .spec = .{
+            .name = if (self.control) controls[@backingInt(self.kind)] else names[@backingInt(self.kind)],
+            .accum = .none,
+            .depth = noSums,
+            .out = .raw,
+            .nan = .{ .stated = "bytes: the host rule's prefix sums and packed half rows; fn_moe_sum's bits over y with each value plus 0" },
+            .tiles = .{ .{ .size = 1024 }, .{}, .{} },
+            .served = &served,
+        } };
+    }
+
+    pub fn prepare(self: *Owner, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        _ = fill;
+        const a = self.rig.gpu.gpa;
+        self.rig.reset();
+        if (self.case) |x| x.deinit(a);
+        self.case = null;
+        if (shape.rows < 3 or shape.n != 512) return false;
+        const x = try Case.init(a, shape.rows, self.me, self.split, seed);
+        self.case = x;
+        self.dev[0] = try self.rig.input(std.mem.sliceAsBytes(x.picks));
+        switch (self.kind) {
+            .rows => {
+                self.dev[1] = try self.rig.output(x.pre.len * 4);
+                try self.want.resize(a, x.pre.len * 4);
+                @memcpy(self.want.items, std.mem.sliceAsBytes(x.pre));
+            },
+            .pack => try self.preparePack(x),
+            .sum => try self.prepareSum(x),
+        }
+        return true;
+    }
+
+    fn preparePack(self: *Owner, x: Case) !void {
+        const a = self.rig.gpu.gpa;
+        const peer = share(x.n, 2, 1 - x.me);
+        self.dev[1] = try self.rig.input(std.mem.sliceAsBytes(x.y));
+        self.dev[2] = try self.rig.input(std.mem.sliceAsBytes(x.pre[0 .. x.h + 1]));
+        const total: usize = @intCast(x.pre[x.h] - x.pre[x.k0()]);
+        self.want.clearRetainingCapacity();
+        for (x.k0()..peer[1] - peer[0]) |i| for (0..slots) |k| {
+            const pair = (peer[0] + i) * slots + k;
+            const m = units(x.picks[pair], k, x.first(), x.split, x.me, x.me);
+            for (0..2) |u| if (m >> @intCast(u) & 1 == 1) try self.want.appendSlice(a, std.mem.sliceAsBytes(x.y[(pair * 2 + u) * half ..][0..half]));
+        };
+        self.dev[3] = try self.rig.output(@max(total, 1) * half * 4);
+        if (total == 0) try self.want.appendNTimes(a, 0xff, half * 4);
+    }
+
+    fn prepareSum(self: *Owner, x: Case) !void {
+        const a = self.rig.gpu.gpa;
+        const own = share(x.n, 2, x.me);
+        const pre = x.pre[x.h + 1 ..];
+        // the peer's half rows packed from the round's first row, and y as the reduce-scatter leaves it (each plus 0)
+        var recv: std.ArrayList(f32) = .empty;
+        defer recv.deinit(a);
+        const merged = try a.dupe(f32, x.y);
+        defer a.free(merged);
+        for (x.k0()..own[1] - own[0]) |i| for (0..slots) |k| {
+            const pair = (own[0] + i) * slots + k;
+            const m = units(x.picks[pair], k, x.first(), x.split, x.me, 1 - x.me);
+            for (0..2) |u| if (m >> @intCast(u) & 1 == 1) try recv.appendSlice(a, x.y[(pair * 2 + u) * half ..][0..half]);
+        };
+        for (merged) |*v| v.* = v.* + 0.0;
+        try recv.append(a, 0);
+        self.dev[1] = try self.rig.input(std.mem.sliceAsBytes(x.y));
+        self.dev[2] = try self.rig.input(std.mem.sliceAsBytes(recv.items));
+        self.dev[3] = try self.rig.input(std.mem.sliceAsBytes(x.wts));
+        self.dev[4] = try self.rig.input(std.mem.sliceAsBytes(pre));
+        self.dev[5] = try self.rig.output((x.n + 1) * dims * 4);
+        // fn_moe_sum over the merged rows of the round; every other row keeps the output's fill
+        var ym = try cuda.DeviceBuffer.fromHost(self.rig.gpu.d, std.mem.sliceAsBytes(merged));
+        defer ym.free();
+        var ref = try cuda.DeviceBuffer.alloc(self.rig.gpu.d, (x.n + 1) * dims * 4);
+        defer ref.free();
+        try ref.fill8(0xff, self.rig.s.handle);
+        const r0 = own[0] + x.k0();
+        var args: cuda.Args = .{};
+        args.add(ym.ptr + r0 * slots * dims * 4);
+        args.add(self.dev[3] + r0 * slots * 4);
+        args.add(ref.ptr + r0 * dims * 4);
+        args.add(@as(i32, dims));
+        args.add(@as(i32, slots));
+        try cuda.launch.launch(self.set.moe_sum, .{ .grid = .{ .x = @intCast(own[1] - r0), .y = dims / 256 }, .block = .{ .x = 256 } }, self.rig.s, &args);
+        try self.rig.s.synchronize();
+        try self.want.resize(a, (x.n + 1) * dims * 4);
+        try ref.download(0, self.want.items);
+    }
+
+    pub fn run(self: *Owner) !void {
+        const x = self.case.?;
+        const swapped = self.control and self.kind != .rows;
+        const me = if (swapped) 1 - x.me else x.me;
+        const first: i32 = x.first() + @intFromBool(self.control and self.kind == .rows);
+        const peer = share(x.n, 2, 1 - x.me);
+        const own = share(x.n, 2, x.me);
+        var a: cuda.Args = .{};
+        const tail = [_]i32{ slots, first, 256, @intFromBool(x.split), @intCast(me) };
+        switch (self.kind) {
+            .rows => {
+                a.add(self.dev[0]);
+                a.add(self.dev[1]);
+                for ([_]usize{ peer[0], peer[1] - peer[0], own[0], own[1] - own[0], x.h }) |v| a.add(@as(i32, @intCast(v)));
+                for (tail) |v| a.add(v);
+                try cuda.launch.launch(self.set.rows, .{ .grid = .{ .x = 2 }, .block = .{ .x = 1024 } }, self.rig.s, &a);
+            },
+            .pack => {
+                for ([_]u64{ self.dev[1], self.dev[0], self.dev[2], self.dev[3] }) |p| a.add(p);
+                for ([_]usize{ peer[0], peer[1] - peer[0], x.k0(), half / 4 }) |v| a.add(@as(i32, @intCast(v)));
+                for (tail) |v| a.add(v);
+                try cuda.launch.launch(self.set.pack, .{ .grid = .{ .x = @intCast(x.h - x.k0()) }, .block = .{ .x = 256 } }, self.rig.s, &a);
+            },
+            .sum => {
+                for ([_]u64{ self.dev[1], self.dev[2], self.dev[3], self.dev[0], self.dev[4], self.dev[5] }) |p| a.add(p);
+                for ([_]usize{ own[0], own[1] - own[0], x.k0(), dims }) |v| a.add(@as(i32, @intCast(v)));
+                for (tail) |v| a.add(v);
+                try cuda.launch.launch(self.set.sum, .{ .grid = .{ .x = @intCast(x.h - x.k0()), .y = dims / 256 }, .block = .{ .x = 256 } }, self.rig.s, &a);
+            },
+        }
+        try self.rig.s.synchronize();
+    }
+
+    pub fn count(self: *Owner) usize {
+        return self.want.items.len;
+    }
+
+    pub fn reference(_: *Owner, want: []f64, mag: []f64) !void {
+        @memset(want, 0);
+        @memset(mag, 0);
+    }
+
+    /// Every byte as the host rule (rows, pack) or fn_moe_sum over the merged y (sum) gives it.
+    pub fn check(self: *Owner, _: g.Gate) !?[]const u8 {
+        const got = try self.rig.outputBytes();
+        if (got.len < self.want.items.len) return try std.fmt.bufPrint(&self.msg, "{d} bytes out, {d} wanted", .{ got.len, self.want.items.len });
+        for (self.want.items, got[0..self.want.items.len], 0..) |w, b, i| {
+            if (w != b) return try std.fmt.bufPrint(&self.msg, "{t} rank {d}: byte {d} is {x:0>2}, not {x:0>2}", .{ self.kind, self.me, i, b, w });
+        }
+        return null;
+    }
+};
+
+/// The three kernels at rank 0 with the shared slot split and rank 1 with it whole, and a control each.
+pub const Set = struct {
+    gpa: std.mem.Allocator,
+    batch: cuda.Module,
+    rows: cuda.Function = undefined,
+    pack: cuda.Function = undefined,
+    sum: cuda.Function = undefined,
+    moe_sum: cuda.Function = undefined,
+    regs: [9]Owner = undefined,
+
+    pub fn init(gpu: check.Gpu, s: cuda.Stream, a: std.mem.Allocator, list: *std.ArrayList(g.Kernel)) !*Set {
+        const set = try gpu.gpa.create(Set);
+        errdefer gpu.gpa.destroy(set);
+        set.* = .{ .gpa = gpu.gpa, .batch = try cuda.Module.load(gpu.d, cuda.kernels.flashnext_batch) };
+        errdefer set.batch.unload();
+        set.rows = try set.batch.function("fn_owner_rows");
+        set.pack = try set.batch.function("fn_owner_pack");
+        set.sum = try set.batch.function("fn_owner_sum");
+        set.moe_sum = try set.batch.function("fn_moe_sum");
+        const r: Rig = .{ .gpu = gpu, .s = s };
+        for (std.enums.values(Kind), 0..) |kind, i| {
+            set.regs[i * 3 + 0] = .{ .rig = r, .set = set, .kind = kind, .me = 0, .split = true };
+            set.regs[i * 3 + 1] = .{ .rig = r, .set = set, .kind = kind, .me = 1, .split = false };
+            set.regs[i * 3 + 2] = .{ .rig = r, .set = set, .kind = kind, .me = 0, .split = true, .control = true };
+        }
+        for (&set.regs) |*x| try list.append(a, x.kernel());
+        return set;
+    }
+
+    pub fn deinit(set: *Set) void {
+        for (&set.regs) |*x| x.deinit();
+        set.batch.unload();
+        set.gpa.destroy(set);
+    }
+};
+
+/// These kernels' gates 1-4 and their controls alone (tf-cuda-test flashnext-owner-contract).
+pub fn run(gpu: check.Gpu) !void {
+    const a = gpu.gpa;
+    var s = try cuda.Stream.init(gpu.d, false);
+    defer s.deinit();
+    var list: std.ArrayList(g.Kernel) = .empty;
+    defer list.deinit(a);
+    const set = try Set.init(gpu, s, a, &list);
+    defer set.deinit();
+    var t: g.Tally = .{};
+    try g.runAll(a, list.items, 0x6f77, &t);
+    std.debug.print("SUMMARY {d} kernels: {d} pass gates 1-4, {d} fail; {d} controls: {d} red as planted, {d} missed\n", .{ t.kernels, t.passed, t.failed, t.controls, t.caught, t.missed });
+    try check.expect(t.problems() == 0, "flashnext-owner-contract: {d} gate failures, {d} controls missed", .{ t.failed, t.missed });
+}
