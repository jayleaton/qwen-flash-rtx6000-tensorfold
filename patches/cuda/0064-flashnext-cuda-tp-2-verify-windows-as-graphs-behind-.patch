+/// Whether a window may run as a graph: one GPU or a stage under TF_FLASHNEXT_WINDOW_GRAPH, --tp 2 under ranks().
+fn graphed(e: *Engine) bool {
+    const c = e.collective orelse return window_graph.enabled();
+    if (!window_graph.ranks()) return false;
+    c.release = .{ .ctx = e, .run = release };
+    return true;
+}
+
+/// Ahead of the communicator's abort, which waits on graphs holding its plans: an open capture ended, all freed.
+fn release(ctx: *anyopaque) void {
+    const e: *Engine = @ptrCast(@alignCast(ctx));
+    if ((cuda.graph.captureStatus(e.stream.*) catch .active) != .none) {
+        if (cuda.graph.endCapture(e.stream.*)) |g| {
+            var discarded = g;
+            discarded.deinit();
+        } else |_| {}
+    }
+    e.graphs.clear(e.gpa);
+    e.round_graph.clear();
+}
+
+/// The engine's graphs freed as it goes, and the communicator's hook to them dropped first.
+pub fn dropGraphs(e: *Engine) void {
+    if (e.collective) |c| if (c.release) |r| if (r.ctx == @as(*anyopaque, e)) {
+        c.release = null;
+    };
+    e.round_graph.clear();
+    e.graphs.clear(e.gpa);
+}
