+    if (hooks.logits != .all or hooks.host_logits or hooks.moe_add != null) return false;
+    if (ids.len > @import("cuda_mtp.zig").max_rows or ids.len > p.s.cap or !hops.graphs(e.hop) or !graphed(e) or seq.media != null or p.m.pocket != null) return false;
     const key = window_graph.Key.init(seq, seq.fed, ids.len, p.s, p.seq.scores, @intFromPtr(p.m.layers.ptr), hooks);
     try window_graph.stageWindow(p, ids, seq.fed);
