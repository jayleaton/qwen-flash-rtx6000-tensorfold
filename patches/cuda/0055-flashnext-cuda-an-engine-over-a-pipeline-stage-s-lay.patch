new file mode 100644
index 000000000..33c164bfb
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_span.zig
@@ -0,0 +1,60 @@
+//! A pipeline stage's layers [first, end) of the model; the stage holding layer 0 also embeds and runs the head.
+const std = @import("std");
+const wt = @import("cuda_prompt_wt.zig");
+
+pub const Span = struct {
+    first: usize = 0,
+    end: usize = wt.layers_n,
+
+    pub const whole: Span = .{};
+
+    /// The two stages of a split at `split` (rank 1's first layer); layer 1's n-gram block stays on rank 0.
+    pub fn ofRank(split: usize, rank: usize) !Span {
+        if (split <= wt.ple_layer or split >= wt.layers_n) return error.BadPipelineSplit;
+        return switch (rank) {
+            0 => .{ .end = split },
+            1 => .{ .first = split },
+            else => error.BadRank,
+        };
+    }
+
+    pub fn isWhole(s: Span) bool {
+        return s.first == 0 and s.end == wt.layers_n;
+    }
+
+    /// The embedding, the n-gram rows, the head and the draft head: the ring's rank 0.
+    pub fn ends(s: Span) bool {
+        return s.first == 0;
+    }
+
+    pub fn count(s: Span) usize {
+        return s.end - s.first;
+    }
+
+    pub fn owns(s: Span, layer: usize) bool {
+        return layer >= s.first and layer < s.end;
+    }
+};
+
+test "a split puts layer 1's n-gram block on rank 0 and refuses an empty stage" {
+    const a = try Span.ofRank(24, 0);
+    const b = try Span.ofRank(24, 1);
+    try std.testing.expect(a.ends() and !b.ends() and !a.isWhole() and Span.whole.isWhole());
+    try std.testing.expectEqual(@as(usize, 24), a.count() + b.count() - 24);
+    try std.testing.expect(a.owns(23) and !a.owns(24) and b.owns(24) and b.owns(47));
+    for ([_]usize{ 0, 1, 48, 49 }) |bad| try std.testing.expectError(error.BadPipelineSplit, Span.ofRank(bad, 0));
+    try std.testing.expectError(error.BadRank, Span.ofRank(24, 2));
+    try std.testing.expectEqual(Span{ .end = 2 }, try Span.ofRank(2, 0));
+    try std.testing.expectEqual(Span{ .first = 47 }, try Span.ofRank(47, 1));
+}
+
+test "linear layers skip every fourth index and attention starts at 3" {
+    try std.testing.expect(wt.linearLayer(0));
+    try std.testing.expect(!wt.linearLayer(3));
+    try std.testing.expect(!wt.linearLayer(47));
+    try std.testing.expectEqual(@as(usize, 0), wt.linearIndex(0));
+    try std.testing.expectEqual(@as(usize, 2), wt.linearIndex(2));
+    try std.testing.expectEqual(@as(usize, 35), wt.linearIndex(46));
+    try std.testing.expectEqual(@as(usize, 0), wt.attnIndex(3));
+    try std.testing.expectEqual(@as(usize, 11), wt.attnIndex(47));
+}
diff --git a/zig/src/families/flashnext/cuda_span_main.zig b/zig/src/families/flashnext/cuda_span_main.zig
new file mode 100644
index 000000000..94535484c
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_span_main.zig
@@ -0,0 +1,163 @@
+//! Two pipeline stages on one GPU against one engine: greedy tokens and every step's scores, byte for byte.
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+
+const prompt = flash.prompt;
+const Span = flash.span.Span;
+const wide = 4 * 2560;
+const vocab = prompt.vocabulary;
+
+pub fn main(init: std.process.Init) !u8 {
+    try flash.env_validate.startup();
+    const gpa = init.gpa;
+    const io = init.io;
+    const args = try init.minimal.args.toSlice(init.arena.allocator());
+    if (args.len < 5) {
+        std.debug.print("usage: flashnext-span <model-dir> <ids-file> <count> <split>\n", .{});
+        return 2;
+    }
+    const count = try std.fmt.parseInt(usize, args[3], 10);
+    const split = try std.fmt.parseInt(usize, args[4], 10);
+    const text = try std.Io.Dir.cwd().readFileAlloc(io, args[2], gpa, .limited(1 << 24));
+    defer gpa.free(text);
+    var ids: std.ArrayList(u32) = .empty;
+    defer ids.deinit(gpa);
+    var it = std.mem.tokenizeAny(u8, text, ", \t\r\n");
+    while (it.next()) |part| try ids.append(gpa, try std.fmt.parseInt(u32, part, 10));
+    if (ids.items.len == 0 or count == 0) return 2;
+
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, 0);
+    defer ctx.deinit();
+    var glue = try flash.Glue.load(&driver);
+    defer glue.deinit();
+    var stream = try cuda.Stream.init(&driver, true);
+    defer stream.deinit();
+    const tri: flash.Tri = .{ .own = &glue, .s = stream };
+    var run: Run = .{ .gpa = gpa, .io = io, .driver = &driver, .stream = &stream, .tri = tri, .dir = args[1], .ids = ids.items, .count = count };
+
+    const tokens = try gpa.alloc(u32, 2 * count);
+    defer gpa.free(tokens);
+    const scores = try gpa.alloc(u8, 2 * count * vocab * 2);
+    defer gpa.free(scores);
+    const whole = Out{ .tokens = tokens[0..count], .scores = scores[0 .. count * vocab * 2] };
+    const staged = Out{ .tokens = tokens[count..], .scores = scores[count * vocab * 2 ..] };
+    try run.whole(whole);
+    try run.stages(split, staged);
+    for (0..count) |i| {
+        const a = whole.scores[i * vocab * 2 ..][0 .. vocab * 2];
+        const b = staged.scores[i * vocab * 2 ..][0 .. vocab * 2];
+        if (whole.tokens[i] != staged.tokens[i] or !std.mem.eql(u8, a, b)) {
+            std.debug.print("split {d}: step {d} differs: token {d} against {d}, scores {s}\n", .{ split, i, whole.tokens[i], staged.tokens[i], if (std.mem.eql(u8, a, b)) "equal" else "differ" });
+            return 1;
+        }
+    }
+    std.debug.print("split {d}: {d} prompt rows and {d} greedy steps, tokens and scores equal to one engine\n", .{ split, ids.items.len, count });
+    return 0;
+}
+
+/// Each step's greedy token and its scores row.
+const Out = struct { tokens: []u32, scores: []u8 };
+
+const Run = struct {
+    gpa: std.mem.Allocator,
+    io: std.Io,
+    driver: *cuda.Driver,
+    stream: *cuda.Stream,
+    tri: flash.Tri,
+    dir: []const u8,
+    ids: []const u32,
+    count: usize,
+
+    fn cap(r: *const Run) usize {
+        return r.ids.len + r.count;
+    }
+
+    fn whole(r: *Run, out: Out) !void {
+        const e = try prompt.Engine.init(r.gpa, r.io, r.driver, r.stream, r.dir);
+        defer e.deinit();
+        var seq = try e.newSeq(r.cap());
+        defer seq.deinit(r.gpa);
+        try greedy(r, out, &seq, Feed{ .e = e });
+    }
+
+    fn stages(r: *Run, split: usize, out: Out) !void {
+        const a = try prompt.Engine.initSpan(r.gpa, r.io, r.driver, r.stream, r.dir, try Span.ofRank(split, 0));
+        defer a.deinit();
+        const b = try prompt.Engine.initSpan(r.gpa, r.io, r.driver, r.stream, r.dir, try Span.ofRank(split, 1));
+        defer b.deinit();
+        var seq_a = try a.newSeq(r.cap());
+        defer seq_a.deinit(r.gpa);
+        var seq_b = try b.newSeq(r.cap());
+        defer seq_b.deinit(r.gpa);
+        var rows = try cuda.DeviceBuffer.alloc(r.driver, @min(r.ids.len, a.chunk) * wide * 2);
+        defer rows.free();
+        var ring: Ring = .{ .run = r, .b = b, .seq = &seq_b, .rows = rows.ptr };
+        a.hop = .{ .ctx = &ring, .take = Ring.back, .give = Ring.on };
+        b.hop = .{ .ctx = &ring, .take = Ring.in, .give = Ring.out };
+        try greedy(r, out, &seq_a, Feed{ .e = a, .ring = &ring });
+    }
+};
+
+/// Rank 0's forward, with the ring's rows for this call when the engine is a stage.
+const Feed = struct {
+    e: *prompt.Engine,
+    ring: ?*Ring = null,
+
+    fn forward(f: Feed, r: *Run, seq: *prompt.Seq, ids: []const u32) !void {
+        if (f.ring) |g| {
+            g.ids = ids;
+            g.at = 0;
+        }
+        try f.e.forward(flash.Tri, r.tri, seq, ids, .{});
+    }
+};
+
+fn greedy(r: *Run, out: Out, seq: *prompt.Seq, f: Feed) !void {
+    try f.forward(r, seq, r.ids);
+    for (0..r.count) |i| {
+        @memcpy(out.scores[i * vocab * 2 ..][0 .. vocab * 2], seq.logits[0 .. vocab * 2]);
+        out.tokens[i] = prompt.argmax(seq.logits);
+        if (i + 1 < r.count) try f.forward(r, seq, (&out.tokens[i])[0..1]);
+    }
+}
+
+/// Both stages on one stream: rank 0's rows on to rank 1's pass over the same ids, then back, through `rows`.
+const Ring = struct {
+    run: *Run,
+    b: *prompt.Engine,
+    seq: *prompt.Seq,
+    rows: u64,
+    ids: []const u32 = &.{},
+    at: usize = 0,
+
+    fn copy(g: *Ring, dst: u64, src: u64, rows: usize) !void {
+        const d = g.run.driver;
+        try d.check(d.api.cuMemcpyDtoDAsync_v2(dst, src, rows * wide * 2, g.run.stream.handle), "cuMemcpyDtoDAsync");
+    }
+
+    /// Rank 0 gives its chunk's rows: rank 1's layers run on them before rank 0 takes them back.
+    fn on(ctx: *anyopaque, h: u64, rows: usize) anyerror!void {
+        const g: *Ring = @ptrCast(@alignCast(ctx));
+        try g.copy(g.rows, h, rows);
+        try g.b.forward(flash.Tri, g.run.tri, g.seq, g.ids[g.at..][0..rows], .{ .logits = .none });
+        g.at += rows;
+    }
+
+    fn back(ctx: *anyopaque, h: u64, rows: usize) anyerror!void {
+        const g: *Ring = @ptrCast(@alignCast(ctx));
+        try g.copy(h, g.rows, rows);
+    }
+
+    fn in(ctx: *anyopaque, h: u64, rows: usize) anyerror!void {
+        const g: *Ring = @ptrCast(@alignCast(ctx));
+        try g.copy(h, g.rows, rows);
+    }
+
+    fn out(ctx: *anyopaque, h: u64, rows: usize) anyerror!void {
+        const g: *Ring = @ptrCast(@alignCast(ctx));
+        try g.copy(g.rows, h, rows);
+    }
+};
-- 
