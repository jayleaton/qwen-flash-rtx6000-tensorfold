diff --git a/zig/src/families/flashnext/cuda_batch_hop.zig b/zig/src/families/flashnext/cuda_batch_hop.zig
new file mode 100644
index 000000000..461cca0b4
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_batch_hop.zig
@@ -0,0 +1,39 @@
+//! A pipeline stage's pass ends: the boundary rows in where it doesn't embed, out where it doesn't run the head.
+const wt = @import("cuda_prompt_wt.zig");
+
+/// The boundary rows `h` [rows, wt.wide] bf16 on the device: taken from the stage before, given to the next.
+pub const Hop = struct {
+    ctx: *anyopaque,
+    take: *const fn (ctx: *anyopaque, h: u64, rows: usize) anyerror!void,
+    give: *const fn (ctx: *anyopaque, h: u64, rows: usize) anyerror!void,
+};
+
+/// A stage's layers from `first` (an absolute index); its rows cross through `hop`.
+pub const Stage = struct { first: usize, hop: Hop };
+
+/// The absolute index of a pass's first layer.
+pub fn first(m: anytype) usize {
+    return if (m.stage) |st| st.first else 0;
+}
+
+/// The pass's first rows: the stage's boundary rows, or the embedding and any media rows on the embedding stage.
+pub fn enter(pass: anytype, n: usize) !void {
+    const s = pass.s;
+    if (pass.m.stage) |st| if (st.first > 0) return st.hop.take(st.hop.ctx, s.h, n);
+    if (pass.m.table_dense) {
+        try pass.tri.embedDense(s.ids, pass.m.table_w, s.h, wt.dims, wt.streams, n);
+    } else {
+        try pass.tri.embed(s.ids, pass.m.table_w, pass.m.table_s, pass.m.table_b, s.h, wt.dims, wt.streams, n);
+    }
+    try @import("cuda_media.zig").inject(pass.seq.media, pass.lanes, pass.stream, s.h, pass.pos0, n);
+}
+
+/// The pass's last step: the head, or the written-back rows on to the next stage (rank 0: back again, then its head).
+pub fn leave(pass: anytype, logits_host: ?[]u8) !void {
+    const st = pass.m.stage orelse return pass.head(logits_host);
+    try pass.writeback(0, pass.rows);
+    try st.hop.give(st.hop.ctx, pass.s.h, pass.rows);
+    if (st.first > 0) return;
+    try st.hop.take(st.hop.ctx, pass.s.h, pass.rows);
+    try pass.head(logits_host);
+}
