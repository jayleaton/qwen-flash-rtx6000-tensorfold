+/// The read-out over rows [r0, r0 + n) in two launches: the down with act and gates, then the up with the mix.
+pub fn readout(pass: anytype, hc_w: wt.HcW, r0: usize, n: usize) !void {
+    const s = pass.s;
+    const down = hc_w.down.native orelse return error.UnexpectedTensor;
+    const up = hc_w.up.native orelse return error.UnexpectedTensor;
+    const per = slicePer(pass.k.native_lane, down, n) orelse return error.UnexpectedTensor;
+    const h = s.h + r0 * wide * 2;
+    const pss = s.pss + r0 * pss_n * 4;
+    const act = s.act + r0 * low * 2;
+    const xs_act = s.xs_act + r0 * (low / 32) * 4;
+    const inj = if (hc_w.has_inj == 1) s.inj + r0 * streams * 2 else act;
+    try launchDown(&pass.k.tiles, pass.stream, h, pss, hc_w.scale.ptr, down, per, act, xs_act, inj, n, hc_w.has_inj);
+    try launchUp(&pass.k.tiles, pass.stream, act, up, h, pss, hc_w.scale.ptr, s.mixed + r0 * dims * 2, s.xsm + r0 * (dims / 32) * 4, n);
+}
