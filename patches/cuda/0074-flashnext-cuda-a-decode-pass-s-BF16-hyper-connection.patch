diff --git a/zig/src/families/flashnext/cuda_readout_decode.zig b/zig/src/families/flashnext/cuda_readout_decode.zig
new file mode 100644
index 000000000..723b7ba1b
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_readout_decode.zig
@@ -0,0 +1,87 @@
+//! TF_FLASHNEXT_READOUT_DECODE: a decode pass's BF16 read-out in two launches with the five launches' bits.
+const cuda = @import("cuda");
+const wt = @import("cuda_prompt_wt.zig");
+const tiles = @import("cuda_tiles.zig");
+const tk = @import("cuda_tile_kernels.zig");
+
+const dims = wt.dims;
+const streams = wt.streams;
+const wide = wt.wide;
+const low = wt.low;
+const eps = wt.eps;
+const pss_n = (dims / 256) * streams;
+
+/// Rows below which a pass takes it: from 64 rows the writeback carries the normalize (TF_FLASHNEXT_HC_FUSE).
+pub const max_rows: usize = 64;
+
+/// The setting as the startup check accepted it: unset, blank or 0 is off.
+pub fn on() bool {
+    // the startup check refused every malformed value already, so a plain default stands here
+    return @import("sys").environment.read(bool, "TF_FLASHNEXT_READOUT_DECODE", false) catch false;
+}
+
+fn cint(v: usize) c_int {
+    return @intCast(v);
+}
+
+fn cdiv(a: usize, b: usize) usize {
+    return (a + b - 1) / b;
+}
+
+/// K groups of 64 a down slice holds, when the down's K slices meet as the qmmf lane's do at these rows, else null.
+pub fn slicePer(lane: cuda.qmmf.Lane, down: cuda.qmmf.Weight, n: usize) ?usize {
+    const p = cuda.qmmf.planFor(n, down, lane.clusters);
+    if (p.fused or p.reduce or p.sk > 8 or down.k % 64 != 0) return null;
+    const groups = down.k / 64;
+    if (groups % p.sk != 0) return null;
+    const per = groups / p.sk;
+    return if (tk.hcdDownSmem(per) <= tk.hcd_down_smem) per else null;
+}
+
+/// Whether n rows of hc_w take the two launches: the setting, decode rows, the fused tiles' BF16 shapes.
+pub fn takes(pass: anytype, hc_w: wt.HcW, n: usize) bool {
+    if (!pass.k.forms.readout_decode or n == 0 or n >= max_rows or !tiles.nativeFused(hc_w)) return false;
+    if (!pass.tri.readoutTilesOwned() or low % 32 != 0 or streams > 8) return false;
+    if (cuda.qmmf.slices(hc_w.up.native.?) != 1) return false;
+    return slicePer(pass.k.native_lane, hc_w.down.native.?, n) != null;
+}
+
+/// fn_hcn_down_act: rows normed from h, the down in slices of `per` groups (a cluster), act, its sums and the gates.
+pub fn launchDown(t: *const tk.TileKernels, stream: cuda.Stream, h: u64, pss: u64, scale: u64, down: cuda.qmmf.Weight, per: usize, act: u64, xs: u64, inj: u64, n: usize, has_inj: usize) !void {
+    const sk = down.k / 64 / per;
+    var a: cuda.Args = .{};
+    for ([_]u64{ h, pss, scale, down.codes, act, xs, inj }) |v| a.add(v);
+    for ([_]usize{ n, down.n, down.k, sk, dims, dims / 256, streams, low, has_inj }) |v| a.add(cint(v));
+    a.add(down.scale);
+    a.add(eps);
+    try cuda.launch.launch(t.hcd_down, .{
+        .grid = .{ .x = @intCast(cdiv(n, 16) * cdiv(down.n, 32)), .y = 1, .z = @intCast(sk) },
+        .block = .{ .x = 128 },
+        .shared = tk.hcdDownSmem(per),
+        .cluster = if (sk > 1) .{ .x = 1, .y = 1, .z = @intCast(sk) } else null,
+    }, stream, &a);
+}
+
+/// fn_hcn_up1: act times the BF16 up, gated onto the rows normed from h, mixed, with the mixed rows' 32-column sums.
+pub fn launchUp(t: *const tk.TileKernels, stream: cuda.Stream, act: u64, up: cuda.qmmf.Weight, h: u64, pss: u64, scale: u64, mixed: u64, xsm: u64, n: usize) !void {
+    var b: cuda.Args = .{};
+    for ([_]u64{ act, up.codes, h, pss, scale, mixed, xsm }) |v| b.add(v);
+    for ([_]usize{ n, dims, dims / 256 }) |v| b.add(cint(v));
+    b.add(eps);
