@@ -187,6 +187,27 @@ pub const Collective = struct {
         try c.wait(null, wire.deadline(c.timeout_ms));
     }
 
+    /// `bytes` at `ptr` to the other rank, enqueued on the compute stream: a pipeline rank's boundary rows.
+    pub fn send(c: *Collective, stream: cuda.Stream, ptr: u64, bytes: usize) !void {
+        return c.direct(stream, ptr, bytes, true);
+    }
+
+    /// `bytes` from the other rank into `ptr`, enqueued on the compute stream; later kernels there read them.
+    pub fn recv(c: *Collective, stream: cuda.Stream, ptr: u64, bytes: usize) !void {
+        return c.direct(stream, ptr, bytes, false);
+    }
+
+    fn direct(c: *Collective, stream: cuda.Stream, ptr: u64, bytes: usize, out: bool) !void {
+        if (c.failed or c.comm == null) return error.RankDisconnected;
+        if (bytes == 0) return;
+        errdefer c.abort();
+        try c.link.checkPeer();
+        const other: c_int = @intCast(1 - c.rank);
+        const api = c.lib.api;
+        try c.submitted(if (out) api.ncclSend(ptr, bytes, .u8, other, c.comm, stream.handle) else api.ncclRecv(ptr, bytes, .u8, other, c.comm, stream.handle));
+        try c.wait(null, wire.deadline(c.timeout_ms));
+    }
+
     /// FP32 sum is enqueued on the compute stream; later kernels on that stream observe its result.
     pub fn sum(c: *Collective, stream: cuda.Stream, values: u64, count: usize) !void {
         if (c.failed or c.comm == null) return error.RankDisconnected;
@@ -436,5 +457,5 @@ test "this file calls NCCL only to start, poll and abort, and for collectives NC
