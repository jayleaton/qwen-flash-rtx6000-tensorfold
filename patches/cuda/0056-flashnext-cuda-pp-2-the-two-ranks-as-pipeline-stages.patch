+//! A pipeline rank's boundary rows over the two ranks' NCCL communicator, on the engine's stream.
+const cuda = @import("cuda");
+const wt = @import("cuda_prompt_wt.zig");
+const Collective = @import("cuda_collective.zig").Collective;
+const Hop = @import("cuda_batch_hop.zig").Hop;
+
+pub const Rows = struct {
+    c: *Collective,
+    stream: cuda.Stream,
+
+    pub fn hop(r: *Rows) Hop {
+        return .{ .ctx = r, .take = take, .give = give, .finish = finish };
+    }
+
+    fn of(ctx: *anyopaque) *Rows {
+        return @ptrCast(@alignCast(ctx));
+    }
+
+    fn give(ctx: *anyopaque, h: u64, rows: usize) anyerror!void {
+        const r = of(ctx);
+        try r.c.send(r.stream, h, rows * wt.wide * 2);
+    }
+
+    fn take(ctx: *anyopaque, h: u64, rows: usize) anyerror!void {
+        const r = of(ctx);
+        try r.c.recv(r.stream, h, rows * wt.wide * 2);
+    }
+
+    /// A host wait on the stream that still sees the peer, its errors and the deadline.
+    fn finish(ctx: *anyopaque) anyerror!void {
+        const r = of(ctx);
+        try r.c.finish(r.stream);
+    }
+};
