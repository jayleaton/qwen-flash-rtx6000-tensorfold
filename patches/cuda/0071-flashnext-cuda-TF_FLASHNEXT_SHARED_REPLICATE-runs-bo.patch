From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jay Leaton <58495321+jayleaton@users.noreply.github.com>
Date: Tue, 24 Nov 2026 15:21:22 +0700
Subject: [PATCH 71/76] flashnext cuda: TF_FLASHNEXT_SHARED_REPLICATE runs both
 ranks' shared expert halves on each rank, so --tp 2 drops the shared gather

---
 docs/environment.md                           |  1 +
 .../families/flashnext/cuda_mixed_experts.zig | 27 ++++++++++++++++-
 .../families/flashnext/cuda_rank_engine.zig   |  4 +--
 .../families/flashnext/cuda_shared_split.zig  | 27 ++++++++++++-----
 .../flashnext/cuda_split_lane_test.zig        | 29 +++++++++++++++++++
 zig/src/platform/environment.zig              |  1 +
 .../platform/environment_flashnext_test.zig   |  4 +--
 zig/tests/fixtures/gradient-serving.tsv       |  2 +-
 8 files changed, 82 insertions(+), 13 deletions(-)

diff --git a/docs/environment.md b/docs/environment.md
index 458130bd7..4a5e50beb 100644
--- a/docs/environment.md
+++ b/docs/environment.md
@@ -155,6 +155,7 @@ stops the start with the variable, the supplied text and the accepted forms.
 | `TF_FLASHNEXT_DECODE_GRAPH` | Exactly `0` or `1`; default off |
 | `TF_FLASHNEXT_SPLIT_DENSE` | Exactly `0` or `1`; default on: two ranks split the BF16 dense projections |
 | `TF_FLASHNEXT_SPLIT_SHARED` | Exactly `0` or `1`; default on: under the dense split the shared expert is split too, with one gather a layer. `0` runs it whole on rank 0 instead, as without the split. Give every rank the same value. |
+| `TF_FLASHNEXT_SHARED_REPLICATE` | Exactly `0` or `1`; default off. `1`: under the shared expert's split each rank also loads the peer's gate and up cuts and runs both ranks' halves itself with the peer's launches, instead of the gather; the down projection and its output columns are unchanged, so are the bits. Inert without the split (`--pp 2`, `TF_FLASHNEXT_SPLIT_SHARED=0`). Give every rank the same value (the ranks refuse to pair otherwise). |
 | `TF_FLASHNEXT_SHARD_HEAD` | Exactly `0` or `1`; default off: at `--tp 2` each rank keeps its half of the output head; a greedy unmasked verify exchanges each half's best value and column a row, other passes gather the scores; one GPU and `--pp 2` keep the whole head |
 | `TF_FLASHNEXT_ATTN_LANES` | Exactly `0` or `1`; default off |
 | `TF_FLASHNEXT_WARM_AHEAD` | Exactly `0` or `1`; default off |
diff --git a/zig/src/families/flashnext/cuda_mixed_experts.zig b/zig/src/families/flashnext/cuda_mixed_experts.zig
index bf6efb0f1..38b4fef5b 100644
--- a/zig/src/families/flashnext/cuda_mixed_experts.zig
+++ b/zig/src/families/flashnext/cuda_mixed_experts.zig
@@ -11,13 +11,26 @@ pub const Owned = struct {
     rank: usize,
     world: usize,
     split_shared: bool = false,
+    /// TF_FLASHNEXT_SHARED_REPLICATE: the peer's gate and up cuts, so this rank makes both halves without a gather.
+    peer: ?[2]wt.Q4 = null,
 
     pub fn free(self: *Owned) void {
         self.experts.free();
         for (&self.shared) |*p| p.free();
+        if (self.peer) |*q| for (q) |*p| p.free();
+    }
+
+    /// Rank `owner`'s gate (0) or up (1) cut: this rank's own, or with `peer` the other rank's.
+    pub fn cut(self: *const Owned, i: usize, owner: usize) wt.Q4 {
+        return if (owner == self.rank) self.shared[i] else self.peer.?[i];
     }
 };
 
+/// TF_FLASHNEXT_SHARED_REPLICATE=1: under the shared split each rank also makes the peer's half (no gather).
+pub fn replicateOn() !bool {
+    return @import("sys").environment.read(bool, "TF_FLASHNEXT_SHARED_REPLICATE", false);
+}
+
 pub fn load(a: std.mem.Allocator, d: *cuda.Driver, store: *wt.Store, prefix: []const u8, world: usize, rank: usize, split: bool) !Owned {
     var e = try routed.load(a, d, store, prefix, world, rank);
     errdefer e.free();
@@ -34,5 +47,17 @@ pub fn load(a: std.mem.Allocator, d: *cuda.Driver, store: *wt.Store, prefix: []c
             if (shared[i].native == null) return error.UnsupportedQuantization;
         }
     }
-    return .{ .experts = e, .shared = shared, .rank = rank, .world = world, .split_shared = split };
+    var peer: ?[2]wt.Q4 = null;
+    errdefer if (peer) |*q| for (q) |*p| p.free();
+    if (split and world == 2 and try replicateOn()) {
+        // the same cut the peer loads for itself, so each half's launch matches the peer's
+        var buf: [256]u8 = undefined;
+        peer = @splat(wt.Q4.empty(d));
+        for ([_][]const u8{ "gate_proj", "up_proj" }, 0..) |name, i| {
+            const key = try std.fmt.bufPrint(&buf, "{s}.shared_expert.{s}", .{ prefix, name });
+            peer.?[i] = try projections.loadCut(a, d, store, key, wt.moe_w, wt.dims, try routed.Cut.init(wt.moe_w, world, 1 - rank), .rows);
+            if (peer.?[i].native == null) return error.UnsupportedQuantization;
+        }
+    }
+    return .{ .experts = e, .shared = shared, .rank = rank, .world = world, .split_shared = split, .peer = peer };
 }
diff --git a/zig/src/families/flashnext/cuda_rank_engine.zig b/zig/src/families/flashnext/cuda_rank_engine.zig
index b214ba253..1dd51acce 100644
--- a/zig/src/families/flashnext/cuda_rank_engine.zig
