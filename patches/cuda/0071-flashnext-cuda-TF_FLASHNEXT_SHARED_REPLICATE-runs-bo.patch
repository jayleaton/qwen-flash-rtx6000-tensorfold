     split_rows: u64 = 0,
-    shared_split: u64 = 0,
+    shared_split: u64 = 0, // TF_FLASHNEXT_SPLIT_SHARED in bit 0 and TF_FLASHNEXT_SHARED_REPLICATE in bit 1
     peer_slots: u64 = 0,
     exchange: u64 = 0, // TF_FLASHNEXT_HIDDEN_SUM in bit 0 and TF_FLASHNEXT_OWNER_SLOTS in bit 1, as read at load
     split: u64 = 0, // rank 1's first layer at --pp 2 (0: tensor ranks, every layer on both)
@@ -53,7 +53,7 @@ pub fn identity(a: std.mem.Allocator, io: std.Io, dir: []const u8, context: usiz
     defer a.free(index);
     const program = try std.process.executablePathAlloc(io, a);
     defer a.free(program);
-    return .{ .config = try fileHash(a, io, config), .index = try fileHash(a, io, index), .program = try fileHash(a, io, program), .checkpoint = checkpoint, .context = context, .chunk = chunk, .decode_graph = @intFromBool(@import("cuda_round_graph.zig").enabled()), .head_sharded = @intFromBool(try @import("cuda_head.zig").enabled()), .dense_split = @intFromBool(try @import("cuda_dense_split.zig").appliesDir(a, io, dir, 2)), .split_rows = try @import("cuda_moe_exchange.zig").asked(), .shared_split = @intFromBool(try @import("cuda_dense_split.zig").sharedSplit()), .peer_slots = @intFromBool(try @import("cuda_peer_slots.zig").enabled()), .exchange = @as(u64, @intFromBool(try @import("cuda_moe_hidden_sum.zig").enabled())) | @as(u64, @intFromBool(try @import("cuda_owner_slots.zig").enabled())) << 1 };
+    return .{ .config = try fileHash(a, io, config), .index = try fileHash(a, io, index), .program = try fileHash(a, io, program), .checkpoint = checkpoint, .context = context, .chunk = chunk, .decode_graph = @intFromBool(@import("cuda_round_graph.zig").enabled()), .head_sharded = @intFromBool(try @import("cuda_head.zig").enabled()), .dense_split = @intFromBool(try @import("cuda_dense_split.zig").appliesDir(a, io, dir, 2)), .split_rows = try @import("cuda_moe_exchange.zig").asked(), .shared_split = @as(u64, @intFromBool(try @import("cuda_dense_split.zig").sharedSplit())) | @as(u64, @intFromBool(try @import("cuda_mixed_experts.zig").replicateOn())) << 1, .peer_slots = @intFromBool(try @import("cuda_peer_slots.zig").enabled()), .exchange = @as(u64, @intFromBool(try @import("cuda_moe_hidden_sum.zig").enabled())) | @as(u64, @intFromBool(try @import("cuda_owner_slots.zig").enabled())) << 1 };
 }
 
 /// How long a rank waits for its peer: a minute with a given digest, 30 when the peer may be hashing every byte.
diff --git a/zig/src/families/flashnext/cuda_shared_split.zig b/zig/src/families/flashnext/cuda_shared_split.zig
index bf7a5691a..420d28799 100644
--- a/zig/src/families/flashnext/cuda_shared_split.zig
+++ b/zig/src/families/flashnext/cuda_shared_split.zig
@@ -14,16 +14,29 @@ pub fn runOn(self: anytype, st: anytype, native: *const mixed.Owned, n: usize) !
     const dims = wt.dims;
     const glue = self.tri.own orelse return error.NativeGlueRequired;
     const width = if (native.split_shared) wt.moe_w / 2 else wt.moe_w;
-    try self.k.native_lane.matmul(st, s.mixed, dims, n, native.shared[0].native.?, s.shared_gate, s.native_part);
-    try self.k.native_lane.matmul(st, s.mixed, dims, n, native.shared[1].native.?, s.shared_up, s.native_part);
-    try glue.sharedSwiGLU(st, s.shared_gate, s.shared_up, s.shared_act, n, width);
     var input = s.shared_act;
+    if (native.split_shared and native.peer != null) {
+        // each rank's half as that rank launches it, laid out [2, n, width] in rank order as the gather lands them
+        for (0..2) |owner| for (0..2) |i| {
+            const out = (if (i == 0) s.shared_gate else s.shared_up) + owner * n * width * 2;
+            try self.k.native_lane.matmul(st, s.mixed, dims, n, native.cut(i, owner).native.?, out, s.native_part);
+        };
+        try glue.sharedSwiGLU(st, s.shared_gate, s.shared_up, s.shared_act, 2 * n, width);
+    } else {
+        try self.k.native_lane.matmul(st, s.mixed, dims, n, native.shared[0].native.?, s.shared_gate, s.native_part);
+        try self.k.native_lane.matmul(st, s.mixed, dims, n, native.shared[1].native.?, s.shared_up, s.native_part);
+        try glue.sharedSwiGLU(st, s.shared_gate, s.shared_up, s.shared_act, n, width);
+    }
     if (native.split_shared) {
-        const c = self.m.collective orelse return error.TensorParallelUnavailable;
-        try c.gather(st, input, s.rank_gather, n * width);
+        var gathered = s.shared_act;
+        if (native.peer == null) {
+            const c = self.m.collective orelse return error.TensorParallelUnavailable;
+            try c.gather(st, input, s.rank_gather, n * width);
+            gathered = s.rank_gather;
+        }
         // one row: the ranks' gathered blocks [2, 1, width] are already the row [1, moe_w] the down projection reads
-        if (n > 1) for (0..2) |rank| try ops.copyCols(self.k, st, s.rank_gather + rank * n * width * 2, width, s.rank_input + rank * width * 2, wt.moe_w, width, n);
-        input = if (n == 1) s.rank_gather else s.rank_input;
+        if (n > 1) for (0..2) |rank| try ops.copyCols(self.k, st, gathered + rank * n * width * 2, width, s.rank_input + rank * width * 2, wt.moe_w, width, n);
+        input = if (n == 1) gathered else s.rank_input;
     }
     // the whole expert's down goes straight into its slot (cuda_batch_side.down), as on the side stream
     if (!native.split_shared) return @import("cuda_batch_side.zig").down(self, st, input, native, n);
diff --git a/zig/src/families/flashnext/cuda_split_lane_test.zig b/zig/src/families/flashnext/cuda_split_lane_test.zig
index 2ffbb3b6c..276220970 100644
--- a/zig/src/families/flashnext/cuda_split_lane_test.zig
+++ b/zig/src/families/flashnext/cuda_split_lane_test.zig
@@ -281,6 +281,7 @@ test "shared expert composition keeps whole direct slots and split full-K output
         var native: @import("cuda_mixed_experts.zig").Owned = undefined;
         native.rank = rank;
         native.split_shared = split;
+        native.peer = null;
         const width: usize = if (split) wt.moe_w / 2 else wt.moe_w;
         const columns: usize = if (split) dims / 2 else dims;
         for (0..3) |i| native.shared[i].native = cuda.modelopt.bf16Weight(0x2000, if (i == 2) columns else width, if (i == 2) wt.moe_w else dims);
@@ -328,11 +329,39 @@ test "shared expert composition keeps whole direct slots and split full-K output
             } else try std.testing.expectEqual(@as(usize, 0x600), last.f);
         }
     };
+    // replicated: both ranks' halves here in rank order where the gather would land them, then the same copies and down
+    for ([_]usize{ 1, 64 }) |n| for (0..2) |rank| {
+        const width = wt.moe_w / 2;
+        var native: @import("cuda_mixed_experts.zig").Owned = undefined;
+        native.rank = rank;
+        native.split_shared = true;
+        for (0..3) |i| native.shared[i].native = cuda.modelopt.bf16Weight(0x2000, if (i == 2) dims / 2 else width, if (i == 2) wt.moe_w else dims);
+        native.peer = .{ native.shared[0], native.shared[1] };
+        var self: Self = .{ .k = &r.k, .s = &r.s, .m = r.pass(n, true).m, .stream = .{ .d = &r.d, .handle = null }, .tri = .{ .own = &glue } };
+        Rec.n = 0;
+        try @import("cuda_shared_split.zig").run(&self, &native, n);
+        var outs: [5]i64 = undefined;
+        var mm: usize = 0;
+        for (recorded()) |call| {
+            try std.testing.expect(call.kind != .gather and call.kind != .sum);
+            if (call.f == qmmf_id) {
+                outs[mm] = call.a[if (mm < 4) 1 else 0];
+                mm += 1;
+            }
+        }
+        try std.testing.expectEqual(@as(usize, 5), mm);
+        const half: i64 = @intCast(n * width * 2);
+        const g: i64 = @intCast(r.s.shared_gate);
+        const u: i64 = @intCast(r.s.shared_up);
+        try std.testing.expectEqualSlices(i64, &.{ g, u, g + half, u + half, @intCast(if (n == 1) r.s.shared_act else r.s.rank_input) }, &outs);
+        if (n > 1) try std.testing.expectEqual(@as(i64, @intCast(r.s.shared_act)) + half, recorded()[Rec.n - 3].a[0]);
+    };
     // a down weight the strided launch cannot address keeps the contiguous product and the scatter, without an error
     r.c.rank = 0;
     var native: @import("cuda_mixed_experts.zig").Owned = undefined;
     native.rank = 0;
     native.split_shared = false;
+    native.peer = null;
     for (0..3) |i| native.shared[i].native = cuda.modelopt.bf16Weight(0x2000, if (i == 2) dims else wt.moe_w, if (i == 2) wt.moe_w else dims);
     native.shared[2].native.?.npad += 1;
     var self: Self = .{ .k = &r.k, .s = &r.s, .m = r.pass(64, true).m, .stream = .{ .d = &r.d, .handle = null }, .tri = .{ .own = &glue } };
