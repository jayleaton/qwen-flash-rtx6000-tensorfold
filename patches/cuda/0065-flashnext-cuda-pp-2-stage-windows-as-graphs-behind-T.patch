From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jay Leaton <58495321+jayleaton@users.noreply.github.com>
Date: Mon, 23 Nov 2026 22:58:26 +0700
Subject: [PATCH 65/76] flashnext cuda: --pp 2 stage windows as graphs behind
 TF_FLASHNEXT_PP_WINDOW_GRAPH

---
 docs/environment.md                                | 1 +
 zig/src/families/flashnext/cuda_prompt_windows.zig | 4 ++--
 zig/src/families/flashnext/cuda_window_graph.zig   | 6 ++++++
 zig/src/platform/environment.zig                   | 1 +
 zig/src/platform/environment_flashnext_test.zig    | 4 ++--
 5 files changed, 12 insertions(+), 4 deletions(-)

diff --git a/docs/environment.md b/docs/environment.md
index ffa79df96..f247955b5 100644
--- a/docs/environment.md
+++ b/docs/environment.md
@@ -166,6 +166,7 @@ stops the start with the variable, the supplied text and the accepted forms.
 | `TF_FLASHNEXT_GREEDY_WIDE` | Whole round width; default 4 |
 | `TF_FLASHNEXT_WINDOW_ROWS` | Whole row count; default the shared round's rows, capped by them |
 | `TF_FLASHNEXT_SPLIT_ROWS` | Whole row count; `0` or unset takes the link's default (64, the shared round's rows). At `--tp 2`, a pass of more rows than this reduce-scatters its experts' rows and gathers the sums instead of one all-reduce. Give every rank the same value. |
+| `TF_FLASHNEXT_PP_WINDOW_GRAPH` | Exactly `0` or `1`; default off. `1`: at `--pp 2` each stage's verify windows run as CUDA graphs with their hop captured, whatever `TF_FLASHNEXT_WINDOW_GRAPH` says; the draft head's graphs still follow `TF_FLASHNEXT_WINDOW_GRAPH`. Same kernels and bits as the eager pass. Give every rank the same value. |
 | `TF_FLASHNEXT_TP_WINDOW_GRAPH` | Exactly `0` or `1`; default off. `1`: at `--tp 2` the drafted verify windows run as CUDA graphs on both ranks with their collectives captured, whatever `TF_FLASHNEXT_WINDOW_GRAPH` says; `TF_FLASHNEXT_PEER_SLOTS`' epoch moves to the device so a replay advances it. Same kernels and bits as the eager pass. Give every rank the same value. |
 | `TF_FLASHNEXT_PEER_SLOTS` | Exactly `0` or `1`; default off. At `--tp 2` on one host, a pass of up to 128 rows exchanges its MoE slots by writing each rank's own experts' rows (and its half of the shared expert's) into the peer's mapped buffer, about half the bytes of the all-reduce or reduce-scatter, with the same sums. Refused across hosts and with `TF_FLASHNEXT_DECODE_GRAPH`. Give every rank the same value. |
 | `TF_FLASHNEXT_READOUT_ROWS` | Whole row count; default 64; `0` never takes the tiles |
diff --git a/zig/src/families/flashnext/cuda_prompt_windows.zig b/zig/src/families/flashnext/cuda_prompt_windows.zig
index 6ce19a71b..a00ed57b8 100644
--- a/zig/src/families/flashnext/cuda_prompt_windows.zig
+++ b/zig/src/families/flashnext/cuda_prompt_windows.zig
@@ -10,9 +10,9 @@ const hops = @import("cuda_batch_hop.zig");
 const Engine = prompt.Engine;
 const Seq = prompt.Seq;
 
-/// Whether a window may run as a graph: one GPU or a stage under TF_FLASHNEXT_WINDOW_GRAPH, --tp 2 under ranks().
+/// Whether a window may run as a graph: under TF_FLASHNEXT_WINDOW_GRAPH, a stage also under stages(), --tp 2 ranks().
 fn graphed(e: *Engine) bool {
-    const c = e.collective orelse return window_graph.enabled();
+    const c = e.collective orelse return window_graph.enabled() or (e.hop != null and window_graph.stages());
     if (!window_graph.ranks()) return false;
     c.release = .{ .ctx = e, .run = release };
     return true;
diff --git a/zig/src/families/flashnext/cuda_window_graph.zig b/zig/src/families/flashnext/cuda_window_graph.zig
index 623d57b68..12faa5467 100644
--- a/zig/src/families/flashnext/cuda_window_graph.zig
+++ b/zig/src/families/flashnext/cuda_window_graph.zig
@@ -28,6 +28,12 @@ pub fn ranks() bool {
     return @import("sys").environment.read(bool, "TF_FLASHNEXT_TP_WINDOW_GRAPH", false) catch false;
 }
 
+/// TF_FLASHNEXT_PP_WINDOW_GRAPH: --pp 2 stage windows as graphs, the draft head's left to TF_FLASHNEXT_WINDOW_GRAPH.
+pub fn stages() bool {
+    // the startup check refused every malformed value already, so a plain default stands here
+    return @import("sys").environment.read(bool, "TF_FLASHNEXT_PP_WINDOW_GRAPH", false) catch false;
+}
+
 /// attnRows' host values for rows ending at `ends` in a `cap`-token cache: dense chunks, the score grid (0: none).
 pub const Geometry = struct {
     chunks: u32,
diff --git a/zig/src/platform/environment.zig b/zig/src/platform/environment.zig
index f62c6a06f..ffffe20c5 100644
--- a/zig/src/platform/environment.zig
+++ b/zig/src/platform/environment.zig
@@ -234,6 +234,7 @@ pub const rules = [_]Rule{
     .{ .name = "TF_FLASHNEXT_DRAFTS_GREEDY", .scope = .flashnext, .kind = .size, .forms = "a whole draft count from 0 to the native size maximum (default 8; clamped to 1 through 15)" },
     .{ .name = "TF_FLASHNEXT_GREEDY_WIDE", .scope = .flashnext, .kind = .size, .forms = "a whole round width from 0 to the native size maximum (default 4)" },
     .{ .name = "TF_FLASHNEXT_WINDOW_ROWS", .scope = .flashnext, .kind = .size, .forms = "a whole row count from 0 to the native size maximum (default the shared round's rows; capped by them)" },
+    .{ .name = "TF_FLASHNEXT_PP_WINDOW_GRAPH", .scope = .flashnext, .kind = .flag, .forms = "0 or 1 (default 0; 1: at --pp 2 the stage windows run as graphs); give every rank the same" },
     .{ .name = "TF_FLASHNEXT_TP_WINDOW_GRAPH", .scope = .flashnext, .kind = .flag, .forms = "0 or 1 (default 0; 1: at --tp 2 the verify windows run as graphs on both ranks); give every rank the same" },
     .{ .name = "TF_FLASHNEXT_PEER_SLOTS", .scope = .flashnext, .kind = .flag, .forms = "0 or 1 (default 0; 1: at --tp 2 on one host the MoE exchange writes each rank's slots into the peer's mapped buffer); give every rank the same" },
     .{ .name = "TF_FLASHNEXT_SPLIT_ROWS", .scope = .flashnext, .kind = .size, .forms = "a whole row count from 0 to the native size maximum (0 or unset: one host's default; more rows a pass than this split the --tp 2 expert exchange by rows); give every rank the same" },
diff --git a/zig/src/platform/environment_flashnext_test.zig b/zig/src/platform/environment_flashnext_test.zig
index 6889304ca..1c11e073b 100644
--- a/zig/src/platform/environment_flashnext_test.zig
