     .{ .launch = .{ .name = "flashnext_batch fn_gdn_lanes_keep", .symbol = "fn_gdn_lanes_keep", .image = "flashnext_batch", .threads = 256 }, .usage = .{ .{ .regs = 30, .static = 0, .bound = 0 }, .{ .regs = 32, .static = 0, .bound = 0 }, .{ .regs = 32, .static = 0, .bound = 0 }, .{ .regs = 32, .static = 0, .bound = 0 }, .{ .regs = 38, .static = 0, .bound = 0 } } },
     .{ .launch = .{ .name = "flashnext_batch fn_gdn_lanes_front", .symbol = "fn_gdn_lanes_front", .image = "flashnext_batch", .threads = 256 }, .usage = .{ .{ .regs = 29, .static = 2048, .bound = 256 }, .{ .regs = 29, .static = 2048, .bound = 256 }, .{ .regs = 29, .static = 2048, .bound = 256 }, .{ .regs = 34, .static = 2048, .bound = 256 }, .{ .regs = 34, .static = 2048, .bound = 256 } } },
